# Cloudflare Pages cache rules. Its default is four hours for every file, so a
# redrawn image at a fixed URL kept showing the old one until the cache aged
# out. Files under /_astro/ carry a content hash in their name (Astro emits the
# CSS and every image imported from src/assets/ there), so a changed file is a
# new URL and the old one can be cached for a year. Pagefind's loader files keep
# fixed names, so browsers must ask the server whether they changed; the index
# chunks it fetches carry a hash, so those get the year too. Cloudflare joins
# the values of every matching rule into one header, so the narrower Pagefind
# rules first detach ("! ") the broader one's value.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate

/pagefind/index/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/pagefind/fragment/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/pagefind/filter/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
