---
import Base from '../layouts/Base.astro';
import Finding from '../components/Finding.astro';
import PageToc from '../components/PageToc.astro';
import RegisterCounts from '../components/RegisterCounts.astro';
import ReportBox from '../components/ReportBox.astro';
import StateBadge from '../components/StateBadge.astro';
import { orderedTopics } from '../lib/content';
import { claimText, commentsFrom, commentsOn, saidIn, triageEdge } from '../lib/intake';
import { questionRows, questionStateKey, statesOf } from '../lib/questions';
import { toc } from '../lib/toc';

/**
 * `/questions` — the register and the index in one page.
 *
 * It is the standing answer to "why didn't you check X", so it lists every
 * question whatever became of it: going ahead, parked, declined, published,
 * withdrawn. Nothing sits behind a filter a reader would have to think to open.
 * The filters narrow a list that is already complete in the HTML, which is also
 * what keeps the page whole with scripting off.
 *
 * The order is how many comments carried each question, so the arguments
 * Edmonton is actually having are at the top and the hyper-specific ones sink.
 *
 * The ledger idiom carries the register's two levels: a question is a row with
 * a 5px left edge in its triage colour, and the claims checked under it are the
 * rows beneath it. A claim under a published question prints the finding it
 * came back with; a claim under it that has never been checked prints that it
 * has not, because a published answer to a question is not an answer to
 * everything anybody has since said about it.
 */
const rows = await questionRows();
const topics = await orderedTopics();

/** Only the states and topics the register actually uses are offered. */
const stateFilters = questionStateKey();

const topicFilters = topics
  .map((topic) => ({
    id: topic.data.slug,
    label: topic.data.name,
    count: rows.filter((row) => row.topics.includes(topic.data.slug)).length,
  }))
  .filter((topic) => topic.count > 0);

const withholding = rows.some((row) => row.registered.some((claim) => claim.withheld));

/** Whether any published question is still carrying unchecked claims. */
const unchecked = rows.some(
  (row) => row.answered.length > 0 && row.registered.length > 0,
);

const outline = toc([
  { id: 'filters', label: 'Filters' },
  { id: 'register', label: 'Every question' },
  { id: 'states', label: 'What the states mean' },
]);

const label = 'text-xs tracking-[0.08em] text-muted uppercase tabular';

/**
 * The count and badge columns. From `md` up each shrinks to its own content so
 * the question keeps every pixel the counts do not need; below that the row
 * stacks, because four columns on a phone left the question wrapping in a
 * ribbon a third of the screen wide with the rest of the row empty beside it.
 *
 * The two counts share one cell. As separate columns each was as wide as its
 * longest value across all 44 questions and neither could give the width back,
 * so between them they took 250px off the question title on every row —
 * including the rows that had no counts at all. In one cell they cost the
 * widest single phrase instead of the sum of two columns: from `md` the two
 * phrases stack on their own lines against the right edge, so the column is
 * only ever as wide as the longer of them and no phrase is broken. The middot
 * between them belongs to the stacked phone row, where they run inline, and is
 * dropped from `md` up rather than left hanging at the end of a line.
 */
const countColumn = `md:table-cell md:w-[1%] md:pl-4 md:text-right md:align-top ${label}`;
const badgeColumn = 'block md:table-cell md:w-px md:pl-4 md:text-right md:align-top';

/** The row's counts as phrases — "Said in 35 comments", "9 claims" — dropping either when it is empty. */
function counts(comments: number, claims?: number): string[] {
  return [
    comments > 0 ? saidIn(comments) : '',
    claims === undefined ? '' : `${claims} ${claims === 1 ? 'claim' : 'claims'}`,
  ].filter(Boolean);
}

/* The chip's own look lives in `.chip` (global.css); the register only says where they go. */
---

<Base
  sections={outline}
  rail={false}
  title="Every question we've considered"
  description="Every question that reached YEGFacts, with the claims under it and what happened to it, including the ones we parked and the ones we declined."
>
  {/*
    Two columns from `lg`: the title, the filters and the register on the left,
    the key and the outline on the right, starting level with the title so the
    key is in view before the first row is. The key is reference material a
    reader consults while reading the rows. It comes after the register in
    source order, which is where a phone wants it: below the list, not in front
    of it.

    The page carries its own right-hand column rather than borrowing the
    layout's 13rem rail, the way the home page does, and the rail is off. The
    rail is too narrow to hold the key, and a second column beside it left the
    register 460px wide. The column is a fixed 16rem rather than the home
    page's ratio because the register's other columns never shrink: they cost
    the table a flat few hundred pixels whatever the page is doing, so every
    pixel this column takes comes out of the question title, which is the one
    thing on the row a reader is actually reading.
  */}
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-x-8">
  <div>
  <header class="border-b border-rule pb-6">
    <h1 class="text-[1.75rem] leading-[1.15] font-bold tracking-[-0.022em] sm:text-display">
      Every question we've considered
    </h1>
    <p class="mt-4 max-w-prose text-base leading-relaxed">
      Every question that has reached the site is here, whatever became of it: going ahead, parked,
      declined, published or withdrawn. Each shows the claims under it and the reason for the
      decision. The filters only narrow this list.
    </p>
  </header>

  {/*
    The filters. They are links carrying the query the page reads back, so the
    view a reader is looking at is the view they can send somebody. The script
    below intercepts the click and filters in place; with scripting off the link
    still lands on this page with every question on it, which is the page's
    standing promise either way.
  */}
  <section id="filters" class="mt-10 scroll-mt-6" data-filters>
    <h2 class="sr-only">Filter these questions</h2>

    <div class="divide-y divide-rule border-y border-rule">
      <div class="py-3.5 sm:flex sm:gap-5">
        <p class:list={[label, 'sm:w-28 sm:shrink-0 sm:pt-1.5']}>State</p>
        <ul class="mt-2 flex flex-wrap gap-2 sm:mt-0">
          <li>
            <a href="/questions" class="chip" data-filter="state" data-value="">All</a>
          </li>
          {
            stateFilters.map((state) => (
              <li>
                <a
                  href={`/questions?state=${state.id}`}
                  class="chip"
                  data-filter="state"
                  data-value={state.id}
                >
                  {state.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        topicFilters.length > 0 && (
          <div class="py-3.5 sm:flex sm:gap-5">
            <p class:list={[label, 'sm:w-28 sm:shrink-0 sm:pt-1.5']}>Topic</p>
            <ul class="mt-2 flex flex-wrap gap-2 sm:mt-0">
              <li>
                <a href="/questions" class="chip" data-filter="topic" data-value="">
                  All
                </a>
              </li>
              {topicFilters.map((topic) => (
                <li>
                  <a
                    href={`/questions?topic=${topic.id}`}
                    class="chip"
                    data-filter="topic"
                    data-value={topic.id}
                  >
                    {topic.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    {/*
      One line, because the count and the order are one fact about the list
      below it: how much of the register is on screen, and what put it in that
      order. The script rewrites the whole line as the filters change.
    */}
    <p class:list={['mt-3', label]} data-filter-count>
      {rows.length} questions, most-commented first.
    </p>
    <noscript>
      <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
        Filtering needs scripting. Every question is listed below either way.
      </p>
    </noscript>
  </section>
    <section id="register" class="mt-12 scroll-mt-6">
      <h2 class="section-heading">Every question</h2>

      {/*
        One tbody to a question, with the claims checked under it as rows beneath
        it, so a claim is attached to its question by the table's own structure.
        The column heads say what each cell already says in words, so they are for
        screen readers only.
      */}
      <table class="mt-4 block w-full border-collapse md:table">
        <caption class="sr-only">Every question YEGFacts has considered</caption>
        <thead class="sr-only">
          <tr>
            <th scope="col">Question or claim</th>
            <th scope="col">Comments and claims</th>
            <th scope="col">State</th>
          </tr>
        </thead>
        {
          rows.map((row) => (
            <tbody
              class="block border-t border-rule md:table-row-group"
              data-question
              data-state={statesOf(row.question).join(' ')}
              data-topic={row.topics.join(' ')}
            >
              <tr id={row.question.id} class="block scroll-mt-6 md:table-row">
                <td class="block pt-4 md:table-cell md:w-[52%] md:py-4 md:pr-4 md:align-top">
                  <span class:list={['block border-l-[5px] pl-4', triageEdge(row.question.triage)]}>
                    <a
                      href={`/questions/${row.question.id}`}
                      class="link-title font-display text-[1.1875rem] leading-snug font-semibold text-pretty"
                      data-record
                    >
                      {row.question.question}
                    </a>
                    {row.question.reason && (
                      <span
                        class="mt-2 block max-w-prose text-[0.9375rem] leading-relaxed text-muted"
                        data-record
                      >
                        {row.question.reason}
                      </span>
                    )}
                  </span>
                </td>
                <td class:list={['block pt-2 pl-5 md:py-4', countColumn]} data-record>
                  <RegisterCounts phrases={counts(row.comments, row.claimCount)} />
                </td>
                <td class:list={['pt-3 pb-4 pl-5 md:py-4', badgeColumn]}>
                  <span class="flex flex-wrap gap-1.5 md:justify-end">
                    {statesOf(row.question).map((state) => (
                      <StateBadge state={state} />
                    ))}
                  </span>
                </td>
              </tr>

              {row.answered.map((claim) => (
                <tr class="block scroll-mt-6 border-t border-rule md:table-row">
                  <td class="block pt-2.5 pl-4 md:table-cell md:py-2.5 md:pr-4 md:align-top">
                    <a
                      href={`/claims/${claim.data.id}`}
                      class="link-title text-[0.9375rem] leading-snug"
                      data-record
                    >
                      {claim.data.question}
                    </a>
                  </td>
                  <td
                    class:list={[
                      commentsFrom(claim.data.register_claims) === 0
                        ? 'hidden'
                        : 'block pt-1 pl-4',
                      'md:py-2.5',
                      countColumn,
                    ]}
                    data-record
                  >
                    <RegisterCounts phrases={counts(commentsFrom(claim.data.register_claims))} />
                  </td>
                  <td class:list={['pt-2 pb-2.5 pl-4 md:py-2.5', badgeColumn]}>
                    <Finding finding={claim.data.finding} />
                  </td>
                </tr>
              ))}

              {row.registered.map((claim) => (
                <tr id={claim.id} class="block scroll-mt-6 border-t border-rule md:table-row">
                  <td class="block pt-2.5 pl-4 md:table-cell md:py-2.5 md:pr-4 md:align-top">
                    <a
                      href={`/claims/${claim.id}`}
                      class="link-title text-[0.9375rem] leading-snug"
                      data-record
                    >
                      {claimText(claim)}
                    </a>
                  </td>
                  {/* A withheld claim has no count either, and no empty line where one would have been. */}
                  <td
                    class:list={[
                      commentsOn(claim) === 0 ? 'hidden' : 'block pt-1 pb-2.5 pl-4',
                      'md:py-2.5',
                      countColumn,
                    ]}
                    data-record
                  >
                    <RegisterCounts phrases={counts(commentsOn(claim))} />
                  </td>
                  {/*
                    Under a published question, a claim with no finding says so
                    rather than sitting blank beside the ones that were checked.
                    Everywhere else the question's own state above says it.
                  */}
                  <td class:list={['md:py-2.5', badgeColumn]}>
                    {row.answered.length > 0 && (
                      <span class:list={['block pb-2.5 pl-4 md:pl-0', label]}>No finding yet</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </section>
  </div>

    <div>
      {/*
        The key. In the sidebar the term sits above its definition rather than
        beside it, because a 10rem label column inside a 16rem column leaves the
        definition a ribbon; below `lg` it keeps the two-column reading it has
        always had.
      */}
      <section id="states" class="mt-12 scroll-mt-6 lg:mt-0">
        <h2 class="section-heading">What the states mean</h2>

        {/* The tile is the term, so a reader can match a row to its line by shape. */}
        <dl class="mt-5 divide-y divide-rule border-t border-rule">
          {
            stateFilters.map((state) => (
              <div class="py-3 sm:flex sm:gap-5 lg:block">
                <dt class="sm:w-40 sm:shrink-0 lg:w-auto">
                  <StateBadge state={state.id} />
                </dt>
                <dd class="mt-1.5 max-w-prose text-[0.9375rem] leading-relaxed sm:mt-0 lg:mt-1.5">
                  {state.definition}
                </dd>
              </div>
            ))
          }
          {
            unchecked && (
              <div class="py-3 sm:flex sm:gap-5 lg:block">
                <dt class:list={['sm:w-40 sm:shrink-0 lg:w-auto', label]}>No finding yet</dt>
                <dd class="mt-1.5 max-w-prose text-[0.9375rem] leading-relaxed sm:mt-0 lg:mt-1.5">
                  A claim under a question the site has already answered, which has not itself been
                  through the panel. The question was answered; this claim was not checked.
                </dd>
              </div>
            )
          }
        </dl>

        <p class="mt-6 max-w-prose text-[0.9375rem] leading-relaxed">
          Two readers decide each question separately, and the reasons use their words: GO, PARK
          or NO. A question goes ahead when both say GO, or one says GO and the other PARK. It is
          declined when both say NO. Anything else parks, because throwing out a real question costs
          a reader more than holding one too long. Where the two split, the reason says so.
        </p>
        <p class="mt-4 max-w-prose text-[0.9375rem] leading-relaxed">
          The counts are comments, not people. One person can write several, and a comment counted
          under a claim may have been arguing against it. That is why a count says said, not agreed.
        </p>

        {
          withholding && (
            <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
              Some rows read “Withheld claim”. Those are claims about an identifiable person,
              which this site does not repeat while it has no right of reply to offer them. The row
              keeps its place under the question it was checked under, that question keeps its
              answer and its reason, and the claim's own page says more.
            </p>
          )
        }
      </section>

      {/*
        The layout's rail, carried here instead. Below `lg` the layout's own
        disclosure bar already holds both, so this copy only exists from `lg`
        up, and it is ignored by the search index the way the rail was.
      */}
      <div
        class="hidden lg:sticky lg:top-8 lg:mt-10 lg:block lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto"
        data-pagefind-ignore
      >
        <nav aria-label="On this page">
          <p class="text-[0.6875rem] font-semibold tracking-[0.11em] text-muted uppercase">
            On this page
          </p>
          <div class="mt-3">
            <PageToc sections={outline} />
          </div>
        </nav>
        <div class="mt-7">
          <ReportBox path="/questions" title="Every question we've considered" />
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  /*
   * Client-side filtering over the whole register, which is already in the HTML.
   *
   * The filters are links, so the URL is the state: a reader who has narrowed
   * the page to the parked questions can send that page to somebody, and the
   * page reads the query back on load. `replaceState` rather than a navigation,
   * because the list never leaves the document and a history entry per chip
   * would bury the page a reader arrived from.
   */
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-question]')];
  const count = document.querySelector<HTMLElement>('[data-filter-count]');

  if (bar && rows.length > 0) {
    const FILTERS = ['state', 'topic'] as const;
    type Filter = (typeof FILTERS)[number];

    const active: Record<Filter, string> = { state: '', topic: '' };

    const matches = (row: HTMLElement, filter: Filter): boolean => {
      const wanted = active[filter];
      if (wanted === '') return true;
      const values = (row.dataset[filter] ?? '').split(' ').filter(Boolean);
      return values.includes(wanted);
    };

    const apply = () => {
      let shown = 0;
      for (const row of rows) {
        const visible = FILTERS.every((filter) => matches(row, filter));
        row.hidden = !visible;
        if (visible) shown += 1;
      }

      for (const chip of bar.querySelectorAll<HTMLAnchorElement>('[data-filter]')) {
        const filter = chip.dataset.filter as Filter;
        const on = (chip.dataset.value ?? '') === active[filter];
        chip.classList.toggle('is-filter-on', on);
        if (on) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      }

      if (count) {
        const filtered = FILTERS.some((filter) => active[filter] !== '');
        count.textContent = filtered
          ? `Showing ${shown} of ${rows.length} questions, most-commented first.`
          : `${rows.length} questions, most-commented first.`;
      }
    };

    const read = () => {
      const params = new URLSearchParams(window.location.search);
      for (const filter of FILTERS) active[filter] = params.get(filter) ?? '';
      apply();
    };

    bar.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const chip = target.closest<HTMLAnchorElement>('[data-filter]');
      if (!chip) return;
      event.preventDefault();

      const filter = chip.dataset.filter as Filter;
      const value = chip.dataset.value ?? '';
      // Tapping the chip you are already on clears it, so there is always a way
      // back to everything without hunting for the All chip.
      active[filter] = active[filter] === value ? '' : value;

      const params = new URLSearchParams();
      for (const key of FILTERS) if (active[key] !== '') params.set(key, active[key]);
      const query = params.toString();
      window.history.replaceState(null, '', query === '' ? '/questions' : `/questions?${query}`);
      apply();
    });

    window.addEventListener('popstate', read);
    read();
  }
</script>
