---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AiReview from '../../components/AiReview.astro';
import AlsoSaidAs from '../../components/AlsoSaidAs.astro';
import CopyButton from '../../components/CopyButton.astro';
import Finding from '../../components/Finding.astro';
import Gloss from '../../components/Gloss.astro';
import PendingBanner from '../../components/PendingBanner.astro';
import QuestionEntry from '../../components/QuestionEntry.astro';
import SeenCards from '../../components/SeenCards.astro';
import TopicTags from '../../components/TopicTags.astro';
import {
  claimTopics,
  commitmentsForStory,
  evidenceForStory,
  firstPublished,
  type Commitment,
  type Evidence,
} from '../../lib/content';
import {
  LIFECYCLE_LABELS,
  PUBLICATION_LABELS,
  claimText,
  commentsOn,
  reportAnchor,
  reportsFor,
  saidIn,
  sourceKind,
  triageHeading,
  type Question,
} from '../../lib/intake';
import { questionRows, type QuestionRow } from '../../lib/questions';
import { requireTerm as gloss } from '../../lib/glossary';
import { SITE } from '../../lib/site';
import { subheads, toc } from '../../lib/toc';

type Report = CollectionEntry<'candidateReports'>;

/**
 * `/questions/<id>` — one question, at whatever stage it has reached.
 *
 * The question is the unit of work (D-0029), so this is the address the work
 * has from the day it is registered, and it is the same address once the
 * article lands. A question nobody has written up yet is its decision, its
 * reason and the claims under it in the words people used. A question that has
 * been checked is all of that plus the article: the findings, the evidence, the
 * panel and the history.
 *
 * `/considered/<id>` used to be this address, which baked the first state of a
 * lifecycle into a permanent identifier — every one of those URLs lied the
 * moment its question was briefed.
 */
export async function getStaticPaths() {
  /**
   * The intake record and triage report behind a question, where they exist.
   * Declared in here rather than beside the props: Astro hoists
   * `getStaticPaths` into a scope of its own, so a helper outside it is not
   * defined by the time it runs.
   */
  const loadReports = async (question: Question) => {
    const loaded = await Promise.all(
      reportsFor(question).map(async ({ label, path }) => ({
        label,
        path,
        entry: await getEntry('candidateReports', path),
      })),
    );
    return loaded.filter(
      (report): report is { label: string; path: string; entry: Report } =>
        report.entry !== undefined,
    );
  };

  const rows = await questionRows();
  return Promise.all(
    rows.map(async (row) => ({
      params: { id: row.question.id },
      props: {
        row,
        reports: await loadReports(row.question),
        commitments: row.story ? await commitmentsForStory(row.story) : [],
      },
    })),
  );
}

interface Props {
  row: QuestionRow;
  reports: Array<{ label: string; path: string; entry: Report }>;
  commitments: Commitment[];
}

const { row, reports, commitments } = Astro.props;
const { question, source, story, answered, registered } = row;

const pageUrl = new URL(`/questions/${question.id}`, Astro.site ?? SITE.url).href;

// ---------------------------------------------------------------------------
// A question with no article: the register entry, published.
// ---------------------------------------------------------------------------
const entrySections = toc([
  { id: 'state', label: 'State' },
  source && { id: 'source', label: 'Where it came from' },
  registered.length > 0 && {
    id: 'claims',
    label: registered.length === 1 ? 'The claim' : 'The claims',
  },
  ...reports.map((report) => ({ id: reportAnchor(report.label), label: report.label })),
]);

// ---------------------------------------------------------------------------
// A question that has been checked: the article, and the register behind it.
// ---------------------------------------------------------------------------
const rendered = story ? await render(story) : undefined;
const evidence: Evidence[] = story ? await evidenceForStory(answered, commitments) : [];

/**
 * Comparable cities, grouped under the claim they were offered for. They used to
 * be one flat list with each card naming its claim, which on a single-claim
 * question printed the same twenty-word question five times running.
 */
const comparisonGroups = answered
  .filter((claim) => claim.data.comparisons.length > 0)
  .map((claim) => ({ claim, comparisons: claim.data.comparisons }));

const comparisons = comparisonGroups.flatMap((group) => group.comparisons);
const unknowns = answered.flatMap((claim) => claim.data.unknowns);
const missing = answered.flatMap((claim) => claim.data.missing_evidence);

/**
 * The methodology version(s) the findings on this page were produced under.
 * Kept per-claim rather than per-question because a question revised across a
 * version bump legitimately carries claims from two versions.
 */
const methodologyVersions = [
  ...new Set(answered.map((claim) => claim.data.methodology_version)),
];

const withdrawn = story?.data.withdrawn;
const published = story ? firstPublished(story) : undefined;

const articleSections = story
  ? toc([
      story.data.tldr.length > 0 && { id: 'tldr', label: 'TL;DR' },
      story.data.seen.length > 0 && { id: 'claims-we-are-seeing', label: 'Common forms' },
      {
        id: 'what-happened',
        label: 'What actually happened',
        children: subheads(rendered?.headings ?? []),
      },
      { id: 'claims-checked', label: 'Claims checked' },
      registered.length > 0 && { id: 'not-checked', label: 'Claims with no finding' },
      commitments.length > 0 && { id: 'commitments', label: 'What the City promised' },
      { id: 'evidence', label: 'Edmonton evidence' },
      comparisons.length > 0 && { id: 'comparisons', label: 'Comparable cities' },
      unknowns.length > 0 && { id: 'unknown', label: 'What remains unknown' },
      missing.length > 0 && { id: 'missing-evidence', label: 'Missing evidence' },
      { id: 'ai-review', label: 'AI review' },
      { id: 'registered', label: 'How it was registered' },
      { id: 'history', label: 'Article history' },
    ])
  : [];

const heading = 'section-heading mt-14';
const label = 'text-xs tracking-[0.08em] text-muted uppercase tabular';
const mainClaim = 'ml-2 align-middle text-[0.6875rem] tracking-[0.08em] text-forest uppercase';

/** The three state fields, each under the question it answers. */
const states = [
  {
    term: 'How far the work has got',
    value: LIFECYCLE_LABELS[question.lifecycle] ?? question.lifecycle,
  },
  { term: 'Whether it is worth checking', value: triageHeading(question.triage) },
  {
    term: 'What a reader can see',
    value: PUBLICATION_LABELS[question.publication] ?? question.publication,
  },
];

const Content = rendered?.Content;
---

{/*
  A withdrawn question keeps its page and loses its standing, so it also loses
  its place in the search index: `indexable` is what puts `data-pagefind-body`
  on `<main>`, and a page without it is the repo's one way of staying built but
  unindexed. A reader can still reach it from /questions and from its own URL,
  which is the whole point of keeping it.
*/}
<Base
  title={story ? story.data.title : question.question}
  description={
    story
      ? story.data.one_line
      : (question.reason ?? 'A question YEGFacts considered, with every claim under it.')
  }
  sections={story ? articleSections : entrySections}
  indexable={withdrawn === undefined}
  article={published ? { published, modified: story?.data.last_verified } : undefined}
>
  {
    story && Content ? (
      <>
        {story.data.status === 'pending-review' && <PendingBanner />}
        {withdrawn && (
          <aside
            class="mb-8 border-t-2 border-b border-t-gold border-b-rule bg-wash px-4 py-3.5"
            role="note"
          >
            <p class="text-sm font-semibold text-forest">
              No longer a finding · <time datetime={withdrawn.date}>{withdrawn.date}</time>
            </p>
            <p class="mt-1 text-sm leading-relaxed text-muted">
              This is no longer a finding. {withdrawn.reason} The page stays for the record: the
              question, the claims under it and the whole evidence trail are below.
            </p>
          </aside>
        )}

        <article>
          <header class="border-b border-rule pb-7">
            {/*
              The kicker names the genre before the topics name the subject: a
              reader arriving from a search result should know this is a fact
              check without reading the title first.
            */}
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs text-muted">
              <span>Fact check ·</span>
              <TopicTags topics={story.data.topics} />
            </div>
            <h1 class="mt-3 text-[1.75rem] leading-[1.15] font-extrabold tracking-[-0.022em] text-balance sm:text-display">
              {story.data.title}
            </h1>

            {/* The question this page answers, in the words the register asks it in. */}
            <p class="mt-3 max-w-prose font-display text-[1.1875rem] leading-snug text-muted text-pretty" data-record>
              {question.question}
            </p>

            {/*
              The verdict strip. The findings used to arrive at section four,
              two or three screens down on a phone. Every claim and its finding
              now sit directly under the title, each row linking down to the
              check that produced it. The question links; the finding word is its
              own control, because the word opens the definition of the word.
            */}
            {answered.length > 0 && (
              <ul class="mt-6 divide-y divide-rule border-y border-rule">
                {answered.map((claim) => (
                  <li class="grid gap-x-8 gap-y-1.5 py-4 sm:grid-cols-[minmax(0,30rem)_1fr] sm:items-baseline">
                    <p class="text-lg leading-snug font-bold text-pretty" data-crossref>
                      <a href={`#${claim.data.id}`} class="link">
                        {claim.data.question}
                      </a>
                      {story.data.primary_claim === claim.data.id && (
                        <span class={mainClaim}>Main claim</span>
                      )}
                    </p>
                    <div>
                      <Gloss {...gloss(claim.data.finding)} variant="boxed">
                        <Finding finding={claim.data.finding} size="md" />
                      </Gloss>
                    </div>
                  </li>
                ))}
              </ul>
            )}

            {/*
              One-line summary: one sentence, thirty words, enforced by the
              validator. On a phone the Copy control drops under the sentence.
            */}
            <div class="mt-6 flex flex-col items-start gap-2.5 sm:flex-row sm:gap-3">
              <p class="grow border-l-2 border-gold pl-3.5 text-lg leading-relaxed text-forest text-pretty">
                {story.data.one_line}
              </p>
              <CopyButton text={story.data.one_line} url={pageUrl} label="Copy" />
            </div>

            {/*
              Provenance, then dates. Naming the panel and the rule here — both
              glossed, both linking into the methodology — puts "who decided
              this?" where the finding is.
            */}
            <p class="mt-5 text-xs text-muted">
              Verdicts by a <Gloss {...gloss('three-model AI panel')}>three-model AI panel</Gloss>{' '}
              under a <Gloss {...gloss('published rule')}>published rule</Gloss> ·{' '}
              <Gloss {...gloss('as of')}>as of</Gloss>{' '}
              <time datetime={story.data.as_of}>{story.data.as_of}</time> ·{' '}
              <Gloss {...gloss('last verified')}>last verified</Gloss>{' '}
              <time datetime={story.data.last_verified}>{story.data.last_verified}</time> ·{' '}
              <Gloss {...gloss('next review by')}>next review by</Gloss>{' '}
              <time datetime={story.data.review_by}>{story.data.review_by}</time>
              {methodologyVersions.length > 0 && (
                <>
                  {' '}·{' '}
                  <Gloss {...gloss('methodology version')} hrefLabel="See what changed">
                    methodology v{methodologyVersions.join(', v')}
                  </Gloss>
                </>
              )}
            </p>
          </header>

          {/*
            The TL;DR follows the one-sentence answer directly, because it is
            the next layer of the same answer: one_line → tldr → body.
          */}
          {story.data.tldr.length > 0 && (
            <section id="tldr" class="mt-14">
              <div class="flex items-baseline justify-between gap-3">
                <h2 class="section-heading">TL;DR</h2>
                <CopyButton
                  text={story.data.tldr.map((line) => `• ${line}`).join('\n')}
                  url={`${pageUrl}#tldr`}
                  label="Copy"
                />
              </div>
              <ul class="mt-3.5 space-y-2">
                {story.data.tldr.map((line) => (
                  <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">
                    {line}
                  </li>
                ))}
              </ul>
            </section>
          )}

          {/* Common forms of the claim — what people say, before what is true. */}
          <SeenCards seen={story.data.seen} />

          <section id="what-happened">
            <h2 class={heading}>What actually happened</h2>
            <div class="prose mt-4">
              <Content />
            </div>
          </section>

          <section id="claims-checked">
            <h2 class={heading}>Claims checked</h2>
            {answered.length === 0 ? (
              <p class="mt-4 border-l-2 border-rule-strong pl-3.5 text-sm text-muted">
                No claims under this question have completed the review panel yet.
              </p>
            ) : (
              <div class="mt-4 space-y-8">
                {answered.map((claim) => (
                  <div id={claim.data.id} class="scroll-mt-6 border-t border-rule-strong pt-5">
                    <h3 class="text-lg font-semibold tracking-[-0.012em] text-pretty">
                      <a href={`/claims/${claim.data.id}`} class="link">
                        {claim.data.question}
                      </a>
                      {story.data.primary_claim === claim.data.id && (
                        <span class={mainClaim}>Main claim</span>
                      )}
                    </h3>

                    {/* The verdict, then the panel behind it, then what it rests on. */}
                    <p class="mt-3.5 flex flex-wrap items-baseline gap-x-2 gap-y-1.5">
                      <Gloss {...gloss(claim.data.finding)} variant="boxed">
                        <Finding finding={claim.data.finding} size="md" />
                      </Gloss>
                      <span class="text-[0.9375rem] text-muted">
                        ·{' '}
                        <Gloss {...gloss(claim.data.panel_agreement)}>
                          {claim.data.panel_agreement}
                        </Gloss>{' '}
                        panel
                      </span>
                    </p>

                    <p class="mt-2.5 text-sm leading-relaxed text-muted">
                      <Gloss {...gloss('evidence basis')}>Evidence basis</Gloss>:{' '}
                      {claim.data.evidence_basis}
                    </p>

                    {/*
                      Four facts, then the rest behind a native disclosure. A
                      claim carrying ten facts pushed the next claim off the
                      phone screen; every fact still renders into the HTML, so
                      Pagefind and the duplication audit read the whole list.
                    */}
                    {claim.data.key_facts.length > 0 && (
                      <ul class="mt-4 space-y-2">
                        {claim.data.key_facts.slice(0, 4).map((fact) => (
                          <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">
                            {fact.text}{' '}
                            {fact.sources.map((id, index) => (
                              <>
                                {index > 0 && ', '}
                                <a href={`/evidence/${id}`} class="link">
                                  {id}
                                </a>
                              </>
                            ))}
                          </li>
                        ))}
                      </ul>
                    )}

                    {claim.data.key_facts.length > 4 && (
                      <details class="mt-2">
                        <summary class="link inline-flex min-h-10 cursor-pointer list-none items-center text-sm">
                          {claim.data.key_facts.length - 4} more
                          {claim.data.key_facts.length - 4 === 1 ? ' fact' : ' facts'}
                        </summary>
                        <ul class="space-y-2 pb-1">
                          {claim.data.key_facts.slice(4).map((fact) => (
                            <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">
                              {fact.text}{' '}
                              {fact.sources.map((id, index) => (
                                <>
                                  {index > 0 && ', '}
                                  <a href={`/evidence/${id}`} class="link">
                                    {id}
                                  </a>
                                </>
                              ))}
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}

                    {/*
                      The wordings this claim was actually said in, gathered
                      from the register entries merged into it, so a person who
                      commented on the original post can find their own words
                      beside the answer.
                    */}
                    <AlsoSaidAs registerClaims={claim.data.register_claims} />

                    {claim.data.limitations.length > 0 && (
                      <div class="mt-4">
                        <h4 class="text-xs font-semibold tracking-[0.08em] text-muted uppercase">
                          Limitations
                        </h4>
                        <ul class="mt-1.5 space-y-1 text-sm text-muted">
                          {claim.data.limitations.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </div>
                    )}

                    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
                      <TopicTags topics={claimTopics(claim, story)} />
                      <span data-pagefind-filter={`finding:${claim.data.finding}`} class="sr-only">
                        {claim.data.finding}
                      </span>
                      <CopyButton
                        text={`${claim.data.question} — ${claim.data.finding} (${claim.data.panel_agreement} panel). YEGFacts.ca`}
                        url={new URL(`/claims/${claim.data.id}`, Astro.site ?? SITE.url).href}
                        label="Copy citation"
                      />
                    </div>
                  </div>
                ))}
              </div>
            )}
          </section>

          {/*
            The claims under this question that nobody has checked. A published
            question keeps collecting them: the site answered the question and
            people went on making claims about it. Listing them under a heading
            that says so is the only honest place for them — inside "Claims
            checked" they would read as checked, and left off the page they
            would read as never made.
          */}
          {registered.length > 0 && (
            <section id="not-checked">
              <h2 class={heading}>Claims with no finding</h2>
              <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
                These were made about this question and have not been through the panel. The
                question above is answered; these claims are not, and nothing here says whether any
                of them is true.
              </p>
              <ul class="mt-5 divide-y divide-rule border-t border-rule">
                {registered.map((claim) => (
                  <li id={claim.id} class="scroll-mt-6 py-4">
                    <a
                      href={`/claims/${claim.id}`}
                      class="link font-display text-[1.0625rem] leading-snug font-semibold text-pretty"
                      data-record
                    >
                      {claimText(claim)}
                    </a>
                    {commentsOn(claim) > 0 && (
                      <p class={`mt-1.5 ${label}`} data-record>
                        {saidIn(commentsOn(claim))}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )}

          {commitments.length > 0 && (
            <section id="commitments">
              <h2 class={heading}>What the City promised</h2>
              <ul class="mt-4 divide-y divide-rule border-t border-rule">
                {commitments.map((commitment) => (
                  <li class="py-4">
                    <p class="text-[0.9375rem] leading-relaxed">{commitment.data.statement}</p>
                    <p class="mt-1.5 text-xs text-muted">
                      {commitment.data.promised_by} ·{' '}
                      <time datetime={commitment.data.promised_on}>
                        {commitment.data.promised_on}
                      </time>{' '}
                      · {commitment.data.status} ·{' '}
                      <a href={`/evidence/${commitment.data.source}`} class="link">
                        {commitment.data.source}
                      </a>
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section id="evidence">
            <h2 class={heading}>Edmonton evidence</h2>
            {evidence.length === 0 ? (
              <p class="mt-4 border-l-2 border-rule-strong pl-3.5 text-sm text-muted">
                No evidence objects are registered for this question yet.
              </p>
            ) : (
              <ul class="mt-4 divide-y divide-rule border-t border-rule">
                {evidence.map((entry) => (
                  <li class="py-4">
                    <a href={`/evidence/${entry.data.id}`} class="link font-semibold">
                      {entry.data.title}
                    </a>
                    <p class="mt-1 text-xs text-muted" data-record>
                      {entry.data.publisher} · retrieved{' '}
                      <time datetime={entry.data.retrieved_on}>{entry.data.retrieved_on}</time> ·{' '}
                      {entry.data.id}
                    </p>
                  </li>
                ))}
              </ul>
            )}
          </section>

          {comparisons.length > 0 && (
            <section id="comparisons">
              <h2 class={heading}>Comparable cities</h2>
              {comparisonGroups.map((group) => (
                <div class="mt-4">
                  {comparisonGroups.length > 1 && (
                    /* data-crossref: the group heading names the claim it belongs to. */
                    <p class="text-xs text-muted" data-crossref>
                      On{' '}
                      <a href={`#${group.claim.data.id}`} class="link">
                        {group.claim.data.question}
                      </a>
                    </p>
                  )}
                  <ul class="mt-2 divide-y divide-rule border-t border-rule">
                    {group.comparisons.map((comparison) => (
                      <li class="py-4">
                        <p class="font-semibold">{comparison.city}</p>
                        <p class="mt-1 text-[0.9375rem] leading-relaxed">{comparison.note}</p>
                        <p class="mt-1.5 text-sm text-muted">
                          <span class="font-semibold">Transfers to Edmonton?</span>{' '}
                          {comparison.transferability}
                        </p>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>
          )}

          {unknowns.length > 0 && (
            <section id="unknown">
              <h2 class={heading}>What remains unknown</h2>
              <ul class="mt-4 space-y-2">
                {unknowns.map((text) => (
                  <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">
                    {text}
                  </li>
                ))}
              </ul>
            </section>
          )}

          {missing.length > 0 && (
            <section id="missing-evidence">
              <h2 class={heading}>Missing evidence</h2>
              <p class="mt-1.5 text-sm text-muted">
                Records we asked for and have not received, or that do not appear to exist publicly.
              </p>
              <ul class="mt-3 space-y-2">
                {missing.map((text) => (
                  <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">
                    {text}
                  </li>
                ))}
              </ul>
            </section>
          )}

          <AiReview story={story} claims={answered} />

          {/*
            The register entry behind the article. It is not preamble: the
            decision to spend a panel run on this question, the reason, and the
            grouping that put these claims together are the parts a reader
            checking for cherry-picking wants, and they belong on the page the
            finding is on rather than in a separate ledger.
          */}
          <section id="registered">
            <h2 class={heading}>How it was registered</h2>
            <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-muted" data-record>
              Registered <time datetime={question.recorded}>{question.recorded}</time>
              {row.comments > 0 && ` · ${saidIn(row.comments)}`}
            </p>

            <dl class="mt-4 divide-y divide-rule border-y border-rule">
              {states.map((state) => (
                <div class="py-2.5 sm:flex sm:gap-5">
                  <dt class:list={[label, 'sm:w-64 sm:shrink-0']}>{state.term}</dt>
                  <dd class="mt-0.5 text-[0.9375rem] leading-relaxed sm:mt-0" data-record>
                    {state.value}
                  </dd>
                </div>
              ))}
            </dl>

            {question.reason && (
              <p
                class="mt-5 max-w-prose border-l-2 border-gold pl-3.5 text-[1.0625rem] leading-relaxed text-pretty"
                data-record
              >
                {question.reason}
              </p>
            )}

            {question.grouping_note && (
              <p class="mt-4 max-w-prose text-[0.9375rem] leading-relaxed text-muted" data-record>
                {question.grouping_note}
              </p>
            )}

            {row.twoSided && (
              <p class="mt-4 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
                People arguing in both directions raised this question, and every claim they made
                about it is checked, whichever way it points.
              </p>
            )}

            {source && (
              <p class="mt-4 max-w-prose text-[0.9375rem] leading-relaxed">
                Taken from{' '}
                <a href={`/sources/${source.id}`} class="link">
                  {source.title}
                </a>
                , read end to end: {sourceKind(source).toLowerCase()}, captured{' '}
                <time datetime={source.captured}>{source.captured}</time>
                {source.comments !== undefined && `, ${source.comments} comments`}. Every factual
                claim in it was extracted and merged, so this question is listed whatever became of
                it.
              </p>
            )}

            <p class="mt-5 text-sm" data-crossref>
              <a href="/questions#states" class="link">What the states mean</a>
            </p>
          </section>

          <section id="history">
            <h2 class={heading}>Article history</h2>
            {story.data.changelog.length > 0 ? (
              <ul class="mt-4 divide-y divide-rule border-t border-rule">
                {[...story.data.changelog]
                  .sort((a, b) => b.date.localeCompare(a.date))
                  .map((entry) => (
                    <li class="flex flex-wrap gap-x-3 py-2.5 text-sm">
                      <time datetime={entry.date} class="text-muted">
                        {entry.date}
                      </time>
                      <span class="font-semibold text-forest">{entry.type}</span>
                      <span class="basis-full text-ink sm:basis-auto">{entry.note}</span>
                    </li>
                  ))}
              </ul>
            ) : (
              <p class="mt-4 border-l-2 border-rule-strong pl-3.5 text-sm text-muted">
                No history yet — this question has not been published or revised.
              </p>
            )}
            <p class="mt-3 text-xs text-muted">
              Every revision is in the{' '}
              <a
                href={`${SITE.repo}/commits/main/src/content/stories/${story.id}.mdx`}
                rel="noopener"
                class="link"
              >
                public commit history of this file
              </a>
              .
            </p>
          </section>
        </article>
      </>
    ) : (
      <QuestionEntry row={row} reports={reports} />
    )
  }
</Base>
