---
import { allPublicStories, claimsForStory } from '../lib/content';

/**
 * Root-level alias redirects (spec §6). Hostile or colloquial phrasings — the
 * words people actually search — land on the question, or on the claim's own
 * page when the alias came from a claim.
 *
 * A claim's alias used to land on an anchor inside the article, because an
 * anchor was the only address a claim had. D-0029 gave every claim a page, so
 * the phrasing somebody searched now lands on the page that answers it rather
 * than partway down a longer one.
 *
 * Aliases of `draft` articles generate nothing: the source list is
 * `allPublicStories()` — a withdrawn one keeps its aliases, since it keeps its
 * page.
 */
export async function getStaticPaths() {
  const stories = await allPublicStories();
  const paths: Array<{ params: { alias: string }; props: { target: string } }> = [];
  const seen = new Set<string>();

  const add = (alias: string, target: string) => {
    const slug = alias.replace(/^\/+/, '');
    if (!slug || seen.has(slug)) return;
    seen.add(slug);
    paths.push({ params: { alias: slug }, props: { target } });
  };

  for (const story of stories) {
    for (const alias of story.data.aliases) {
      add(alias, `/questions/${story.id}`);
    }
    for (const claim of await claimsForStory(story)) {
      for (const alias of claim.data.aliases) {
        add(alias, `/claims/${claim.data.id}`);
      }
    }
  }

  return paths;
}

const { target } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>.</p>
  </body>
</html>
