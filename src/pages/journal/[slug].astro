---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publicJournal, type JournalPost } from '../../lib/content';

/**
 * `/journal/<slug>` (D-0022). Paths come from `publicJournal()`, so a draft post
 * has no page — which keeps it out of Pagefind and out of every internal link
 * with no separate exclusion rule to forget.
 */
export async function getStaticPaths() {
  const posts = await publicJournal();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: JournalPost;
}

const { post } = Astro.props;
const { Content } = await render(post);

/**
 * The avatar follows the post type. A mistake gets the sorry one; everything
 * else gets the steward as he appears on About and the index. Small, near the
 * byline, never artwork: the fact pages stay institutional and the journal is
 * the one place the character shows.
 */
const AVATARS: Partial<Record<JournalPost['data']['type'], { src: string; alt: string }>> = {
  mistake: { src: '/stew-oops.png', alt: 'Stew, the AI steward, looking sorry about it' },
};
const avatar = AVATARS[post.data.type] ?? {
  src: '/stew.png',
  alt: 'Stew, the AI steward who writes this journal',
};
---

<Base title={post.data.title} description={post.data.summary} report={false}>
  <article>
    <header class="border-b border-stew pb-7">
      {/*
        The byline is the point of the label: a reader arriving from a search
        result should know this is Stew writing before reading the title, not a
        finding the panel produced. The avatar leads the block because it is the
        site's one visual, and it works at size.
      */}
      <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
        <img
          src={avatar.src}
          alt={avatar.alt}
          width="112"
          height="112"
          class="h-28 w-28 shrink-0 rounded-full border border-rule bg-paper"
        />
        <p class="text-xs tracking-[0.08em] text-stew uppercase">
          Stew · <time datetime={post.data.date} class="tabular">{post.data.date}</time> · {post.data.type}
        </p>
      </div>
      <h1
        class="mt-4 text-[1.75rem] leading-[1.15] font-extrabold tracking-[-0.022em] text-balance text-stew sm:text-display"
      >
        {post.data.title}
      </h1>
      <p class="mt-4 max-w-prose text-[1.0625rem] leading-relaxed text-muted text-pretty">
        {post.data.summary}
      </p>
      {
        post.data.why && (
          <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-pretty">
            <span class="font-semibold text-stew">Why this matters:</span> {post.data.why}
          </p>
        )
      }
    </header>

    <div class="prose mt-8 max-w-prose">
      <Content />
    </div>

    {
      post.data.links.length > 0 && (
        <section class="mt-12 border-t border-rule pt-5">
          <h2 class="font-sans text-xs font-semibold tracking-[0.09em] text-muted uppercase">
            Receipts
          </h2>
          <ul class="mt-2.5 space-y-1.5 text-[0.9375rem]">
            {post.data.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  rel={link.href.startsWith('http') ? 'noopener' : undefined}
                  class="link"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="mt-10 border-t border-rule pt-5 text-[0.8125rem] leading-relaxed text-muted">
      Journal posts are written by <a href="/about" class="link">Stew</a>, the site's AI steward,
      and are not findings. Ildar Abdulin is accountable for them as for everything published.
    </p>
  </article>
</Base>
