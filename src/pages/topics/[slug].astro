---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import QuestionList from '../../components/QuestionList.astro';
import type { Topic } from '../../lib/content';
import { questionRows, type QuestionRow } from '../../lib/questions';

/**
 * A topic hub: the label, one line saying what it covers, and the questions
 * filed under it.
 *
 * Nothing else, by decision (D-0029). No summary of what the questions
 * concluded and no findings roll-up: a grouping that draws a conclusion sits
 * two levels above the audited unit, which is where an unchecked conclusion
 * gets in. The `overview` is a description of the subject, written to be a
 * description and checked by CI for being one.
 */
export async function getStaticPaths() {
  const topics = await getCollection('topics');
  const rows = await questionRows();

  return topics.map((topic) => ({
    params: { slug: topic.data.slug },
    props: {
      topic,
      questions: rows.filter((row) => row.topics.includes(topic.data.slug)),
    },
  }));
}

interface Props {
  topic: Topic;
  questions: QuestionRow[];
}

const { topic, questions } = Astro.props;
---

<Base title={topic.data.name} description={topic.data.overview}>
  <header class="border-b border-rule pb-6">
    <p class="text-xs font-semibold tracking-[0.09em] text-muted uppercase">
      <a href="/topics" class="link">Topic</a>
    </p>
    <h1
      class="mt-2 text-[1.75rem] leading-[1.15] font-bold tracking-[-0.022em] sm:text-display"
    >
      {topic.data.name}
    </h1>
    <p class="mt-3 max-w-prose text-base leading-relaxed text-muted">{topic.data.overview}</p>
  </header>

  <section class="mt-9">
    <h2 class="font-sans text-xs font-semibold tracking-[0.09em] text-muted uppercase">
      Questions under this topic
    </h2>
    {
      questions.length > 0 ? (
        <div class="mt-4">
          <QuestionList rows={questions} />
        </div>
      ) : (
        <p class="mt-4 border-l-2 border-gold pl-3.5 text-[0.9375rem] leading-relaxed text-muted">
          Nothing is filed under this topic yet.
        </p>
      )
    }
    <p class="mt-6 text-sm" data-crossref>
      <a href="/questions" class="link">Every question we've considered</a>, whatever its state.
    </p>
  </section>
</Base>
