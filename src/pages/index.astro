---
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import path from 'node:path';

import symbol from '../assets/symbol.png';
import Base from '../layouts/Base.astro';
import FindingsBoard from '../components/FindingsBoard.astro';
import ReportBox from '../components/ReportBox.astro';
import SearchGlyph from '../components/SearchGlyph.astro';
import StewByline from '../components/StewByline.astro';
import {
  orderedTopics,
  publishedClaims,
  publishedStories,
} from '../lib/content';
import { questionRows } from '../lib/questions';
import { SITE } from '../lib/site';
import { CANONICAL_FINDINGS } from '../lib/vocabulary';
import { loadRunManifest } from '../../scripts/lib/review-schema.ts';
import { highestMethodologyVersion } from '../../scripts/lib/repo.ts';
import { methodologyChanges } from '../lib/methodology';

/**
 * The home page is the record, not an index of it. Everything below is read out
 * of the content collections, the evidence registry, the review manifests and
 * the methodology changelog at build time, so no number here can be stale or
 * hand-maintained.
 */
const stories = await publishedStories();
const rows = await publishedClaims();
const claimCount = rows.length;
/**
 * Questions counted through the rows, not through the story list, so the two
 * halves of "N claims under M questions" are the same set. Since methodology
 * v1.19 a claim can leave the board on its own, and a question whose every
 * claim has left it is not a question this sentence is counting.
 */
const questionCount = new Set(rows.map((row) => row.story.id)).size;

/** The most recent claims, in the record's own order. */
const recent = rows.slice(0, 8);

const findingCounts = CANONICAL_FINDINGS.map((finding) => ({
  finding,
  count: rows.filter((row) => row.claim.data.finding === finding).length,
})).filter((entry) => entry.count > 0);

/**
 * How many reviewers actually sat on the newest claim's panel, read from the
 * run manifest rather than asserted in prose. Round 1 is the blind round, so it
 * is the round the sentence is about.
 */
let reviewerCount: number | undefined;
const newest = rows[0];
if (newest) {
  const manifestPath = path.join(process.cwd(), newest.claim.data.review_run, 'run.yaml');
  if (existsSync(manifestPath)) {
    const manifest = loadRunManifest(manifestPath);
    const providers = new Set(
      manifest.runs.filter((seat) => seat.round === 1).map((seat) => seat.provider),
    );
    reviewerCount = providers.size > 0 ? providers.size : undefined;
  }
}

const evidenceCount = (await getCollection('evidence')).length;
const methodologyVersion = highestMethodologyVersion(methodologyChanges());

/** A topic's weight is how many checked claims sit under it, not how many questions. */
/**
 * Topics count questions, not checked claims.
 *
 * Counting checked claims made the biggest topic on the site read "no claims
 * yet": bike lanes holds twenty-six questions and none of them has been
 * checked, because the register filled up faster than the panel did. A
 * navigation list that hides where the argument is because nobody has answered
 * it yet is navigation pointed at the wrong thing. A question can carry several
 * topics, so these do not sum to the total and the line above no longer says
 * they do.
 */
const questions = await questionRows();
const topics = (await orderedTopics()).map((topic) => ({
  ...topic.data,
  count: questions.filter((row) => row.topics.includes(topic.data.slug)).length,
}));

const CHANGE_LABELS: Record<'correction' | 'verdict-change', string> = {
  correction: 'Correction',
  'verdict-change': 'Verdict change',
};

/** The note up to its first full stop, so the list reads as a list. */
function firstSentence(note: string): string {
  const trimmed = note.trim();
  const end = /[.!?](?=\s|$)/.exec(trimmed);
  return end ? trimmed.slice(0, end.index + 1) : trimmed;
}

const corrections = stories
  .flatMap((story) =>
    story.data.changelog
      .filter((entry) => entry.type === 'correction' || entry.type === 'verdict-change')
      .map((entry) => ({ story, entry })),
  )
  .sort(
    (a, b) =>
      b.entry.date.localeCompare(a.entry.date) ||
      a.story.data.title.localeCompare(b.story.data.title),
  )
  .slice(0, 5)
  .map((row) => {
    const sentence = firstSentence(row.entry.note);
    return { ...row, sentence, truncated: sentence !== row.entry.note.trim() };
  });

/** The broadsheet section head: a 3px ink rule, then the title in the display face. */
const head = 'border-t-[3px] border-ink pt-3.5';
const headText = 'font-display text-[1.75rem] leading-[1.15] font-bold tracking-[-0.01em] text-ink';
/* A lead is content, not metadata: it reads at full strength, like the section it opens. */
const lead = 'mt-1.5 max-w-[62ch] text-base text-pretty text-ink';
/** The metadata register: small caps, used for a date-and-type label only. */
const label = 'text-[0.6875rem] font-bold tracking-[0.1em] uppercase';
const topicName = 'font-display text-[1.25rem] leading-snug font-semibold';

/**
 * Who the site is and how to search it, said once in a machine-readable form.
 * The organization carries an `@id` so the site node can point at it rather
 * than describing the publisher twice, and the search action names the query
 * parameter `/search` actually reads.
 */
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.tagline,
    publisher: { '@id': `${SITE.url}/#org` },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE.url}/search?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#org`,
    name: SITE.name,
    url: SITE.url,
    logo: new URL(symbol.src, Astro.site ?? SITE.url).href,
    email: SITE.email,
    sameAs: [SITE.repo],
  },
];
---

<Base
  title={`${SITE.name} — Claims about Edmonton's city government, checked against the record`}
  description="Fact checks of what people say about Edmonton's city government, tested against bylaws, budgets, court filings and open data, with the evidence shown."
  rail={false}
  jsonLd={jsonLd}
>
  {/*
    The deck sits under the header row and the search extends the masthead, so
    the forest block reads top to bottom as one thing: who we are, what we do,
    the way in, and how much of the record is behind it.

    From `lg` the counts sit out to the right of the sentence, on its last line,
    rather than under the search box: the sentence never fills the measure, and
    the two together cost one band of height instead of two. Below `lg` they
    fall under the sentence as one wrapped line, ahead of the search field —
    what the site holds, then the way into it.
  */}
  <Fragment slot="deck">
    <div class="pt-3 lg:flex lg:items-end lg:justify-between lg:gap-8">
      <h1
        class="max-w-[46ch] font-display text-[clamp(1.375rem,1.9vw,1.625rem)] leading-[1.3] font-medium text-balance text-paper"
      >
        YEGFacts checks what people say about Edmonton's city government against the public record.
      </h1>
      {/*
        How much record is behind the box, read off the record itself at build
        time. Three counts, three different things: questions registered,
        claims checked, sources archived. One sentence on a phone; three
        stacked lines against the right edge from `lg`, where the separators
        would only be punctuation at the end of a line.
      */}
      <p
        class="mt-3 text-[0.875rem] text-paper/75 tabular lg:mt-0 lg:shrink-0 lg:text-right lg:leading-snug"
      >
        <span class="lg:block">
          <span class="font-semibold text-paper">{questions.length}</span>{' '}
          {questions.length === 1 ? 'question' : 'questions'} on the register
        </span>
        <span class="lg:hidden"> · </span>
        <span class="lg:block">
          <span class="font-semibold text-paper">{claimCount}</span>{' '}
          {claimCount === 1 ? 'claim' : 'claims'} checked
        </span>
        <span class="lg:hidden"> · </span>
        <span class="lg:block">
          <span class="font-semibold text-paper">{evidenceCount}</span>{' '}
          {evidenceCount === 1 ? 'source' : 'sources'} archived
        </span>
      </p>
    </div>
  </Fragment>
  <Fragment slot="masthead">
    <div class="pb-5">
      <form action="/search" method="get" class="mt-3" role="search">
        <div class="flex flex-wrap gap-3">
          {/*
            The field is set in the display face and its placeholder is a real
            claim this site has checked, not an "e.g." — the box says what kind
            of question it answers by showing one. The glyph is the same 20x20
            magnifier the header carries, laid over the field's own padding so
            it costs no layout and takes no clicks.
          */}
          <div class="relative flex min-w-0 flex-1 basis-72 items-stretch">
            <SearchGlyph class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-muted" />
            <input
              id="home-search"
              type="search"
              name="q"
              placeholder="Did Edmonton lose $82 million on its electric buses?"
              aria-label="Search checked claims"
              autocomplete="off"
              class="h-[52px] w-full min-w-0 appearance-none rounded-none border-0 bg-white pr-3.5 pl-12 font-display text-[1.125rem] text-ink placeholder:text-muted placeholder:italic focus-visible:outline-offset-2"
            />
          </div>
          <button
            type="submit"
            class="h-[52px] cursor-pointer rounded-none bg-brick px-7 text-[1rem] font-bold text-white hover:bg-[#75261b] max-[40rem]:grow max-[40rem]:basis-full"
          >
            Search
          </button>
        </div>
      </form>
    </div>
  </Fragment>

  {
    stories.length === 0 && (
      <p class="mb-10 border-l-[5px] border-gold pl-4 text-base leading-relaxed text-muted">
        Nothing is published yet. The first questions go through the full review panel before they
        are answered here — how that works is set out in the{' '}
        <a href="/methodology" class="link">
          methodology
        </a>
        .
      </p>
    )
  }

  {/*
    The front page: the record on the left across both rows, the way in on the
    right — topics top-right, then Stew and the report box under them. Source
    order is topics, the record, then the aside, which is the order a phone
    reads them in; at `lg` the grid puts each in its cell without moving any.
    Row 1 is `auto` and row 2 takes the rest, so the height the record has over
    the right-hand column falls below the aside rather than opening a gap above
    it.
  */}
  <div
    class="lg:grid lg:grid-cols-[minmax(0,62fr)_minmax(0,34fr)] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-12"
  >
    <section class="lg:col-start-2 lg:row-start-1">
      <div class={head}><h2 class={headText}>Browse by topic</h2></div>
      <p class={lead}>
        A question can sit under more than one topic, so these do not add up to the total above.
      </p>
      <ul class="mt-4">
        {
          topics.map((topic) => (
            <li class="flex items-baseline justify-between gap-4 py-1.5">
              {topic.count > 0 ? (
                <Fragment>
                  <a href={`/topics/${topic.slug}`} class:list={['link-title', topicName]}>
                    {topic.name}
                  </a>
                  <span class="text-[0.875rem] whitespace-nowrap text-muted tabular">
                    {topic.count} {topic.count === 1 ? 'question' : 'questions'}
                  </span>
                </Fragment>
              ) : (
                <Fragment>
                  <span class:list={[topicName, 'text-muted']}>{topic.name}</span>
                  <span class="text-[0.875rem] whitespace-nowrap text-muted italic">
                    nothing yet
                  </span>
                </Fragment>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    {
      claimCount > 0 && (
        <section class="mt-11 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:mt-0">
          <div class={head}>
            <h2 class={headText}>Recently checked</h2>
          </div>
          <p class:list={[lead, 'tabular']}>
            {claimCount}
            {claimCount === 1 ? ' claim under ' : ' claims under '}
            {questionCount}
            {questionCount === 1 ? ' question: ' : ' questions: '}
            {findingCounts.map((entry, index) => (
              <Fragment>
                {index > 0 && ' · '}
                <span class="font-bold text-ink">
                  {entry.count} {entry.finding}
                </span>
              </Fragment>
            ))}
          </p>
          <div class="mt-7">
            <FindingsBoard groups={[{ label: '', rows: recent }]} />
          </div>
          <p class="mt-1 text-[0.9375rem] font-semibold">
            <a href="/search#every-claim" class="link">
              Every checked claim, by topic
            </a>
          </p>
        </section>
      )
    }

    <aside
      class="mt-11 lg:col-start-2 lg:row-start-2 lg:mt-10"
      aria-label="About the site"
      data-pagefind-ignore
    >
      <StewByline stack class="border-t border-stew pt-5">
        <p class="text-[0.9375rem] leading-relaxed text-muted">
          Built by <a href="/about" class="link-stew">Stew</a>, an AI steward: the research runs,
          the code, the evidence archive and most of the words on this site. Self-funded, no ads,
          no political money: <a href="/support" class="link">what it costs and who pays</a>.
        </p>
      </StewByline>
      <div class="mt-8">
        <ReportBox path="/" title={SITE.name} />
      </div>
    </aside>
  </div>

  <section id="how-a-verdict-is-made" class="mt-14">
    <div class={head}><h2 class={headText}>How a verdict is made</h2></div>
    <p class={lead}>
      Every finding goes through the same four steps. Methodology v{methodologyVersion},{' '}
      <a href="/methodology/changes" class="link">change history</a>.
    </p>

    {/* The numerals are a CSS counter on this list — see `.steps` in global.css. */}
    <div class="strip mt-6">
      <ol class="steps">
        <li>
          <h3 class="font-sans text-base leading-[1.3] font-bold">Blind research</h3>
          <p class="mt-2 text-base text-ink">
            {
              reviewerCount
                ? `${reviewerCount} AI reviewers, each from a different company, research every claim without seeing each other's work.`
                : "AI reviewers from different companies research every claim without seeing each other's work."
            }{' '}
            <a href="/methodology#stages" class="link">How the rounds run</a>.
          </p>
        </li>
        <li>
          <h3 class="font-sans text-base leading-[1.3] font-bold">A rule, not a vote</h3>
          <p class="mt-2 text-base text-ink">
            A lookup table published in advance turns the reviewers' verdicts into one finding.
            Nobody votes on it.{' '}
            <a href="/methodology#synthesis" class="link">The table</a>.
          </p>
        </li>
        <li>
          <h3 class="font-sans text-base leading-[1.3] font-bold">Archived sources</h3>
          <p class="mt-2 text-base text-ink">
            Before publication every statement is checked against the archived bytes of the sources
            it cites, not the live web.{
              evidenceCount > 0 && (
                <Fragment>
                  {' '}
                  <a href="/evidence" class="link">
                    {evidenceCount} sources archived
                  </a>{' '}
                  so far.
                </Fragment>
              )
            }
          </p>
        </li>
        <li>
          <h3 class="font-sans text-base leading-[1.3] font-bold">Four words</h3>
          <p class="mt-2 text-base text-ink">
            A finding is one of four words with a fixed meaning. Not established means the record
            can't answer yet, not that the claim is false.{' '}
            <a href="/methodology#vocabulary" class="link">What each word means</a>.
          </p>
        </li>
      </ol>
    </div>
    <p class="mt-5 text-[0.9375rem] font-semibold">
      <a href="/questions" class="link">Every question we've considered, including the ones we parked and declined</a>.
    </p>
  </section>

  <section class="mt-14">
    <div class={head}><h2 class={headText}>Corrections</h2></div>
    <p class={lead}>What changed after publication, on the page it changed.</p>
    {
      corrections.length === 0 ? (
        <p class="mt-4 text-base text-muted">
          No corrections yet.{' '}
          <a href="/about#corrections" class="link">
            How to report one.
          </a>
        </p>
      ) : (
        <div class="panel panel-brick mt-6 p-5 sm:p-8">
          <ul>
            {corrections.map((row) => (
              <li class="[&+li]:mt-6 [&+li]:border-t [&+li]:border-rule [&+li]:pt-6">
                <p class:list={[label, 'text-brick tabular']}>
                  <time datetime={row.entry.date}>{row.entry.date}</time> ·{' '}
                  {CHANGE_LABELS[row.entry.type as 'correction' | 'verdict-change']}
                </p>
                <p class="mt-1.5 font-display text-[1.1875rem] leading-snug font-semibold">
                  <a href={`/questions/${row.story.id}`} class="link-title">
                    {row.story.data.title}
                  </a>
                </p>
                <p class="mt-2 max-w-[78ch] text-base text-ink">
                  {row.sentence}
                  {row.truncated && (
                    <Fragment>
                      {' '}
                      <a href={`/questions/${row.story.id}#history`} class="link">
                        Full note
                      </a>
                    </Fragment>
                  )}
                </p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

</Base>
