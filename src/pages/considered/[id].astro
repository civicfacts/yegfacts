---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedClaims } from '../../lib/content';
import {
  candidatesWithPages,
  claimText,
  outcomeHeading,
  provenance,
  sourceKind,
  sourceRegister,
  storyLinkLabel,
  type Candidate,
  type Source,
} from '../../lib/intake';
import { repoFile } from '../../lib/site';
import { toc } from '../../lib/toc';

type Report = CollectionEntry<'candidateReports'>;

/**
 * `/considered/<id>` — one candidate, with the records behind its outcome.
 *
 * `/considered` publishes the decision; this publishes the working. Until now
 * the intake record and the triage report were links into GitHub, which asks a
 * reader to leave the site and read a repository to find out why their claim
 * was not checked, and left the claim's wording out of the search index
 * entirely.
 *
 * Since whole-source intake a candidate extracted from a source gets a page
 * even with no report behind it, because it has something a report cannot give:
 * every wording the claim was actually said in, under the pseudonyms the
 * capture uses. That is what lets somebody who commented on the original post
 * find their own words here.
 */
export async function getStaticPaths() {
  const sources = new Map(sourceRegister().map((source) => [source.id, source]));

  /**
   * Where a `variation_of` points. A published claim lives on its story page;
   * a register entry is either a page of its own or a row on `/considered`.
   */
  const pages = candidatesWithPages();
  const targets = new Map<string, { href: string; label: string }>();
  for (const { candidate } of pages) {
    targets.set(candidate.id, {
      href: `/considered/${candidate.id}`,
      label: 'Read what happened to it',
    });
  }
  for (const { claim, story } of await publishedClaims()) {
    targets.set(claim.data.id, {
      href: `/facts/${story.id}#${claim.data.id}`,
      label: 'Read the check',
    });
  }

  return Promise.all(
    pages.map(async ({ candidate, reports }) => ({
      params: { id: candidate.id },
      props: {
        candidate,
        source: candidate.source ? (sources.get(candidate.source) ?? null) : null,
        variation: candidate.variation_of
          ? {
              id: candidate.variation_of,
              ...(targets.get(candidate.variation_of) ?? {
                href: `/considered#${candidate.variation_of}`,
                label: 'Read what happened to it',
              }),
            }
          : null,
        reports: (
          await Promise.all(
            reports.map(async ({ label, path }) => ({
              label,
              path,
              entry: await getEntry('candidateReports', path),
            })),
          )
        ).filter(
          (report): report is { label: string; path: string; entry: Report } =>
            report.entry !== undefined,
        ),
      },
    })),
  );
}

interface Props {
  candidate: Candidate;
  source: Source | null;
  variation: { id: string; href: string; label: string } | null;
  reports: Array<{ label: string; path: string; entry: Report }>;
}

const { candidate, source, variation, reports } = Astro.props;

const rendered = await Promise.all(
  reports.map(async (report) => ({
    label: report.label,
    /** The section id is the record's kind, so the outline reads as the page does. */
    id: report.label === 'Triage' ? 'triage' : 'intake',
    reader: report.entry.data.reader,
    run: report.entry.data.run,
    Content: (await render(report.entry)).Content,
  })),
);

/**
 * The captured wordings, already emptied by the register loader for an entry
 * that names an individual and did not get a GO — the page never receives them,
 * so it cannot print them.
 */
const forms = candidate.forms ?? [];

/**
 * A merged proposition is a sentence we wrote to say what would have to be
 * true, so it is set as a statement; a hand-registered candidate has only the
 * words it arrived in, so it is quoted.
 */
const quoted = candidate.proposition === undefined;

const sections = toc([
  { id: 'outcome', label: 'Outcome' },
  source && { id: 'source', label: 'Where it came from' },
  forms.length > 0 && { id: 'forms', label: 'How it was said' },
  ...rendered.map((report) => ({ id: report.id, label: report.label })),
]);

const label = 'text-xs tracking-[0.08em] text-muted uppercase tabular';
---

<Base
  sections={sections}
  title={claimText(candidate)}
  description={candidate.reason ??
    'A claim YEGFacts considered, with the intake record and triage behind the decision.'}
>
  <article>
    <header class="border-b border-rule pb-7">
      <div class="text-xs text-muted" data-crossref>
        <a href="/considered" class="link">Every claim we've considered</a>
      </div>

      {/*
        The claim in its own words is the title, quoted, because this page is
        about a sentence somebody said rather than about a subject we named.
      */}
      <h1
        class="mt-3 text-[1.5rem] leading-[1.2] font-extrabold tracking-[-0.02em] text-pretty sm:text-[1.875rem]"
      >
        {quoted ? `“${candidate.wording}”` : claimText(candidate)}
      </h1>

      {/* Straight out of the register, in the words `/considered` uses. */}
      <p class={`mt-4 ${label}`} data-record>
        <time datetime={candidate.recorded}>{candidate.recorded}</time>
        {' · '}
        <span class="normal-case tracking-normal">{provenance(candidate)}</span>
        {
          candidate.side && (
            <span class="normal-case tracking-normal">{` · ${candidate.side} the argument`}</span>
          )
        }
        {
          candidate.commenters !== undefined && (
            <span class="normal-case tracking-normal">
              {` · ${candidate.commenters} ${candidate.commenters === 1 ? 'person said it' : 'people said it'}`}
            </span>
          )
        }
      </p>
    </header>

    <section id="outcome" class="mt-10 scroll-mt-6">
      {/* The outcome is a heading, as it is on `/considered`, not a badge. */}
      <h2 class="text-xl font-extrabold tracking-[-0.015em] text-forest">
        {outcomeHeading(candidate.outcome)}
      </h2>
      {
        /*
          Two entries do not print their reason here. A withheld one's title
          already IS its reason — the placeholder the redaction put there. A
          variation's reason says it merged into another entry, which the linked
          sentence below says better, with somewhere to go.
        */
        !candidate.withheld && !variation && (candidate.reason ?? candidate.note) && (
          <p class="mt-3.5 max-w-prose border-l-2 border-gold pl-3.5 text-[1.0625rem] leading-relaxed text-pretty">
            {candidate.reason ?? candidate.note}
          </p>
        )
      }

      {
        /*
          v1 has no right-of-reply process, so a claim that names an identifiable
          individual and did not go through the panel is not on this site at all
          — not the proposition, not the words it was said in. The reason above
          is written to stand on its own in their place. The note says so plainly
          rather than leaving a reader to wonder what was cut.
        */
        candidate.withheld && (
          <p class="mt-4 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
            This claim names an identifiable person. We have no way to put an allegation to someone
            and publish their answer, so we do not repeat one we have not checked: neither the claim
            itself nor the comments it was made in appear here. The register holds them; the site
            does not.
          </p>
        )
      }

      {
        variation && (
          <p class="mt-4 max-w-prose text-[1.0625rem] leading-relaxed" data-crossref>
            The same claim as <a href={variation.href} class="link">{variation.id}</a>, in different
            words. It is checked there, so it is not checked twice.
          </p>
        )
      }

      {
        candidate.story && (
          <p class="mt-4 text-sm" data-crossref>
            <a href={`/facts/${candidate.story}`} class="link">
              {storyLinkLabel(candidate)}
            </a>
          </p>
        )
      }

      {
        candidate.seats && candidate.seats.length > 0 && (
          <p class={`mt-4 ${label}`} data-record>
            {`Found by ${candidate.seats.join(', ')}`}
          </p>
        )
      }
    </section>

    {
      source && (
        <section id="source" class="mt-14 scroll-mt-6">
          <h2 class="section-heading">Where it came from</h2>
          <p class="mt-3 max-w-prose text-[1.0625rem] leading-relaxed text-pretty">
            Taken from{' '}
            <a href={`/considered#${source.id}`} class="link">
              {source.title}
            </a>
            , read end to end. Every factual claim in it was extracted and merged, so this one is
            listed whatever became of it.
          </p>
          <p class={`mt-3 ${label}`} data-record>
            {sourceKind(source)}
            {' · captured '}
            <time datetime={source.captured}>{source.captured}</time>
            {source.comments !== undefined && ` · ${source.comments} comments`}
          </p>
          <p class="mt-3 text-sm" data-crossref>
            <a href={source.url} class="link" rel="noopener nofollow">
              The original post
            </a>
          </p>
        </section>
      )
    }

    {
      forms.length > 0 && (
        <section id="forms" class="mt-14 scroll-mt-6">
          <h2 class="section-heading">How it was said</h2>
          <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-muted">
            Every wording of this claim found in the source, quoted exactly. The names are
            pseudonyms, one to a person within the source; the number is the comment's place in the
            captured thread.
          </p>
          <ul class="mt-5 space-y-4">
            {forms.map((form) => (
              <li>
                <blockquote
                  class="max-w-prose border-l-2 border-gold pl-4 text-[1.0625rem] leading-relaxed text-pretty"
                  data-record
                >
                  {form.quote}
                </blockquote>
                <p class={`mt-1.5 pl-4 ${label}`} data-record>
                  <span class="normal-case tracking-normal">{form.commenter}</span>
                  {` · comment ${form.comment}`}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      rendered.map(({ id, label: heading, reader, run, Content }) => (
        <section id={id} class="mt-14 scroll-mt-6">
          <h2 class="section-heading">{heading}</h2>
          {/*
            The triage is somebody else's reading, and it has to be unmistakable
            which. A byline naming the model read as if the model had reviewed
            the site's work, and left the report's judgements available to be
            taken for the site's own. The notice says both things instead: whose
            reading this is, and that the decision above is ours. The intake
            record needs none of it — that one is Stew's.
          */}
          {id === 'triage' && (
            <aside
              class="mt-4 border-t-2 border-b border-t-gold border-b-rule bg-wash px-4 py-3.5"
              role="note"
            >
              <p class="text-sm leading-relaxed text-forest">
                What follows is the triage read, written by a model from another vendor and
                published as written. The site's decision is the outcome above.
              </p>
              {(reader || run) && (
                <p class="mt-1 text-xs text-muted" data-record>
                  {reader}
                  {reader && run && ' · '}
                  {run && (
                    <>
                      run <time datetime={run}>{run}</time>
                    </>
                  )}
                </p>
              )}
            </aside>
          )}
          {/*
            `data-record` for the same reason the register's meta line carries
            it: this is a stored record rendered verbatim, not the site writing
            prose. One triage report covers three candidates, so its words
            legitimately appear on three pages.
          */}
          <div class="prose mt-4" data-record>
            <Content />
          </div>
        </section>
      ))
    }

    <footer class="mt-14 border-t border-rule pt-5">
      {/*
        Each source names the record it is: the site footer already carries a
        "Source on GitHub" pointing at the repository, and a page with both an
        intake record and a triage report would otherwise offer two links with
        the same words and different destinations.
      */}
      <p class="flex flex-wrap gap-x-5 gap-y-1 text-sm" data-crossref>
        <a href="/considered" class="link">Every claim we've considered</a>
        {
          reports.map((report) => (
            <a href={repoFile(report.path)} rel="noopener" class="link">
              {report.label} on GitHub
            </a>
          ))
        }
      </p>
    </footer>
  </article>
</Base>
