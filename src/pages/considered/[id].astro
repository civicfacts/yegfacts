---
import { getEntry, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ClaimEntry from '../../components/ClaimEntry.astro';
import QuestionEntry from '../../components/QuestionEntry.astro';
import { allPublishedStories } from '../../lib/content';
import {
  claimText,
  claimsOf,
  claimsWithPages,
  questionRegister,
  reportAnchor,
  reportsFor,
  sourceRegister,
  type Claim,
  type Question,
  type Source,
} from '../../lib/intake';
import { toc } from '../../lib/toc';

type Report = CollectionEntry<'candidateReports'>;

/**
 * `/considered/<id>` — one entry in the register, at either level.
 *
 * `/considered` publishes the decisions; this publishes the working. Both
 * levels live under this one route because both are things a reader arrives at
 * from the list: a question is what was asked and where the work has got to,
 * with every claim under it in the words it was said in; a claim is one
 * assertion, its captured wordings, and a line up to its question.
 *
 * The two id spaces share a URL namespace, so the validator refuses a register
 * where a question and a claim have the same id.
 *
 * A claim extracted from a source gets a page even with no report behind it,
 * because it has something a report cannot give: every wording the claim was
 * actually said in, under the pseudonyms the capture uses. That is what lets
 * somebody who commented on the original post find their own words here.
 */
export async function getStaticPaths() {
  /**
   * The intake record and triage report behind a question, where they exist.
   * Declared in here rather than beside the props: Astro hoists
   * `getStaticPaths` into a scope of its own, so a helper outside it is not
   * defined by the time it runs.
   */
  const loadReports = async (question: Question) => {
    const loaded = await Promise.all(
      reportsFor(question).map(async ({ label, path }) => ({
        label,
        path,
        entry: await getEntry('candidateReports', path),
      })),
    );
    return loaded.filter(
      (report): report is { label: string; path: string; entry: Report } =>
        report.entry !== undefined,
    );
  };

  const sources = new Map(sourceRegister().map((source) => [source.id, source]));
  const questions = new Map(questionRegister().map((question) => [question.id, question]));
  const published = new Set((await allPublishedStories()).map((story) => story.id));

  const questionPages = await Promise.all(
    questionRegister().map(async (question) => {
      const claims = claimsOf(question.id);
      const sides = new Set(claims.map((claim) => claim.side));
      return {
        params: { id: question.id },
        props: {
          question,
          claims,
          claim: null,
          twoSided: sides.has('for') && sides.has('against'),
          source: question.source ? (sources.get(question.source) ?? null) : null,
          storyPublished: question.story !== undefined && published.has(question.story),
          reports: await loadReports(question),
        },
      };
    }),
  );

  const claimPages = claimsWithPages().map((claim) => ({
    params: { id: claim.id },
    props: {
      claim,
      question: questions.get(claim.question) ?? null,
      claims: [] as Claim[],
      twoSided: false,
      source: claim.source ? (sources.get(claim.source) ?? null) : null,
      storyPublished: false,
      reports: [] as Array<{ label: string; path: string; entry: Report }>,
    },
  }));

  return [...questionPages, ...claimPages];
}

interface Props {
  question: Question | null;
  /** Set on a claim's page; null on a question's. */
  claim: Claim | null;
  claims: Claim[];
  twoSided: boolean;
  source: Source | null;
  storyPublished: boolean;
  reports: Array<{ label: string; path: string; entry: Report }>;
}

const { question, claim, claims, twoSided, source, storyPublished, reports } = Astro.props;

const isQuestion = claim === null && question !== null;

const sections = isQuestion
  ? toc([
      { id: 'outcome', label: 'Outcome' },
      source && { id: 'source', label: 'Where it came from' },
      claims.length > 0 && { id: 'claims', label: claims.length === 1 ? 'The claim' : 'The claims' },
      ...reports.map((report) => ({ id: reportAnchor(report.label), label: report.label })),
    ])
  : toc([
      { id: 'question', label: 'The question' },
      source && { id: 'source', label: 'Where it came from' },
      (claim?.variations ?? []).length > 0 && { id: 'variations', label: 'How it was said' },
    ]);

const title = isQuestion ? question.question : claimText(claim!);

const description = isQuestion
  ? (question.reason ?? 'A question YEGFacts considered checking, with every claim under it.')
  : (claim!.reason ??
    question?.reason ??
    'A claim YEGFacts considered, with the record behind the decision.');
---

<Base sections={sections} title={title} description={description}>
  {
    isQuestion ? (
      <QuestionEntry
        question={question}
        claims={claims}
        source={source}
        twoSided={twoSided}
        reports={reports}
        storyPublished={storyPublished}
      />
    ) : (
      <ClaimEntry claim={claim!} question={question!} source={source} />
    )
  }
</Base>
