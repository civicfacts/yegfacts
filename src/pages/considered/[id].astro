---
import { getEntry, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ClaimEntry from '../../components/ClaimEntry.astro';
import InvestigationEntry from '../../components/InvestigationEntry.astro';
import { publishedClaims } from '../../lib/content';
import {
  candidatesWithPages,
  claimText,
  claimsOf,
  investigationRegister,
  reportAnchor,
  sourceRegister,
  type Candidate,
  type Investigation,
  type Source,
} from '../../lib/intake';
import { toc } from '../../lib/toc';

type Report = CollectionEntry<'candidateReports'>;

/**
 * `/considered/<id>` — one entry in the register, at either level.
 *
 * `/considered` publishes the decisions; this publishes the working. Both
 * levels of the register live under this one route because both are things a
 * reader arrives at from the list: an investigation is the question and the
 * decision on it, with every claim under it in the words it was said in; a
 * claim is one assertion, its captured wordings, and a line up to the question
 * it is checked under.
 *
 * The two id spaces share a URL namespace, so the validator refuses a register
 * where an investigation and a claim have the same id.
 *
 * A claim extracted from a source gets a page even with no report behind it,
 * because it has something a report cannot give: every wording the claim was
 * actually said in, under the pseudonyms the capture uses. That is what lets
 * somebody who commented on the original post find their own words here.
 */
export async function getStaticPaths() {
  const sources = new Map(sourceRegister().map((source) => [source.id, source]));
  const investigations = new Map(
    investigationRegister().map((investigation) => [investigation.id, investigation]),
  );

  /**
   * Where a `variation_of` points. A published claim lives on its story page;
   * a register entry is either a page of its own or a row on `/considered`.
   */
  const pages = candidatesWithPages();
  const targets = new Map<string, { href: string; label: string }>();
  for (const { candidate } of pages) {
    targets.set(candidate.id, {
      href: `/considered/${candidate.id}`,
      label: 'Read what happened to it',
    });
  }
  for (const { claim, story } of await publishedClaims()) {
    targets.set(claim.data.id, {
      href: `/facts/${story.id}#${claim.data.id}`,
      label: 'Read the check',
    });
  }

  const investigationPages = investigationRegister().map((investigation) => {
    const claims = claimsOf(investigation.id);
    const sides = new Set(claims.map((claim) => claim.side));
    return {
      params: { id: investigation.id },
      props: {
        investigation,
        claims,
        twoSided: sides.has('for') && sides.has('against'),
        source: sources.get(investigation.source) ?? null,
        candidate: null,
        variation: null,
        reports: [] as Array<{ label: string; path: string; entry: Report }>,
      },
    };
  });

  const claimPages = await Promise.all(
    pages.map(async ({ candidate, reports }) => ({
      params: { id: candidate.id },
      props: {
        candidate,
        investigation:
          candidate.investigation === undefined
            ? null
            : (investigations.get(candidate.investigation) ?? null),
        claims: [] as Candidate[],
        twoSided: false,
        source: candidate.source ? (sources.get(candidate.source) ?? null) : null,
        variation: candidate.variation_of
          ? {
              id: candidate.variation_of,
              ...(targets.get(candidate.variation_of) ?? {
                href: `/considered#${candidate.variation_of}`,
                label: 'Read what happened to it',
              }),
            }
          : null,
        reports: (
          await Promise.all(
            reports.map(async ({ label, path }) => ({
              label,
              path,
              entry: await getEntry('candidateReports', path),
            })),
          )
        ).filter(
          (report): report is { label: string; path: string; entry: Report } =>
            report.entry !== undefined,
        ),
      },
    })),
  );

  return [...investigationPages, ...claimPages];
}

interface Props {
  /** Set on an investigation's page; null on a claim's. */
  investigation: Investigation | null;
  /** Set on a claim's page; null on an investigation's. */
  candidate: Candidate | null;
  claims: Candidate[];
  twoSided: boolean;
  source: Source | null;
  variation: { id: string; href: string; label: string } | null;
  reports: Array<{ label: string; path: string; entry: Report }>;
}

const { investigation, candidate, claims, twoSided, source, variation, reports } = Astro.props;

/**
 * An investigation's page is the question and the decision on it; a claim's is
 * the claim, whose own outcome, when it has one, is the heading.
 */
const isInvestigation = candidate === null && investigation !== null;

const sections = isInvestigation
  ? toc([
      { id: 'outcome', label: 'Outcome' },
      source && { id: 'source', label: 'Where it came from' },
      { id: 'claims', label: claims.length === 1 ? 'The claim' : 'The claims' },
    ])
  : toc([
      candidate?.investigation
        ? { id: 'investigation', label: 'The question' }
        : { id: 'outcome', label: 'Outcome' },
      source && { id: 'source', label: 'Where it came from' },
      (candidate?.forms ?? []).length > 0 && { id: 'forms', label: 'How it was said' },
      ...reports.map((report) => ({ id: reportAnchor(report.label), label: report.label })),
    ]);

const title = isInvestigation ? investigation.question : claimText(candidate!);

const description = isInvestigation
  ? (investigation.reason ?? 'A question YEGFacts considered checking, with every claim under it.')
  : (candidate!.reason ??
    investigation?.reason ??
    'A claim YEGFacts considered, with the record behind the decision.');
---

<Base sections={sections} title={title} description={description}>
  {
    isInvestigation ? (
      <InvestigationEntry
        investigation={investigation}
        claims={claims}
        source={source}
        twoSided={twoSided}
      />
    ) : (
      <ClaimEntry
        candidate={candidate!}
        investigation={investigation}
        source={source}
        variation={variation}
        reports={reports}
      />
    )
  }
</Base>
