---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AiReview from '../../components/AiReview.astro';
import CopyButton from '../../components/CopyButton.astro';
import Finding from '../../components/Finding.astro';
import PendingBanner from '../../components/PendingBanner.astro';
import SeenCards from '../../components/SeenCards.astro';
import TopicTags from '../../components/TopicTags.astro';
import { FINDING_GLOSS, PANEL_AGREEMENT_GLOSS } from '../../lib/findings';
import { SITE } from '../../lib/site';
import { toc } from '../../lib/toc';
import {
  claimTopics,
  claimsForStory,
  commitmentsForStory,
  evidenceForStory,
  publicStories,
  type Claim,
  type Commitment,
  type Evidence,
  type Story,
} from '../../lib/content';

/**
 * `/facts/<slug>`. Paths come from `publicStories()`, so a `draft` story has no
 * page — which also keeps it out of Pagefind and out of every internal link.
 */
export async function getStaticPaths() {
  const stories = await publicStories();
  return Promise.all(
    stories.map(async (story) => ({
      params: { slug: story.id },
      props: {
        story,
        claims: await claimsForStory(story),
        commitments: await commitmentsForStory(story),
      },
    })),
  );
}

interface Props {
  story: Story;
  claims: Claim[];
  commitments: Commitment[];
}

const { story, claims, commitments } = Astro.props;
const { Content } = await render(story);

const evidence: Evidence[] = await evidenceForStory(claims, commitments);
const pageUrl = new URL(`/facts/${story.id}`, Astro.site ?? SITE.url).href;

/**
 * Comparable cities, grouped under the claim they were offered for.
 *
 * They used to be one flat list with each card carrying a back-link naming its
 * claim, which on a single-claim story printed the same twenty-word question
 * five times running. Grouped, the question is stated once per group — and on a
 * story with only one claim, not at all, because there is nothing to
 * disambiguate.
 */
const comparisonGroups = claims
  .filter((claim) => claim.data.comparisons.length > 0)
  .map((claim) => ({ claim, comparisons: claim.data.comparisons }));

const comparisons = comparisonGroups.flatMap((group) => group.comparisons);
const unknowns = claims.flatMap((claim) =>
  claim.data.unknowns.map((text) => ({ claim, text })),
);
const missing = claims.flatMap((claim) =>
  claim.data.missing_evidence.map((text) => ({ claim, text })),
);

/**
 * The methodology version(s) the claims on this page were produced under. Kept
 * per-claim rather than per-story because a story revised across a version bump
 * legitimately carries claims from two versions, and flattening that would hide
 * it.
 */
const methodologyVersions = [...new Set(claims.map((claim) => claim.data.methodology_version))];

const heading = 'mt-14 text-xl font-extrabold tracking-[-0.015em] text-forest';

/**
 * Each fixed gloss is printed the first time its value appears on the page and
 * not again.
 *
 * The wording is invariant by design — one sentence per finding (methodology
 * v1.2) and one per agreement value (v1.3), so it cannot be tuned per claim to
 * lean an interpretation. That is exactly why repeating it under a second claim
 * with the same value adds nothing: a reader who has met "Unanimous" once on
 * this page has already read what it means, and on a three-claim story the same
 * sentence was landing three and four times.
 */
const glossed = (() => {
  const finding = new Set<string>();
  const agreement = new Set<string>();
  return claims.map((claim) => {
    const row = {
      claim,
      findingGloss: finding.has(claim.data.finding)
        ? undefined
        : FINDING_GLOSS[claim.data.finding],
      agreementGloss: agreement.has(claim.data.panel_agreement)
        ? undefined
        : PANEL_AGREEMENT_GLOSS[claim.data.panel_agreement],
    };
    finding.add(claim.data.finding);
    agreement.add(claim.data.panel_agreement);
    return row;
  });
})();

/**
 * The outline, in render order. Every entry is conditioned on the same thing
 * its section is, so the rail can never link to a section this story does not
 * have.
 */
const sections = toc([
  story.data.short_answer ? { id: 'short-answer', label: 'Short answer' } : false,
  story.data.tldr.length > 0 && { id: 'tldr', label: 'TL;DR' },
  story.data.seen.length > 0 && { id: 'claims-we-are-seeing', label: 'Common forms' },
  { id: 'what-happened', label: 'What actually happened' },
  { id: 'claims-checked', label: 'Claims checked' },
  commitments.length > 0 && { id: 'commitments', label: 'What the City promised' },
  { id: 'evidence', label: 'Edmonton evidence' },
  comparisons.length > 0 && { id: 'comparisons', label: 'Comparable cities' },
  unknowns.length > 0 && { id: 'unknown', label: 'What remains unknown' },
  missing.length > 0 && { id: 'missing-evidence', label: 'Missing evidence' },
  { id: 'ai-review', label: 'AI review' },
  { id: 'history', label: 'Article history' },
]);
---

<Base title={story.data.title} description={story.data.one_line} sections={sections}>
  {story.data.status === 'pending-review' && <PendingBanner />}

  <article>
    <header class="border-b border-rule pb-6">
      <TopicTags topics={story.data.topics} />
      <h1 class="mt-3 text-[1.75rem] leading-[1.15] font-extrabold tracking-[-0.022em] sm:text-display">
        {story.data.title}
      </h1>

      {/* One-line summary */}
      <div class="mt-4 flex items-start gap-3">
        <p class="grow border-l-2 border-gold pl-3.5 text-lg leading-relaxed text-forest">
          {story.data.one_line}
        </p>
        <CopyButton text={story.data.one_line} url={pageUrl} label="Copy" />
      </div>

      <p class="mt-5 text-xs text-muted">
        As of <time datetime={story.data.as_of}>{story.data.as_of}</time> · last verified{' '}
        <time datetime={story.data.last_verified}>{story.data.last_verified}</time> · next review by{' '}
        <time datetime={story.data.review_by}>{story.data.review_by}</time>
        {
          methodologyVersions.length > 0 && (
            <>
              {' '}·{' '}
              <a href="/methodology/changes" class="underline">
                Methodology v{methodologyVersions.join(', v')}
              </a>
            </>
          )
        }
      </p>
    </header>

    {/* Short answer */}
    {
      story.data.short_answer && (
        <section id="short-answer" class="mt-10">
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="text-xs font-semibold tracking-[0.09em] text-muted uppercase">
              Short answer
            </h2>
            <CopyButton
              text={story.data.short_answer}
              url={`${pageUrl}#short-answer`}
              label="Copy"
            />
          </div>
          <p class="mt-2.5 text-[1.0625rem] leading-relaxed">{story.data.short_answer}</p>
        </section>
      )
    }

    {/* TL;DR */}
    {
      story.data.tldr.length > 0 && (
        <section id="tldr" class="mt-10">
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="text-xs font-semibold tracking-[0.09em] text-muted uppercase">TL;DR</h2>
            <CopyButton
              text={story.data.tldr.map((line) => `• ${line}`).join('\n')}
              url={`${pageUrl}#tldr`}
              label="Copy"
            />
          </div>
          <ul class="mt-2.5 space-y-2">
            {story.data.tldr.map((line) => (
              <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">{line}</li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Common forms of the claim */}
    <SeenCards seen={story.data.seen} />

    {/* What actually happened */}
    <section id="what-happened">
      <h2 class={heading}>What actually happened</h2>
      <div class="prose mt-4">
        <Content />
      </div>
    </section>

    {/* Claims checked */}
    <section id="claims-checked">
      <h2 class={heading}>Claims checked</h2>
      {
        claims.length === 0 ? (
          <p class="mt-4 border-l-2 border-rule-strong pl-3.5 text-sm text-muted">
            No claims from this story have completed the review panel yet.
          </p>
        ) : (
          <div class="mt-4 space-y-8">
            {glossed.map(({ claim, findingGloss, agreementGloss }) => (
              <div id={claim.data.id} class="scroll-mt-6 border-t border-rule-strong pt-5">
                <h3 class="text-lg font-semibold tracking-[-0.012em]">
                  {claim.data.question}
                  {story.data.primary_claim === claim.data.id && (
                    <span class="ml-2 align-middle text-[0.6875rem] tracking-[0.08em] text-gold uppercase">
                      Main claim
                    </span>
                  )}
                </h3>

                <dl class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-[8rem_1fr]">
                  <dt class="text-xs font-semibold tracking-[0.08em] text-muted uppercase">
                    Finding
                  </dt>
                  <dd>
                    <Finding finding={claim.data.finding} size="lg" />
                    {findingGloss && (
                      <p class="mt-1 text-sm leading-relaxed text-muted">{findingGloss}</p>
                    )}
                  </dd>

                  <dt class="text-xs font-semibold tracking-[0.08em] text-muted uppercase">
                    Evidence basis
                  </dt>
                  <dd class="text-[0.9375rem] leading-relaxed">{claim.data.evidence_basis}</dd>

                  <dt class="text-xs font-semibold tracking-[0.08em] text-muted uppercase">
                    Panel agreement
                  </dt>
                  <dd>
                    <span class="text-[0.9375rem]">{claim.data.panel_agreement}</span>
                    {agreementGloss && (
                      <p class="mt-1 text-sm leading-relaxed text-muted">{agreementGloss}</p>
                    )}
                  </dd>
                </dl>

                {claim.data.key_facts.length > 0 && (
                  <ul class="mt-4 space-y-2">
                    {claim.data.key_facts.map((fact) => (
                      <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">
                        {fact.text}{' '}
                        {fact.sources.map((source, index) => (
                          <>
                            {index > 0 && ', '}
                            <a href={`/evidence/${source}`} class="text-navy underline">
                              {source}
                            </a>
                          </>
                        ))}
                      </li>
                    ))}
                  </ul>
                )}

                {claim.data.limitations.length > 0 && (
                  <div class="mt-4">
                    <h4 class="text-xs font-semibold tracking-[0.08em] text-muted uppercase">
                      Limitations
                    </h4>
                    <ul class="mt-1.5 space-y-1 text-sm text-muted">
                      {claim.data.limitations.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}

                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
                  <TopicTags topics={claimTopics(claim, story)} />
                  <span data-pagefind-filter={`finding:${claim.data.finding}`} class="sr-only">
                    {claim.data.finding}
                  </span>
                  <CopyButton
                    text={`${claim.data.question} — ${claim.data.finding} (${claim.data.panel_agreement} panel). YEGFacts.ca`}
                    url={`${pageUrl}#${claim.data.id}`}
                    label="Copy citation"
                  />
                </div>
              </div>
            ))}
          </div>
        )
      }
    </section>

    {/* What the City promised */}
    {
      commitments.length > 0 && (
        <section id="commitments">
          <h2 class={heading}>What the City promised</h2>
          <ul class="mt-4 divide-y divide-rule border-t border-rule">
            {commitments.map((commitment) => (
              <li class="py-4">
                <p class="text-[0.9375rem] leading-relaxed">{commitment.data.statement}</p>
                <p class="mt-1.5 text-xs text-muted">
                  {commitment.data.promised_by} ·{' '}
                  <time datetime={commitment.data.promised_on}>{commitment.data.promised_on}</time>{' '}
                  · {commitment.data.status} ·{' '}
                  <a href={`/evidence/${commitment.data.source}`} class="text-navy underline">
                    {commitment.data.source}
                  </a>
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Edmonton evidence */}
    <section id="evidence">
      <h2 class={heading}>Edmonton evidence</h2>
      {
        evidence.length === 0 ? (
          <p class="mt-4 border-l-2 border-rule-strong pl-3.5 text-sm text-muted">
            No evidence objects are registered for this story yet.
          </p>
        ) : (
          <ul class="mt-4 divide-y divide-rule border-t border-rule">
            {evidence.map((entry) => (
              <li class="py-4">
                <a href={`/evidence/${entry.data.id}`} class="font-semibold hover:text-forest">
                  {entry.data.title}
                </a>
                <p class="mt-1 text-xs text-muted" data-record>
                  {entry.data.publisher} · retrieved{' '}
                  <time datetime={entry.data.retrieved_on}>{entry.data.retrieved_on}</time> ·{' '}
                  {entry.data.id}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {/* Comparable-city evidence with transferability */}
    {
      comparisons.length > 0 && (
        <section id="comparisons">
          <h2 class={heading}>Comparable cities</h2>
          {comparisonGroups.map((group) => (
            <div class="mt-4">
              {comparisonGroups.length > 1 && (
                /* data-crossref: the group heading names the claim it belongs to. */
                <p class="text-xs text-muted" data-crossref>
                  On{' '}
                  <a href={`#${group.claim.data.id}`} class="underline">
                    {group.claim.data.question}
                  </a>
                </p>
              )}
              <ul class="mt-2 divide-y divide-rule border-t border-rule">
                {group.comparisons.map((comparison) => (
                  <li class="py-4">
                    <p class="font-semibold">{comparison.city}</p>
                    <p class="mt-1 text-[0.9375rem] leading-relaxed">{comparison.note}</p>
                    <p class="mt-1.5 text-sm text-muted">
                      <span class="font-semibold">Transfers to Edmonton?</span>{' '}
                      {comparison.transferability}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    {/* What remains unknown */}
    {
      unknowns.length > 0 && (
        <section id="unknown">
          <h2 class={heading}>What remains unknown</h2>
          <ul class="mt-4 space-y-2">
            {unknowns.map(({ text }) => (
              <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">{text}</li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Missing evidence */}
    {
      missing.length > 0 && (
        <section id="missing-evidence">
          <h2 class={heading}>Missing evidence</h2>
          <p class="mt-1.5 text-sm text-muted">
            Records we asked for and have not received, or that do not appear to exist publicly.
          </p>
          <ul class="mt-3 space-y-2">
            {missing.map(({ text }) => (
              <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">{text}</li>
            ))}
          </ul>
        </section>
      )
    }

    {/* AI review */}
    <AiReview story={story} claims={claims} />

    {/* Article history */}
    <section id="history">
      <h2 class={heading}>Article history</h2>
      {
        story.data.changelog.length > 0 ? (
          <ul class="mt-4 divide-y divide-rule border-t border-rule">
            {[...story.data.changelog]
              .sort((a, b) => b.date.localeCompare(a.date))
              .map((entry) => (
                <li class="flex flex-wrap gap-x-3 py-2.5 text-sm">
                  <time datetime={entry.date} class="text-muted">
                    {entry.date}
                  </time>
                  <span class="font-semibold text-forest">{entry.type}</span>
                  <span class="basis-full text-ink sm:basis-auto">{entry.note}</span>
                </li>
              ))}
          </ul>
        ) : (
          <p class="mt-4 border-l-2 border-rule-strong pl-3.5 text-sm text-muted">
            No history yet — this story has not been published or revised.
          </p>
        )
      }
      <p class="mt-3 text-xs text-muted">
        Every revision is in the{' '}
        <a
          href={`${SITE.repo}/commits/main/src/content/stories/${story.id}.mdx`}
          rel="noopener"
          class="text-navy underline"
        >
          public commit history of this file
        </a>.
      </p>
    </section>
  </article>
</Base>
