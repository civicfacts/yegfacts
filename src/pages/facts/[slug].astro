---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AiReview from '../../components/AiReview.astro';
import AlsoSaidAs from '../../components/AlsoSaidAs.astro';
import CopyButton from '../../components/CopyButton.astro';
import Finding from '../../components/Finding.astro';
import Gloss from '../../components/Gloss.astro';
import PendingBanner from '../../components/PendingBanner.astro';
import SeenCards from '../../components/SeenCards.astro';
import TopicTags from '../../components/TopicTags.astro';
import { requireTerm as gloss } from '../../lib/glossary';
import { SITE } from '../../lib/site';
import { subheads, toc } from '../../lib/toc';
import {
  claimTopics,
  claimsForStory,
  commitmentsForStory,
  evidenceForStory,
  firstPublished,
  allPublicStories,
  type Claim,
  type Commitment,
  type Evidence,
  type Story,
} from '../../lib/content';

/**
 * `/facts/<slug>`. Paths come from `allPublicStories()`, so a `draft` story has no
 * page — which also keeps it out of Pagefind and out of every internal link.
 */
export async function getStaticPaths() {
  const stories = await allPublicStories();
  return Promise.all(
    stories.map(async (story) => ({
      params: { slug: story.id },
      props: {
        story,
        claims: await claimsForStory(story),
        commitments: await commitmentsForStory(story),
      },
    })),
  );
}

interface Props {
  story: Story;
  claims: Claim[];
  commitments: Commitment[];
}

const { story, claims, commitments } = Astro.props;
const { Content, headings } = await render(story);

const evidence: Evidence[] = await evidenceForStory(claims, commitments);
const pageUrl = new URL(`/facts/${story.id}`, Astro.site ?? SITE.url).href;

/**
 * Comparable cities, grouped under the claim they were offered for.
 *
 * They used to be one flat list with each card carrying a back-link naming its
 * claim, which on a single-claim story printed the same twenty-word question
 * five times running. Grouped, the question is stated once per group — and on a
 * story with only one claim, not at all, because there is nothing to
 * disambiguate.
 */
const comparisonGroups = claims
  .filter((claim) => claim.data.comparisons.length > 0)
  .map((claim) => ({ claim, comparisons: claim.data.comparisons }));

const comparisons = comparisonGroups.flatMap((group) => group.comparisons);
const unknowns = claims.flatMap((claim) =>
  claim.data.unknowns.map((text) => ({ claim, text })),
);
const missing = claims.flatMap((claim) =>
  claim.data.missing_evidence.map((text) => ({ claim, text })),
);

/**
 * The methodology version(s) the claims on this page were produced under. Kept
 * per-claim rather than per-story because a story revised across a version bump
 * legitimately carries claims from two versions, and flattening that would hide
 * it.
 */
const methodologyVersions = [...new Set(claims.map((claim) => claim.data.methodology_version))];

const heading = 'section-heading mt-14';

/*
 * Every method word on this page — the five findings, the three agreement
 * values, "evidence basis", the three dates — is defined once in the glossary
 * and shown in a popover on demand (`gloss`). That replaced the fixed gloss
 * paragraphs that used to sit under every claim.
 */

/**
 * The outline, in render order. Every entry is conditioned on the same thing
 * its section is, so the rail can never link to a section this story does not
 * have.
 */
const sections = toc([
  story.data.tldr.length > 0 && { id: 'tldr', label: 'TL;DR' },
  story.data.seen.length > 0 && { id: 'claims-we-are-seeing', label: 'Common forms' },
  {
    id: 'what-happened',
    label: 'What actually happened',
    children: subheads(headings),
  },
  { id: 'claims-checked', label: 'Claims checked' },
  commitments.length > 0 && { id: 'commitments', label: 'What the City promised' },
  { id: 'evidence', label: 'Edmonton evidence' },
  comparisons.length > 0 && { id: 'comparisons', label: 'Comparable cities' },
  unknowns.length > 0 && { id: 'unknown', label: 'What remains unknown' },
  missing.length > 0 && { id: 'missing-evidence', label: 'Missing evidence' },
  { id: 'ai-review', label: 'AI review' },
  { id: 'history', label: 'Article history' },
]);

const mainClaim = 'ml-2 align-middle text-[0.6875rem] tracking-[0.08em] text-forest uppercase';

const withdrawn = story.data.withdrawn;

const published = firstPublished(story);

/**
 * One `ClaimReview` per claim, offered only for a story that is both through
 * the panel and still standing as a finding: a `pending-review` story has no
 * verdict yet, and a withdrawn one has stopped asserting the ones it had.
 *
 * Two omissions are deliberate. There is no numeric `ratingValue` — the
 * comment on `PANEL_AGREEMENT_LEVELS` in `src/lib/vocabulary.ts` is the reason:
 * the method never computes a probability that a claim is true, and a number
 * here would publish one. And there is no `itemReviewed`: the "Common forms"
 * cards are composite paraphrases we wrote, with no author to name and a
 * `source_url` the page deliberately does not render.
 */
const claimReviews =
  story.data.status === 'published' && !withdrawn
    ? claims.map((claim) => ({
        '@context': 'https://schema.org',
        '@type': 'ClaimReview',
        url: `${pageUrl}#${claim.data.id}`,
        claimReviewed: claim.data.question,
        datePublished: published,
        dateModified: story.data.last_verified,
        author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
        reviewRating: { '@type': 'Rating', alternateName: claim.data.finding },
      }))
    : undefined;
---

{/*
  A withdrawn story keeps its page and loses its standing, so it also loses its
  place in the search index: `indexable` is what puts `data-pagefind-body` on
  `<main>`, and a page without it is the repo's one way of staying built but
  unindexed. A reader can still reach it from `/considered` and from its own
  URL, which is the whole point of keeping it.
*/}
<Base
  title={story.data.title}
  description={story.data.one_line}
  sections={sections}
  indexable={!withdrawn}
  jsonLd={claimReviews}
  article={{ published, modified: story.data.last_verified }}
>
  {story.data.status === 'pending-review' && <PendingBanner />}
  {
    withdrawn && (
      <aside
        class="mb-8 border-t-2 border-b border-t-gold border-b-rule bg-wash px-4 py-3.5"
        role="note"
      >
        <p class="text-sm font-semibold text-forest">
          No longer a finding · <time datetime={withdrawn.date}>{withdrawn.date}</time>
        </p>
        <p class="mt-1 text-sm leading-relaxed text-muted">
          This story is no longer a finding. {withdrawn.reason} It stays here for the record; its
          claims are listed with{' '}
          <a href={`/considered#${withdrawn.register}`} class="link">
            every claim we've considered
          </a>
          .
        </p>
      </aside>
    )
  }

  <article>
    <header class="border-b border-rule pb-7">
      {/*
        The kicker names the genre before the topics name the subject: a reader
        arriving from a search result should know this is a fact check without
        reading the title first. Plain text, not a link and not a badge — the
        topics beside it are the only things here worth touching.
      */}
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs text-muted">
        <span>Fact check ·</span>
        <TopicTags topics={story.data.topics} />
      </div>
      <h1
        class="mt-3 text-[1.75rem] leading-[1.15] font-extrabold tracking-[-0.022em] text-balance sm:text-display"
      >
        {story.data.title}
      </h1>

      {/*
        The verdict strip. The findings used to arrive at section four, below a
        summary, a TL;DR, the rumour cards and a thousand words of narrative —
        two or three screens on a phone before the page did the one thing it
        exists to do. Now every claim and its finding sit directly under the
        title, each row linking down to the check that produced it.

        The question links; the finding word is its own control, because the
        word opens the definition of what the word means. One row, two things
        to touch, and neither is nested inside the other.

        data-crossref: each question names the section it points at, so the
        duplication audit reads it as a reference rather than the page saying
        the same sentence twice.
      */}
      {
        claims.length > 0 && (
          <ul class="mt-6 divide-y divide-rule border-y border-rule">
            {claims.map((claim) => (
              <li class="grid gap-x-8 gap-y-1.5 py-4 sm:grid-cols-[minmax(0,30rem)_1fr] sm:items-baseline">
                {/* Question leads at heading weight; the verdict answers it at lower weight (home page rule, D-0018). */}
                <p class="text-lg leading-snug font-bold text-pretty" data-crossref>
                  <a href={`#${claim.data.id}`} class="link">
                    {claim.data.question}
                  </a>
                  {story.data.primary_claim === claim.data.id && (
                    <span class={mainClaim}>Main claim</span>
                  )}
                </p>
                {/* Left-aligned in a fixed column, so the leading rules stack. */}
                <div>
                  <Gloss {...gloss(claim.data.finding)} variant="boxed">
                    <Finding finding={claim.data.finding} size="md" />
                  </Gloss>
                </div>
              </li>
            ))}
          </ul>
        )
      }

      {/*
        One-line summary: one sentence, thirty words, enforced by the validator.
        On a phone the Copy control drops under the sentence rather than beside
        it — sharing a 350px row with the answer squeezed the answer.
      */}
      <div class="mt-6 flex flex-col items-start gap-2.5 sm:flex-row sm:gap-3">
        <p class="grow border-l-2 border-gold pl-3.5 text-lg leading-relaxed text-forest text-pretty">
          {story.data.one_line}
        </p>
        <CopyButton text={story.data.one_line} url={pageUrl} label="Copy" />
      </div>

      {/*
        Provenance, then dates. The line used to open with the dates alone,
        which answered "how old is this?" and left "who decided this?" to a
        reader who scrolled far enough to reach the AI review. Naming the panel
        and the rule here — both glossed, both linking into the methodology —
        puts the answer where the finding is.
      */}
      <p class="mt-5 text-xs text-muted">
        Verdicts by a{' '}
        <Gloss {...gloss('three-model AI panel')}>three-model AI panel</Gloss> under a{' '}
        <Gloss {...gloss('published rule')}>published rule</Gloss> ·{' '}
        <Gloss {...gloss('as of')}>as of</Gloss>{' '}
        <time datetime={story.data.as_of}>{story.data.as_of}</time> ·{' '}
        <Gloss {...gloss('last verified')}>last verified</Gloss>{' '}
        <time datetime={story.data.last_verified}>{story.data.last_verified}</time> ·{' '}
        <Gloss {...gloss('next review by')}>next review by</Gloss>{' '}
        <time datetime={story.data.review_by}>{story.data.review_by}</time>
        {
          methodologyVersions.length > 0 && (
            <>
              {' '}·{' '}
              <Gloss {...gloss('methodology version')} hrefLabel="See what changed">
                methodology v{methodologyVersions.join(', v')}
              </Gloss>
            </>
          )
        }
      </p>
    </header>

    {/*
      The TL;DR follows the one-sentence answer directly, because it is the
      next layer of the same answer: one_line → tldr → body. It used to sit
      below the rumour cards, which put what people say ahead of the second
      pass at what is true.
    */}
    {/* TL;DR */}
    {
      story.data.tldr.length > 0 && (
        <section id="tldr" class="mt-14">
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="section-heading">TL;DR</h2>
            <CopyButton
              text={story.data.tldr.map((line) => `• ${line}`).join('\n')}
              url={`${pageUrl}#tldr`}
              label="Copy"
            />
          </div>
          <ul class="mt-3.5 space-y-2">
            {story.data.tldr.map((line) => (
              <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">{line}</li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Common forms of the claim — what people say, before what is true. */}
    <SeenCards seen={story.data.seen} />

    {/* What actually happened */}
    <section id="what-happened">
      <h2 class={heading}>What actually happened</h2>
      <div class="prose mt-4">
        <Content />
      </div>
    </section>

    {/* Claims checked */}
    <section id="claims-checked">
      <h2 class={heading}>Claims checked</h2>
      {
        claims.length === 0 ? (
          <p class="mt-4 border-l-2 border-rule-strong pl-3.5 text-sm text-muted">
            No claims from this story have completed the review panel yet.
          </p>
        ) : (
          <div class="mt-4 space-y-8">
            {claims.map((claim) => (
              <div id={claim.data.id} class="scroll-mt-6 border-t border-rule-strong pt-5">
                <h3 class="text-lg font-semibold tracking-[-0.012em] text-pretty">
                  {claim.data.question}
                  {story.data.primary_claim === claim.data.id && (
                    <span class={mainClaim}>Main claim</span>
                  )}
                </h3>

                {/* The verdict, then the panel behind it, then what it rests on. */}
                <p class="mt-3.5 flex flex-wrap items-baseline gap-x-2 gap-y-1.5">
                  <Gloss {...gloss(claim.data.finding)} variant="boxed">
                    <Finding finding={claim.data.finding} size="md" />
                  </Gloss>
                  <span class="text-[0.9375rem] text-muted">
                    · <Gloss {...gloss(claim.data.panel_agreement)}>
                      {claim.data.panel_agreement}
                    </Gloss>{' '}
                    panel
                  </span>
                </p>

                <p class="mt-2.5 text-sm leading-relaxed text-muted">
                  <Gloss {...gloss('evidence basis')}>Evidence basis</Gloss>:{' '}
                  {claim.data.evidence_basis}
                </p>

                {/*
                  Four facts, then the rest behind a native disclosure. A claim
                  carrying eight or ten facts pushed the next claim off the
                  phone screen; every fact still renders into the HTML, so
                  Pagefind and the duplication audit read the whole list.
                */}
                {claim.data.key_facts.length > 0 && (
                  <ul class="mt-4 space-y-2">
                    {claim.data.key_facts.slice(0, 4).map((fact) => (
                      <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">
                        {fact.text}{' '}
                        {fact.sources.map((source, index) => (
                          <>
                            {index > 0 && ', '}
                            <a href={`/evidence/${source}`} class="link">
                              {source}
                            </a>
                          </>
                        ))}
                      </li>
                    ))}
                  </ul>
                )}

                {claim.data.key_facts.length > 4 && (
                  <details class="mt-2">
                    <summary class="link inline-flex min-h-10 cursor-pointer list-none items-center text-sm">
                      {claim.data.key_facts.length - 4} more
                      {claim.data.key_facts.length - 4 === 1 ? ' fact' : ' facts'}
                    </summary>
                    <ul class="space-y-2 pb-1">
                      {claim.data.key_facts.slice(4).map((fact) => (
                        <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">
                          {fact.text}{' '}
                          {fact.sources.map((source, index) => (
                            <>
                              {index > 0 && ', '}
                              <a href={`/evidence/${source}`} class="link">
                                {source}
                              </a>
                            </>
                          ))}
                        </li>
                      ))}
                    </ul>
                  </details>
                )}

                {/*
                  The wordings this claim was actually said in, gathered from
                  the register entries merged into it. Under the facts, because
                  the check is what the page is for; on the page, because a
                  person who said it should be able to find their own words
                  beside the answer.
                */}
                <AlsoSaidAs registerClaims={claim.data.register_claims} />

                {claim.data.limitations.length > 0 && (
                  <div class="mt-4">
                    <h4 class="text-xs font-semibold tracking-[0.08em] text-muted uppercase">
                      Limitations
                    </h4>
                    <ul class="mt-1.5 space-y-1 text-sm text-muted">
                      {claim.data.limitations.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}

                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
                  <TopicTags topics={claimTopics(claim, story)} />
                  <span data-pagefind-filter={`finding:${claim.data.finding}`} class="sr-only">
                    {claim.data.finding}
                  </span>
                  <CopyButton
                    text={`${claim.data.question} — ${claim.data.finding} (${claim.data.panel_agreement} panel). YEGFacts.ca`}
                    url={`${pageUrl}#${claim.data.id}`}
                    label="Copy citation"
                  />
                </div>
              </div>
            ))}
          </div>
        )
      }
    </section>

    {/* What the City promised */}
    {
      commitments.length > 0 && (
        <section id="commitments">
          <h2 class={heading}>What the City promised</h2>
          <ul class="mt-4 divide-y divide-rule border-t border-rule">
            {commitments.map((commitment) => (
              <li class="py-4">
                <p class="text-[0.9375rem] leading-relaxed">{commitment.data.statement}</p>
                <p class="mt-1.5 text-xs text-muted">
                  {commitment.data.promised_by} ·{' '}
                  <time datetime={commitment.data.promised_on}>{commitment.data.promised_on}</time>{' '}
                  · {commitment.data.status} ·{' '}
                  <a href={`/evidence/${commitment.data.source}`} class="link">
                    {commitment.data.source}
                  </a>
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Edmonton evidence */}
    <section id="evidence">
      <h2 class={heading}>Edmonton evidence</h2>
      {
        evidence.length === 0 ? (
          <p class="mt-4 border-l-2 border-rule-strong pl-3.5 text-sm text-muted">
            No evidence objects are registered for this story yet.
          </p>
        ) : (
          <ul class="mt-4 divide-y divide-rule border-t border-rule">
            {evidence.map((entry) => (
              <li class="py-4">
                <a href={`/evidence/${entry.data.id}`} class="link font-semibold">
                  {entry.data.title}
                </a>
                <p class="mt-1 text-xs text-muted" data-record>
                  {entry.data.publisher} · retrieved{' '}
                  <time datetime={entry.data.retrieved_on}>{entry.data.retrieved_on}</time> ·{' '}
                  {entry.data.id}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {/* Comparable-city evidence with transferability */}
    {
      comparisons.length > 0 && (
        <section id="comparisons">
          <h2 class={heading}>Comparable cities</h2>
          {comparisonGroups.map((group) => (
            <div class="mt-4">
              {comparisonGroups.length > 1 && (
                /* data-crossref: the group heading names the claim it belongs to. */
                <p class="text-xs text-muted" data-crossref>
                  On{' '}
                  <a href={`#${group.claim.data.id}`} class="link">
                    {group.claim.data.question}
                  </a>
                </p>
              )}
              <ul class="mt-2 divide-y divide-rule border-t border-rule">
                {group.comparisons.map((comparison) => (
                  <li class="py-4">
                    <p class="font-semibold">{comparison.city}</p>
                    <p class="mt-1 text-[0.9375rem] leading-relaxed">{comparison.note}</p>
                    <p class="mt-1.5 text-sm text-muted">
                      <span class="font-semibold">Transfers to Edmonton?</span>{' '}
                      {comparison.transferability}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    {/* What remains unknown */}
    {
      unknowns.length > 0 && (
        <section id="unknown">
          <h2 class={heading}>What remains unknown</h2>
          <ul class="mt-4 space-y-2">
            {unknowns.map(({ text }) => (
              <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">{text}</li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Missing evidence */}
    {
      missing.length > 0 && (
        <section id="missing-evidence">
          <h2 class={heading}>Missing evidence</h2>
          <p class="mt-1.5 text-sm text-muted">
            Records we asked for and have not received, or that do not appear to exist publicly.
          </p>
          <ul class="mt-3 space-y-2">
            {missing.map(({ text }) => (
              <li class="border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed">{text}</li>
            ))}
          </ul>
        </section>
      )
    }

    {/* AI review */}
    <AiReview story={story} claims={claims} />

    {/* Article history */}
    <section id="history">
      <h2 class={heading}>Article history</h2>
      {
        story.data.changelog.length > 0 ? (
          <ul class="mt-4 divide-y divide-rule border-t border-rule">
            {[...story.data.changelog]
              .sort((a, b) => b.date.localeCompare(a.date))
              .map((entry) => (
                <li class="flex flex-wrap gap-x-3 py-2.5 text-sm">
                  <time datetime={entry.date} class="text-muted">
                    {entry.date}
                  </time>
                  <span class="font-semibold text-forest">{entry.type}</span>
                  <span class="basis-full text-ink sm:basis-auto">{entry.note}</span>
                </li>
              ))}
          </ul>
        ) : (
          <p class="mt-4 border-l-2 border-rule-strong pl-3.5 text-sm text-muted">
            No history yet — this story has not been published or revised.
          </p>
        )
      }
      <p class="mt-3 text-xs text-muted">
        Every revision is in the{' '}
        <a
          href={`${SITE.repo}/commits/main/src/content/stories/${story.id}.mdx`}
          rel="noopener"
          class="link"
        >
          public commit history of this file
        </a>.
      </p>
    </section>
  </article>
</Base>
