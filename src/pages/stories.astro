---
import Base from '../layouts/Base.astro';
import StoryList from '../components/StoryList.astro';
import { claimsForStory, publicStories, type Claim } from '../lib/content';

/**
 * Every story on one page. It reads `publicStories()`, the same source the topic
 * hubs use, so a story still in review shows here with its label rather than
 * disappearing until its panel lands.
 */
const stories = await publicStories();

const claimsByStory: Record<string, Claim[]> = {};
for (const story of stories) {
  claimsByStory[story.id] = await claimsForStory(story);
}

/** Counts what the list shows: a story in review is on the page, so it is in the number. */
const claimCount = stories.reduce((count, story) => count + claimsByStory[story.id].length, 0);
const storyCount = stories.length;
---

<Base
  title="Every story"
  description="Every story on YEGFacts, newest first, with the claims checked on each."
>
  <header class="border-b border-rule pb-6">
    <h1 class="text-[1.75rem] leading-[1.15] font-extrabold tracking-[-0.022em] sm:text-display">
      Every story
    </h1>
    <p class="mt-3 max-w-prose text-base leading-relaxed text-muted">
      A story is one page about one argument. Its claims are the questions checked on it, each with
      its own finding.
    </p>
    <p class="mt-3 text-[0.9375rem] text-pretty text-muted tabular">
      {storyCount}
      {storyCount === 1 ? ' story · ' : ' stories · '}
      {claimCount}
      {claimCount === 1 ? ' claim' : ' claims'}, newest verified first
    </p>
  </header>

  <section class="mt-10">
    <StoryList stories={stories} claimsByStory={claimsByStory} headingLevel="h2" />
  </section>
</Base>
