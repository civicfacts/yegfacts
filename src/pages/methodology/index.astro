---
import Base from '../../layouts/Base.astro';
import Finding from '../../components/Finding.astro';
import NumberedSteps, { type Exit } from '../../components/NumberedSteps.astro';
import { PANEL_AGREEMENT_GLOSS } from '../../lib/findings';
import { SITE, repoPath } from '../../lib/site';
import { PANEL_AGREEMENT_LEVELS } from '../../lib/vocabulary';
import { toc } from '../../lib/toc';
import { SYNTHESIS_MATRIX } from '../../../scripts/synthesis-matrix.ts';

/**
 * The short version, and the only part of this page a stranger has to read. It
 * carries the whole method in five steps, in the same numbered idiom as the
 * `intake` and `stages` lists below, so a reader who goes on meets a shape they
 * have already seen. Everything under it is the same method in full.
 *
 * Each step also carries what can happen to a claim there besides going on to
 * the next step. Those outcomes are the honest half of the method and the half
 * a stranger never sees. They live in this array rather than in the template so
 * each stays attached to its step; the critique checks them against the full
 * method below, sentence by sentence.
 */
const short: ReadonlyArray<{ name: string; body: string; exits: readonly Exit[] }> = [
  {
    name: 'Someone sends us a source',
    body: 'A post with all its comments, an article, a thread. We keep the whole thing and list every claim in it that a public record could settle. Commenters get a label instead of their name, unless they hold public office. Every question we found is listed publicly with what was decided about it, including the ones we declined.',
    exits: [
      { kind: 'Stops here', text: 'Two readers can decline a question or park it. Either way the reason is on the register.' },
      { kind: 'Stops here', text: 'An accusation against a named person is written down, then declined.' },
    ],
  },
  {
    name: 'The question is pinned down before anyone looks for answers',
    body: 'A written brief says exactly what the claim means, in words both sides would accept: what counts as lost, whose money, up to what date. A model from a different company checks that the brief is fair to the people making the claim. Then it is frozen, so nobody can move the goalposts once answers start coming in.',
    exits: [
      { kind: 'Loops back', text: 'A brief that fails its fairness check is rewritten before it can be frozen.' },
      { kind: 'Stops here', text: 'After three reports, a brief the check still calls unfair is parked until new evidence arrives.' },
    ],
  },
  {
    name: 'Three AI models research it blind',
    body: "Claude, GPT and Gemini each get the same brief and search the public record on their own, without seeing each other's work. Each comes back with a verdict, the evidence for and against, and what it could not find.",
    exits: [
      { kind: 'Stops here', text: 'A reviewer that returns nothing after its retry halts the run before any finding.' },
      {
        kind: 'Stops here',
        text: 'As of September 15, 2026 no panel has run since September 4. One of the three seats has passed the check on how a model is run; the other two have not, and a finding needs all three.',
        link: { href: '#reviewer-execution', text: 'What the check is, and what it does not show' },
      },
      { kind: 'Loops back', text: "Afterwards the three read each other's work. A fabricated citation caught there sends that claim back for a fresh blind round." },
    ],
  },
  {
    name: 'A table turns three verdicts into one finding',
    body: 'The table was written down in advance and covers every way three verdicts can combine. Nobody votes and nobody picks. When the three do not agree, the finding is never stronger than the most cautious of the three. If one reviewer finds a claim supported and another finds it contradicted, the finding is Mixed, and the split is shown.',
    exits: [
      { kind: 'Continues', text: 'Supported against Contradicted publishes as Mixed, with the split shown.' },
      { kind: 'Stops here', text: 'If a framing concern is right and there is no fair repair, the claim is parked with a public reason.' },
    ],
  },
  {
    name: 'Every fact is checked against a saved copy of its source',
    body: "Before anything is published as a finding, an audit reads the write-up against the archived bytes of the sources it cites, not the live web. The reviewers' answers, their sources and the audit reports are published with it, after a check that removes personal information. Ildar Abdulin is the named person accountable for every word, and he can take any of it down.",
    exits: [
      { kind: 'Fixed before publication', text: 'A statement the archived source does not carry is corrected before the page goes up.' },
      { kind: 'Corrected later', text: 'A finding that changes after publication is logged on its own page as a dated entry. Nothing is quietly edited.' },
    ],
  },
];

/**
 * Stage zero, and the reason the seven stages below can be trusted at all: the
 * claims that reach them were not picked out by anyone. The short version above
 * answers a reader's first question, which is what the site does; this list is
 * the full account of stage zero (methodology v1.15, grouped into questions in
 * v1.16).
 */
const intake = [
  {
    name: 'A source arrives',
    body: 'The unit is a whole source: a post and every comment under it, an article, a discussion someone sends us. Anyone can send one, and you do not have to say which part of it you think is wrong. The accessible material is captured with its address, capture date and known limits, and kept. A capture is not necessarily the complete source.',
  },
  {
    name: 'Every claim in it is written down',
    body: 'Three inexpensive models read that capture separately. Each lists every factual assertion in it: numbers, counts, dates, what somebody says a document said, and the factual premise sitting inside an opinion. They are told not to work out whether any of it is true, and not to decide which parts are interesting. Each one is recorded with the exact words that carry it and the comment those words came from.',
  },
  {
    name: 'The three lists become one',
    body: 'A stronger model folds them into propositions, one for each thing a record could settle, keeping every version of the wording underneath. A script then audits that step. Whatever any of the three wrote down has to appear once in the merged list, or on a dropped list under one of three allowed reasons. If something goes missing, the merge fails and runs again. The failure this exists to catch is a claim quietly disappearing.',
  },
  {
    name: 'The same argument is gathered into one question',
    body: 'One argument arrives as many claims. Checking each on its own would spend a panel run on every one and answer the same question several times over. So claims a single investigation would settle are gathered under one question: the same figure in different units, a general claim and an instance of it, a claim together with the claim that contradicts it. Each still gets its own finding. Take the argument about emergency vehicles. One side says the concrete barriers hold responders up. The other says responders use the lanes to get past queues. That is one question, answered by the same response-time records, and two claims, because one finding across the pair would settle neither and would tar each side with a ruling about the other.',
  },
  {
    name: 'Triage rules on the questions',
    body: 'The questions go to two readers, one pass each, and neither reader sees the other. Each returns GO, PARK or NO on every one, with a reason short enough to show the person who raised it. Where they disagree the question is kept rather than dropped, because throwing out a real question costs a reader more than holding one too long. Only a GO reaches stage 1 below. The rest are listed anyway, with their reasons, and the questions most people are arguing about are checked first.',
  },
];

const stages = [
  {
    name: 'Framing',
    body: 'A written brief fixes the scope of the question and states each claim precisely before any model runs. This is where the arguable words get pinned down: what “lost” means, gross or net, whose money, and the date that closes the accounting window. Any calculation the finding depends on is named here. Since v1.7 Stew, the AI steward, writes the brief from the intake record, which carries the wordings the extraction captured and where each came from. Before the freeze a model from a different vendor checks it. Its only question is whether the brief tests the claim people actually make, at its strongest fair reading, with definitions both sides would accept before seeing the result. That report is committed beside the brief. The brief is frozen once the check passes, so nobody can move the goalposts once the answers start arriving.',
  },
  {
    name: 'Blind research round',
    body: 'Three models, Claude, GPT and Gemini, receive the identical package: the brief, the public reviewer prompt, and a required JSON output schema. New runs must pass an execution check intended to keep host instructions and private files out of the review. A separate working directory alone did not provide that protection; the limitation and current pause are recorded below. Each returns a per-claim verdict, its confidence, the evidence supporting and challenging it, its limitations, what it could not find, and comparison cities with a judgement about whether those cases transfer to Edmonton.',
  },
  {
    name: 'Evidence staging and deterministic merge',
    body: 'Cited URLs are fetched, hashed and snapshotted. Then a script, with no model and no network, validates the three JSON files, removes duplicate sources, and produces a combined evidence set plus an explicit list of where the models disagree. Accepted sources are added to the evidence registry deliberately, by a separate script, never automatically.',
  },
  {
    name: 'Cross-review round',
    body: "Each model now sees the combined evidence and the other two sets of findings. The instruction is the opposite of consensus-seeking: find what you missed, find their errors, and state your final position. This is an error-documentation round, not a second vote. Since v1.3 nothing said here can move the canonical finding, which removes the incentive to drift toward the majority. Every final position is published beside the round-one one, so a reader can see who moved and why. When this round catches something material, a fabricated citation or evidence that turns out to say something else, the answer is a fresh blind re-run of that claim, not a quiet patch inside the same run. Since v1.22 that re-run has a fixed shape: all three seats receive the frozen brief again with the claims named and nothing about why, and the first round's answers stay on the record beside the new ones.",
  },
  {
    name: 'Deterministic synthesis',
    body: 'A script computes the canonical finding from the three locked round-one verdicts, using a published lookup table over every possible combination. Round one is designed to keep the three judgements separate, so only its verdicts enter the calculation. The execution limits below qualify that claim of independence. Model identity never enters the calculation, and the property is tested. A genuinely split panel produces Mixed, with the split shown. Beside the finding the site publishes panel agreement, Unanimous, Adjacent or Split. That replaced a confidence score in v1.3, because agreement is what the method actually measures and confidence implied a probability of truth that nothing here computes. All published arithmetic lives in a tested script, never in prose. Since v1.24 a run can also publish fewer claims than it asked. Where a framing concern is right and no repair exists that does not weaken the claim, that claim is parked with a public reason, and its answers stay committed.',
  },
  {
    name: 'Drafting, faithfulness check and plain-speech read',
    body: 'Claude drafts the question page and the claim records from the merged evidence, a fixed choice disclosed here. The other two models then check the draft against the evidence sentence by sentence, looking for anything asserted that the evidence does not carry. Flags are fixed before a human sees it. Then a model from a different vendor than the drafter reads the answers as a person would: would anyone say this out loud, does it make sense to somebody who has not seen the question, and has anything true been dropped rather than moved down. Its report is committed with the run, and a claim that cannot name its read does not publish.',
  },
  {
    name: 'Publication gate',
    body: 'Before publication, a dedicated audit, separate from the models that produced the draft, verifies every statement of fact against the archived bytes of its cited sources, not the live web. It also scans the raw review output for personal information and other material unsuitable for public release. Both audit reports are committed alongside the run. Since v1.1 this gate is performed by AI auditors under a standing delegation from Ildar Abdulin, who remains accountable for everything published and can revert any decision. A question may be deployed earlier in pending-review status; it is bannered as such and is not a finding.',
  },
];

/**
 * The three panel-agreement values, in the order a reader meets them. The gloss
 * text is imported rather than retyped so this page and every claim page cannot
 * drift apart on what the word means.
 */
const agreements = PANEL_AGREEMENT_LEVELS.map((level) => ({
  word: level,
  body: PANEL_AGREEMENT_GLOSS[level],
}));

/**
 * Panel agreement is outlined, never filled. A finding is a filled badge; these
 * three words describe the panel rather than the record, and a filled tile
 * beside a filled badge would invite a reader to take the two vocabularies for
 * one (the idiom is set out in `StateBadge.astro`).
 */
const agreementTile =
  'inline-block border border-ink px-[10px] py-[6px] font-sans text-[0.6875rem] leading-[1.2] font-bold tracking-[0.08em] uppercase whitespace-nowrap';

/**
 * The twenty rows of the published matrix, grouped by agreement in the order a
 * reader met the three words above. Derived from the script that computes every
 * finding on the site, so the page cannot drift from the rule it describes.
 */
const matrixGroups = PANEL_AGREEMENT_LEVELS.map((level) => ({
  word: level,
  rows: SYNTHESIS_MATRIX.filter((row) => row.agreement === level),
}));

const findings = [
  {
    word: 'Supported',
    body: 'The evidence establishes the claim.',
  },
  {
    word: 'Partially supported',
    body: 'Part of the claim holds and part does not — usually because a true fact has been stretched past what it shows.',
  },
  {
    word: 'Not established',
    body: 'The evidence available does not settle it. This is not a synonym for false. It means the record cannot answer the question yet, and we say what is missing.',
  },
  {
    word: 'Contradicted',
    body: 'The evidence points against the claim.',
  },
  {
    word: 'Mixed',
    body: 'Reserved for a materially split panel. Reviewers cannot output Mixed; only synthesis produces it, and only when the three reviewers genuinely divide. Where you see Mixed, the disagreement is shown rather than smoothed over.',
  },
];
const sections = toc([
  { id: 'short', label: 'The short version' },
  { id: 'vocabulary', label: 'The words we use' },
  { id: 'intake', label: 'How a claim gets in' },
  { id: 'pseudonyms', label: 'Names and quotes' },
  { id: 'stages', label: 'Seven stages' },
  { id: 'reviewer-execution', label: 'Reviewer execution' },
  { id: 'synthesis', label: 'Panel agreement' },
  { id: 'questions', label: 'What a question carries' },
  { id: 'limits', label: 'Limits we set' },
  { id: 'panel-quality', label: 'Panel quality record' },
]);
---

<Base
  sections={sections}
  title="Methodology"
  description="How YEGFacts checks a claim: every claim in a source is listed, a brief is frozen before any research, three AI models research it without seeing each other, a published table turns their verdicts into one finding, and every fact is checked against archived sources before it is published."
>
  <header class="border-b border-rule pb-6">
    <h1 class="text-[1.75rem] leading-[1.15] font-bold tracking-[-0.022em] sm:text-display">
      Methodology
    </h1>
    <p class="mt-3 max-w-prose text-base leading-relaxed text-muted">
      Three AI models from three companies each check a claim against the public record without
      seeing each other's work. A rule written down in advance turns their three answers into one
      finding. Nothing is published until every fact in it has been checked against a saved copy of
      its source.
    </p>
    <p class="mt-3">
      <a href="/methodology/changes" class="link">Methodology changes</a>
      <span class="text-muted"> — every revision to the process, versioned and dated.</span>
    </p>
  </header>

  <section id="short" class="mt-11">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">The short version</h2>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
      What can stop a claim, send it back or change it at each step is marked under the step.
    </p>

    <NumberedSteps steps={short} flow />

    <h3 class="mt-8 font-semibold tracking-[-0.012em] text-forest">Three things we will not do</h3>
    <ul class="mt-3 max-w-prose list-disc space-y-2 pl-5 text-[0.9375rem] leading-relaxed">
      <li>
        Publish an accusation about a named person. This version of the site checks policies,
        budgets and outcomes, not people, because it has no way yet for the person to answer.
      </li>
      <li>
        Check a claim nobody made. Every claim we test is one somebody actually wrote, quoted
        exactly as typed.
      </li>
      <li>
        Give a score. A finding is one of five words with a fixed meaning, set out below. Not
        established means the record cannot answer yet. It does not mean false.
      </li>
    </ul>

    <p class="mt-5 max-w-prose text-[0.9375rem] leading-relaxed">
      The prompts, the table, the reviewers' answers, the audit reports and every edit ever made
      are public, at{' '}
      <a href={SITE.repo} rel="noopener" class="link">{SITE.repo}</a>. What is not: who is behind a
      commenter's label, documents we are not allowed to mirror, accusations against named people,
      and personal information a release check removes. The sections on names and limits below
      say more. The rest of this page is the
      same method in full, for a reader who wants to audit it.
    </p>
  </section>

  {/*
    The vocabulary sits directly under the short version because the five words
    are what a reader has just been promised, and every section below reports
    its results in them.
  */}
  <section id="vocabulary" class="mt-14">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">The words we use</h2>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
      No true or false, and no score out of ten. A finding is one of five words. Beside it sit two
      more things: what kind of record answered the question, and whether the three reviewers
      agreed. A claim can be Supported on a thin record, or Not established by a panel that agreed
      unanimously that the record does not exist.
    </p>

    <dl class="mt-6 divide-y divide-rule border-t border-rule">
      {
        findings.map((finding) => (
          <div class="grid gap-x-6 gap-y-1.5 py-4 sm:grid-cols-[14rem_1fr]">
            <dt>
              <Finding finding={finding.word} size="lg" />
            </dt>
            <dd class="text-[0.9375rem] leading-relaxed">{finding.body}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-5 max-w-prose border-l-2 border-gold pl-3.5 text-[0.9375rem] leading-relaxed">
      Reviewers may only return the first four words. Mixed is produced by the table, never by a
      reviewer, and only when the three genuinely divide. A Mixed finding always comes with the
      split that produced it.
    </p>
  </section>

  <section id="intake" class="mt-14">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">
      How a claim gets in
    </h2>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
      Nobody here decides which claims are worth an argument. Until v1.15 somebody did, and it
      showed: the site was checking things nobody disputes while the actual fight went past it. So
      the choosing stopped. Whatever comes in comes in whole, and everything factual inside it is
      dealt with.
    </p>

    <NumberedSteps steps={intake} />

    <p class="mt-5 max-w-prose text-[0.9375rem] leading-relaxed">
      Two rules fall out of this, and both bind us rather than you. We do not check a claim that
      nobody has been recorded making: a wording one of us thought up is registered and then waits,
      unrun, until it shows up in something a real person wrote. And an assertion that names a real
      person and accuses them of something is written down with the rest, so no count can hide it,
      and is then turned down; the reason is under <a href="#limits" class="link">Limits</a> below.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      One source has been through this so far. What has not been shown is that the triage step
      returns the same answers twice on the same list, and until it has, the claim to make for it is
      narrow: the choosing is gone from intake, not from everything.{' '}
      <a href="/questions" class="link">Every question we have considered</a> is listed with what
      triage decided about it.
    </p>
  </section>

  <section id="pseudonyms" class="mt-14 scroll-mt-6">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">
      Names, and why the quotes are exact
    </h2>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed">
      Somebody who comments under a public post is not thereby a public figure. Every commenter in a
      capture is given a label in place of a name: an adjective, an Edmonton animal and an initial,
      like Snowy Hare F. It is picked by hashing the real name, so the same person gets the same
      label every time that source is exported and replies still line up with what they answer.
      Magpie is left out of the list, that one being Stew. Anyone holding public office keeps their
      own name. What matches a label to a person is held privately and is not in the repository.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      The words themselves are treated the other way round. A quotation is the comment as typed,
      misspellings included, and a script discards any that is not a single unbroken run of the
      comment it is pinned to, or that points at a comment number the capture does not contain.
      Nothing is stitched, tidied or corrected. Someone who commented in a thread we captured can
      find their own sentence here and see that it was not reworded on the way in.
    </p>
  </section>

  <section id="stages" class="mt-14">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">
      Seven stages, per question
    </h2>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
      One run covers every claim under one question. The state of every run lives in the
      repository, so any session can pick up where the last one stopped, and so can you. These
      seven begin once a question has come through the five steps above and triage has said go.
    </p>

    <NumberedSteps steps={stages} />

    <p class="mt-5 max-w-prose border-l-2 border-gold pl-3.5 text-[0.9375rem] leading-relaxed">
      Every question published so far passed the AI audit gate under this delegation; none was
      gated by a per-source manual founder review.
    </p>
  </section>

  <section id="reviewer-execution" class="mt-14 scroll-mt-6">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">
      Reviewer execution: correction and current limit
    </h2>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed">
      September 9, 2026: this page said a separate working directory kept each reviewer
      out of the repository. It did not. An{' '}
      <a href={repoPath('reviews/who-pays-for-roads/2026-09-03/verification/audit-2026-09-09.md')} rel="noopener" class="link">audit of the roads framing checks</a>{' '}
      found private project memory supplied outside the declared package; the third
      report read and cited it. No repository read
      was observed, but its absence was not proven. All findings published before this
      change predate the new check; they have not been retroactively cleared by it.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      That change required every new attempt to suppress host customizations and pass a
      separate test that public-web access works and local files stay unreachable under the
      same execution profile. It is a check of that execution, not a guarantee about a vendor.
      On that date no provider had a demonstrated profile meeting the full requirement, so new
      panels and source audits were paused: the candidate Claude setup reported its tools but
      did not expose the instruction text needed to check for injected context. An essential
      source that cannot be read blocks the run; it does not become a finding that the claim is
      not established.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      September 15, 2026: two of the three seats are still stopped. The Codex and Gemini seats
      have no equivalent evidence, so the three-model panel cannot run and the Gemini source
      check commissioned for the consultation question is still blocked. What changed is the
      Claude seat, and only the Claude seat.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      The change is that the outgoing request is now kept. Each Claude reviewer launch runs
      through a small program on this machine that writes down every request the tool sends to
      the address it was given for the model, and passes it on unchanged. A check then compares
      that request against a written-down description of what a clean one contains: the maker's
      own standard instructions and nothing added to them, only web search and web fetch as
      tools, and the declared package word for word. The seat may run when a test invocation
      and the real one both pass.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      What the request carries that the package does not, in full: the folder the tool was
      started in, whether that folder is a code repository, the computer's platform, shell and
      operating-system version; the name of the model and the date its knowledge stops; today's
      date; the account email address of the person running it; and an identifier for the
      device, one for the account and one for the session. The email address arrives in the same
      message as the package, and the folder, platform, model name and date in a separate
      message of their own. The three identifiers are not in any message: they are attached to
      the request alongside it, the way a return address is attached to an envelope. All of it
      comes from the maker's own text, not from this project. The record keeps the two messages
      word for word with the email address taken out, and notes that the three identifiers were
      sent without recording what they are. We publish the whole list rather than trimming it. A
      reviewer was told these things, and a shorter list would be a nicer story than the truth. The folder is now a scratch folder named after
      the attempt and nothing else, so it no longer tells a reviewer which story or which round
      it is working on.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      The description is written per model, not just per version of the tool, and finding that
      out cost the first real run. The description had been written from trial runs on a
      smaller, cheaper model. The first run on the model the panel actually uses was refused,
      because the same tool sends a different request for each model: a different set of
      standing instructions, different tool descriptions, and the folder and date in a different
      place. Nothing went out that should not have; the check stopped the run and said what did
      not match. The description now names the model as well as the version, and the one written
      from the trial runs was removed rather than kept beside it.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      The package reaches the maker twice per attempt: once as the research request, and once
      before that in a short request that asks the model to name the session, which carries the
      whole package and no tools. Both are written down and both are checked.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      What this does not show, on two sides. On this side: the program sees only what the tool
      sends to the one address it was given for the model. Anything the tool sent somewhere
      else, and everything else happening on the machine, is outside what it can see. The
      maker's standard instructions are matched by fingerprint, not read or republished, and
      the request's delivery headers are kept but not compared, so a pass is a statement about
      the body of the request. On the maker's side: it shows what the tool added on this
      computer and cannot show anything the company attaches to this account after the request
      leaves. A pass is evidence about one run under one version of the tool,
      not a promise from the company that makes it, and it clears nothing published before this
      date. Because the description was written from one version, the launcher runs that exact
      version even when a newer one is installed, as one was on the day this shipped; the run
      record shows both the version that ran and the version the computer would otherwise have
      used, and a new version has to be recorded and described again before it can run at all.
      The tool limit set out above still applies, PDFs included.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      September 16, 2026: the request is still kept, and what it is checked against is now
      smaller and weaker. The description written down the day before had to be rewritten by
      hand, at the cost of a paid run, every time the maker shipped a new version of the tool,
      which happens several times a week; the founder decided that price was too high for a
      check nobody could keep current, because a check that is out of date is a check that gets
      switched off. So the check now reads the private files that are on this computer at the
      moment it runs. Those are the instruction files in the operator's home folder and in this
      project, every note file this project's tools keep, the name of the home folder, the path
      of the project, and the one-off token each attempt plants for its own test. Every line of
      them long enough to be distinctive is looked for in every part of the request that was
      sent, and if any of it is there the run is refused. So is a run whose recording does not
      carry the declared package word for word, since a recording that cannot be tied to the
      package it was meant to carry says nothing about it. A refusal names the file and the line
      number, never the line, and neither does the published record: the private text is read,
      compared and dropped. What this no longer does is say what the request contains. It says
      what the request does not contain, for text this computer holds, and it cannot see text
      the maker attaches that is not on this computer. The full recording is still kept, so a
      later reader can ask a harder question of the same bytes. The version of the tool is
      written down now rather than required, so a version nobody has looked at before no longer
      stops a run. The reviewers who read the September 15 work argued for keeping the stricter
      check and said what it was protecting; that argument stands in the record beside this
      decision and has not been withdrawn. The founder decided against it.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      Each launch attempt keeps its package and execution record privately, even when it
      is refused. The diagnostic's complete response is retained too. When reviewers can
      run again, their full responses, including trailing provenance, must be retained
      before a report is extracted; the public run record will carry the hashes and
      execution results. Ildar Abdulin retains the originals while
      the associated public record exists. For inspection, write to{' '}
      <a href={`mailto:${SITE.researchEmail}`} class="link">{SITE.researchEmail}</a>; hash comparisons and
      redacted excerpts are subject to privacy and rights review. A published hash does not
      itself give access to a private file. Earlier deleted output cannot be recovered by
      this policy. The{' '}<a href="/methodology/changes" class="link">methodology changelog</a>{' '}records
      the change and the independent reviews.
    </p>
  </section>

  <section id="synthesis" class="mt-14 scroll-mt-6">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">
      Panel agreement, and why the merge leans cautious
    </h2>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
      Beside every finding sits one more word, computed from the three locked round-one verdicts.
      It describes the panel, not the world.
    </p>

    <dl class="mt-6 divide-y divide-rule border-t border-rule">
      {
        agreements.map((agreement) => (
          <div class="grid gap-x-6 gap-y-1.5 py-4 sm:grid-cols-[11rem_1fr]">
            <dt>
              <span class={agreementTile}>{agreement.word}</span>
            </dt>
            <dd class="text-[0.9375rem] leading-relaxed">{agreement.body}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-6 max-w-prose text-[0.9375rem] leading-relaxed">
      Where the three do not agree, the lookup table resolves toward the more cautious side of the
      majority. Two Supported and one Partially supported publishes as Partially supported. That
      is deliberate. Supported means the proposition as written is affirmatively established, and a
      qualification one reviewer found does not stop existing because the other two missed it. For
      a site whose whole job is not overstating the record, overclaiming is the costlier of the two
      errors it could make.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      The obvious objection is that this hands a single reviewer a veto. The answer is disclosure
      rather than averaging. Every claim shows what each of the three said, so a reader who thinks
      the lone qualifier was wrong can see precisely that and weigh it, without the site publishing
      a stronger claim than every reviewer accepted.
    </p>

    {/*
      Twenty rows of badge words would drown the search index and two rows share
      a rationale word for word, so the whole table is ignored. The wrapper is
      the disclosure itself, closed by default: twenty rows are a reference, not
      reading. Nothing inside it may be another `details`: the duplication audit
      strips a `data-pagefind-ignore` element with a non-greedy same-tag regex,
      so a nested one would close the strip early and the shared rationale would
      come back as an in-page failure.
    */}
    <h3 class="mt-8 font-semibold tracking-[-0.012em] text-forest">The whole table</h3>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
      Three reviewers, four words, twenty possible panels. Every one is written out in
      the script that computes the finding, and this is that script's table, not a copy
      of it. Read down the left for what the three said, across for what is published.
    </p>
    {/* The heading stays outside the disclosure: a heading inside a summary is not reliably announced as one. */}
    <details class="mt-4 border-y border-rule open:pb-6" data-pagefind-ignore>
      <summary class="flex min-h-12 cursor-pointer list-none items-baseline justify-between gap-3 py-2 text-sm">
        <span class="font-semibold">The twenty panels, from the script</span>
        <span class="disclosure-state shrink-0 text-muted"></span>
      </summary>

      {
        matrixGroups.map((group) => (
          <>
            {/* A real heading, so the three groups are reachable by heading navigation; the outline is declared in `sections`, so an h4 here does not enter it. */}
            <h4 class="mt-6 flex flex-wrap items-center gap-3 font-sans">
              <span class={agreementTile}>{group.word}</span>
              <span class="text-[0.6875rem] font-semibold tracking-[0.11em] text-muted uppercase">
                {group.rows.length} panels
              </span>
            </h4>
            <ul class="mt-3 divide-y divide-rule border-t border-rule">
              {group.rows.map((row) => (
                <li class="py-3">
                  <span class="grid gap-x-4 gap-y-1.5 sm:grid-cols-[28rem_1.25rem_1fr] sm:items-center">
                    <span class="flex flex-wrap gap-1">
                      {row.verdicts.map((v) => (
                        <Finding finding={v} size="sm" />
                      ))}
                    </span>
                    <span class="inline-block w-fit rotate-90 text-muted sm:rotate-0" aria-hidden="true">
                      →
                    </span>
                    <span>
                      <Finding finding={row.finding} size="md" />
                    </span>
                  </span>
                  <p class="mt-1.5 text-[0.8125rem] leading-snug text-muted">{row.rationale}</p>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </details>
  </section>

  <section id="questions" class="mt-14">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">
      What a question carries
    </h2>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed">
      A question has no verdict of its own. Verdicts belong to claims — the atomic, testable
      assertions under it — and every claim has a page of its own, so it can be linked, quoted and
      read without the question around it. A question also records what the City promised,
      separately from whether the promise was kept: recording a commitment is transcription and
      needs no panel run, and it only becomes assessed when a real claim about it goes through the
      process above.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      Every load-bearing source is registered with its publisher, retrieval date, and the SHA-256 of
      the bytes we archived. Where we are allowed to mirror a file, it is committed to the public
      repo. Where we are not, the hash and the original URL are published and the file is retained
      privately, so a missing document can still be proved to be the one we read.
    </p>
  </section>

  <section id="limits" class="mt-14">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">Limits we set on ourselves</h2>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed">
      Version 1 of YEGFacts publishes no allegations about named individuals. The claims we check
      are about policies, programs, budgets and outcomes.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      Captured sources carry such allegations all the time, so the rule has to say what happens to
      them rather than pretend they do not arrive. They are extracted and counted like anything
      else, because a rule enforced by looking away is not a rule. Then triage declines them, always
      for the same published reason: checking what one person says about another needs a way for the
      second person to answer, and this version of the site has none. The decline is public, the
      allegation and the name are not.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      Reproducibility has a real limit and we would rather state it than paper over it. The panel
      runs through consumer CLI subscriptions, so an identical rerun cannot be guaranteed to produce
      identical model output. What is recorded instead is the manifest: which models, which CLI
      versions, which prompt hash, which methodology version, and when. The method is rerunnable;
      the model output is not bit-exact, and no finding depends on it being so — the evidence and
      the synthesis rule are both public.
    </p>
    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      The full audit trail behind this site is public at{' '}
      <a href={SITE.repo} rel="noopener" class="link">{SITE.repo}</a>. The prompts,
      the synthesis matrix, the validation rules, the raw review artifacts, the gate reports and
      the full edit history are all there.
    </p>
  </section>

  <section id="panel-quality" class="mt-14 scroll-mt-6">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">Panel quality record</h2>
    <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed">
      The models get things wrong. Collection of a per-seat record of that began on 2026-09-01 and
      was seeded backwards from the four published runs: fabricated citations, false accusations
      against another reviewer, unsupported figures, and the catches that turned out to be right —
      each one adjudicated, dated, and tied to the committed artifact that proves it. It is an
      error record, not a calibration: none of it measures the models against known truth. A
      summary publishes once there are enough runs to count, which four are not; the point at
      which it published used to be fixed by the launch slate, and that slate is gone. The raw
      ledger is in the repo at{' '}
      <a href={repoPath('methodology/quality-ledger.yaml')} rel="noopener" class="link">
        methodology/quality-ledger.yaml
      </a>{' '}
      and can be read today.
    </p>
  </section>
</Base>
