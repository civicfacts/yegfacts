---
import Base from '../layouts/Base.astro';
import TriageBadge from '../components/TriageBadge.astro';
import { allPublishedStories } from '../lib/content';
import {
  TRIAGE_SECTIONS,
  claimRegister,
  claimText,
  discussedBy,
  provenance,
  questionRegister,
  questionsForSource,
  registerKey,
  reportsFor,
  sourceKind,
  sourceRegister,
  storyLinkLabel,
  triageEdge,
} from '../lib/intake';
import { toc } from '../lib/toc';

/**
 * `/considered` — the register, published.
 *
 * The page is the answer to "what did you leave out". Since whole-source
 * intake it answers it twice over: a source is read end to end, every factual
 * claim in it is extracted and merged into a proposition, and every one of
 * those propositions is listed here with what happened to it. So the page is
 * organised by source, because that is the unit the promise is made about.
 *
 * Inside a source it is organised by question, because that is the unit
 * the decision is made about: one question, one brief, one panel run, with the
 * claims checked under it beneath it. Listing the claims flat, as this page did
 * first, made four claims about who pays for Edmonton's roads read as four
 * separate decisions, and hid the thing a reader checking for cherry-picking
 * most wants to see — that both sides of an argument are asking the same
 * question.
 *
 * The questions are ordered by how many people discussed them, so the arguments
 * Edmonton is actually having are at the top and the hyper-specific ones sink.
 *
 * The claims that arrived one at a time, before there were sources, keep the
 * shape they had: the triage answer as a section heading, one entry to a row.
 *
 * Before any of it comes the key, because the words in the outcome column are
 * the page's own vocabulary and a first-time reader has no way to know that
 * "Going ahead" is a decision to check a question rather than a finding about
 * it. The key defines every label the page can print, and says how two readers'
 * dispositions combine into the one on the row.
 */
const claims = claimRegister();
const questions = questionRegister();
const sources = sourceRegister();

/**
 * A story link is only offered when there is a page behind it — which a
 * withdrawn story still has, so this reads the whole published set rather than
 * the boards' view of it.
 */
const published = new Set((await allPublishedStories()).map((story) => story.id));

const bySource = sources.map((source) => ({
  source,
  questions: questionsForSource(source.id),
}));

/** Everything registered before the source was the unit, grouped by triage. */
const unsourced = questions.filter((question) => question.source === undefined);

const sections = TRIAGE_SECTIONS.map((section) => ({
  ...section,
  entries: unsourced.filter((question) => question.triage === section.triage),
})).filter((section) => section.entries.length > 0);

/**
 * The key, and whether the page has to explain the withheld rows: both come
 * from the register, so the page defines what it shows and nothing else.
 */
const key = registerKey();
const withholding = claims.some((claim) => claim.withheld);

const outline = toc([
  { id: 'outcomes', label: 'What the outcomes mean' },
  ...bySource.map(({ source }) => ({ id: source.id, label: source.title })),
  unsourced.length > 0 && { id: 'one-at-a-time', label: 'Registered one at a time' },
]);

const label = 'text-xs tracking-[0.08em] text-muted uppercase tabular';

/**
 * The count and badge columns of the source tables.
 *
 * From `md` up each shrinks to its own content, as the finding column does on
 * /stories, so the question keeps every pixel the counts do not need. Below
 * that the row stacks: four columns on a phone left the question wrapping in a
 * ribbon a third of the screen wide with the rest of the row empty beside it,
 * so under `md` every cell is a block and the counts read under the question
 * they belong to.
 */
const countColumn = `md:table-cell md:w-px md:pl-4 md:text-right md:align-top md:whitespace-nowrap ${label}`;
const badgeColumn = 'block md:table-cell md:w-px md:pl-4 md:text-right md:align-top';
---

<Base
  sections={outline}
  title="Every claim we've considered"
  description="Every claim that reached YEGFacts, with what happened to it and why — including the ones we declined to check."
>
  <header class="border-b border-rule pb-6">
    <h1
      class="text-[1.75rem] leading-[1.15] font-extrabold tracking-[-0.022em] sm:text-display"
    >
      Every claim we've considered
    </h1>
    <p class="mt-4 max-w-prose text-base leading-relaxed">
      This site checks factual claims about Edmonton that circulate. When we read a source, a post
      and every comment on it, we take out every factual claim in it, not the ones that suit us:
      three models each read the whole thing and write down every claim they can find, then a fourth
      folds those three lists into propositions, one for each thing a public record could settle.
      Every proposition is below.
    </p>
    <p class="mt-4 max-w-prose text-base leading-relaxed">
      Those propositions are then grouped into questions, and a question is what the
      decision below is made about: one question, one brief, one body of evidence, one panel. Several
      claims to a question is normal, and claims that contradict each other belong to the same
      question. Whether barriers delay emergency vehicles and whether responders ride down the lanes
      to get past traffic are two claims about one question, so they are investigated together and
      each still gets its own finding. A single finding over both would state nothing.
    </p>
    <p class="mt-4 max-w-prose text-base leading-relaxed">
      The outcome is an intake decision and nothing more: whether the question is worth checking. It
      is not a ruling on whether any claim under it is true, and nothing here has been checked yet
      on the strength of it. Finished checks are on <a href="/stories" class="link">the findings</a>.
      A short <a href="/methodology/changes" class="link">triage</a> makes the intake call, asking
      who is asking the question, whether the public record can answer it, and which answers would
      surprise anyone.
    </p>
    <p class="mt-4 max-w-prose text-base leading-relaxed">
      The counts are of distinct people within one source, so somebody who commented five times
      counts once. Somebody counted under a claim may have been arguing against it, which is why
      the count says discussed and not agreed.
    </p>
  </header>

  <section id="outcomes" class="mt-12 scroll-mt-6">
    <h2 class="section-heading">What the outcomes mean</h2>

    {/* The badge is the term, so a reader can match a row to its line by shape. */}
    <dl class="mt-5 divide-y divide-rule border-t border-rule">
      {
        key.map((entry) => (
          <div class="py-3 sm:flex sm:gap-5">
            <dt class="sm:w-40 sm:shrink-0">
              <TriageBadge triage={entry.triage} />
            </dt>
            <dd class="mt-1.5 max-w-prose text-[0.9375rem] leading-relaxed sm:mt-0">
              {entry.definition}
            </dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-6 max-w-prose text-[0.9375rem] leading-relaxed">
      Two readers rule on every question, one call each, written GO, PARK or NO. Those are the
      words some of the reasons below use. Going ahead takes both readers at GO, or one GO and one
      PARK. Declined takes two NOs. Everything else parks, a GO set against a NO included, because
      throwing out a real question costs the reader more than holding one too long. So a question
      marked going ahead can be one the two readers did not agree on, and where they split the
      reason says so.
    </p>

    {
      withholding && (
        <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
          Some rows read “Withheld claim”. Those are propositions about an identifiable person,
          which this site does not repeat while it has no right of reply to offer them. The row
          keeps its place under the question it was checked under, that question keeps its answer
          and its reason, and the entry behind the row says more.
        </p>
      )
    }
  </section>

  {
    bySource.map(({ source, questions: sourceQuestions }) => (
      <section id={source.id} class="mt-14 scroll-mt-6">
        <h2 class="border-t-[3px] border-ink pt-3.5 font-display text-[1.5rem] leading-[1.2] font-semibold text-pretty">
          {source.title}
        </h2>

        {/*
          Straight out of the register: what the source is, when we took it, how
          big it was, and the two counts kept apart. The three extractions raise
          claims; the merge is what turns those into propositions, and there are
          fewer of the second because one proposition holds every wording of
          itself that the three readings found.
        */}
        <p class={`mt-2 ${label}`} data-record>
          {sourceKind(source)}
          {' · captured '}
          <time datetime={source.captured}>{source.captured}</time>
          {source.captured_by && ` by the ${source.captured_by}`}
          {source.comments !== undefined && ` · ${source.comments} comments`}
          {source.commenters !== undefined && ` from ${source.commenters} people`}
          {source.claims_found !== undefined && ` · ${source.claims_found} claims raised in extraction`}
          {source.propositions !== undefined && ` · merged into ${source.propositions} propositions`}
        </p>

        <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
          Commenter names are replaced throughout by stable pseudonyms: one pseudonym is one person
          within this source, so a reply still lines up with what it answers, and it means nothing
          outside it.{' '}
          <a href={source.url} class="link" rel="noopener nofollow">
            The original post
          </a>
          .
        </p>

        {sourceQuestions.length === 0 ? (
          <p class="mt-4 border-l-2 border-gold pl-3.5 text-[0.9375rem] leading-relaxed text-muted">
            The source has been read and merged; the dispositions are not registered yet.
          </p>
        ) : (
          <>
            <p class={`mt-5 ${label}`}>The most-discussed questions come first.</p>

            {/*
              The ledger idiom /stories uses, carrying the register's two
              levels: a 5px left edge in the triage answer's colour on the question,
              the counts and the filled badge in columns of their own, so the
              dispositions read down one side of the page. One tbody to a
              question, with the claims checked under it as rows beneath it, so
              a claim is attached to its question by the table's own structure.
              A claim row prints no badge, because the answer on the row above
              is the one decision made and repeating it on each claim would put
              four decisions where there was one.

              The column heads say what each cell already says in words, so they
              are for screen readers only, as on /stories.
            */}
            <table class="mt-4 block w-full border-collapse md:table">
              <caption class="sr-only">Questions from {source.title}</caption>
              <thead class="sr-only">
                <tr>
                  <th scope="col">Question or claim</th>
                  <th scope="col">Discussed by</th>
                  <th scope="col">Claims</th>
                  <th scope="col">Outcome</th>
                </tr>
              </thead>
              {sourceQuestions.map(({ question, claims }) => (
                <tbody class="block border-t border-rule md:table-row-group">
                  <tr id={question.id} class="block scroll-mt-6 md:table-row">
                    <td class="block pt-4 md:table-cell md:py-4 md:pr-4 md:align-top">
                      <span
                        class:list={[
                          'block border-l-[5px] pl-4',
                          triageEdge(question.triage),
                        ]}
                      >
                        <a
                          href={`/considered/${question.id}`}
                          class="link font-display text-[1.1875rem] leading-snug font-semibold text-pretty"
                          data-record
                        >
                          {question.question}
                        </a>
                        {question.reason && (
                          <span
                            class="mt-2 block max-w-prose text-[0.9375rem] leading-relaxed text-muted"
                            data-record
                          >
                            {question.reason}
                          </span>
                        )}
                      </span>
                    </td>
                    <td class:list={['block pt-2 pl-5 md:py-4', countColumn]} data-record>
                      {question.accounts && discussedBy(question.accounts.total)}
                    </td>
                    <td
                      class:list={['block pt-1 pl-5 whitespace-nowrap md:py-4', countColumn]}
                      data-record
                    >
                      {`${claims.length} ${claims.length === 1 ? 'claim' : 'claims'}`}
                    </td>
                    <td class:list={['pt-3 pb-4 pl-5 md:py-4', badgeColumn]}>
                      <TriageBadge triage={question.triage} />
                    </td>
                  </tr>

                  {claims.map((claim) => (
                    <tr id={claim.id} class="block scroll-mt-6 border-t border-rule md:table-row">
                      <td class="block pt-2.5 pl-4 md:table-cell md:py-2.5 md:pr-4 md:align-top">
                        <a
                          href={`/considered/${claim.id}`}
                          class="link text-[0.9375rem] leading-snug text-ink"
                          data-record
                        >
                          {claimText(claim)}
                        </a>
                      </td>
                      {/* A withheld claim has no count either, and no empty
                          line where one would have been. */}
                      <td
                        class:list={[
                          claim.accounts === undefined ? 'hidden' : 'block pt-1 pb-2.5 pl-4',
                          'md:py-2.5',
                          countColumn,
                        ]}
                        data-record
                      >
                        {claim.accounts !== undefined && discussedBy(claim.accounts)}
                      </td>
                      {/* The claim is decided by the question above it, so the
                          two right-hand columns are its question's business. */}
                      <td class="hidden md:table-cell md:py-2.5" />
                      <td class="hidden md:table-cell md:py-2.5" />
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </>
        )}
      </section>
    ))
  }

  {
    unsourced.length > 0 && (
      <section id="one-at-a-time" class="mt-16 scroll-mt-6">
        <h2 class="border-t-[3px] border-ink pt-3.5 font-display text-[1.5rem] leading-[1.2] font-semibold">
          Registered one at a time
        </h2>
        <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
          Claims that reached us singly rather than inside a source we hold: a reader's suggestion,
          a wording the founder passed on, a hypothesis of our own. The triage answers are the ones
          in the key above, set as headings here rather than badges.
        </p>

        {sections.map((section) => (
          <section id={section.id} class="mt-10 scroll-mt-6">
            <h3 class="text-lg font-extrabold tracking-[-0.015em] text-forest">{section.heading}</h3>

            <ol class="mt-5 divide-y divide-rule border-t border-rule">
              {section.entries.map((question) => {
                const reports = reportsFor(question);
                return (
                  /* The register id is the anchor, so a story that was withdrawn can
                     send a reader to the entry that says why. */
                  <li id={question.id} class="scroll-mt-6 py-7">
                    <article>
                      {/* The claim in the words it reached us in. `data-record` for the
                          same reason the meta line below carries it: one wording can be
                          registered twice — once when it was checked, once when the story
                          it produced was withdrawn — and that is the register's business,
                          not this page saying the same thing twice. */}
                      <blockquote
                        class="max-w-prose border-l-2 border-gold pl-4 text-[1.0625rem] leading-relaxed text-pretty"
                        data-record
                      >
                        {question.registered_as ?? question.question}
                      </blockquote>

                      {/* Straight out of the register: two questions sharing a date and a
                          provenance is the register's business, not this page repeating itself. */}
                      <p class={`mt-3 ${label}`} data-record>
                        <time datetime={question.recorded}>{question.recorded}</time>
                        {' · '}
                        <span class="normal-case tracking-normal">{provenance(question)}</span>
                      </p>

                      {(question.reason ?? question.note) && (
                        <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
                          {question.reason ?? question.note}
                        </p>
                      )}

                      {(reports.length > 0 ||
                        (question.story && published.has(question.story))) && (
                        <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                          {/* The reports are on the site now, so the reader is sent
                              there rather than to GitHub; the repository copy is
                              linked at the foot of the question's own page. */}
                          {reports.length > 0 && (
                            <a href={`/considered/${question.id}`} class="link">
                              {question.triage_report ? 'Read the triage' : 'Read the intake record'}
                            </a>
                          )}
                          {question.story && published.has(question.story) && (
                            <a href={`/facts/${question.story}`} class="link">
                              {storyLinkLabel(question)}
                            </a>
                          )}
                        </p>
                      )}
                    </article>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </section>
    )
  }

  {
    questions.length === 0 && sources.length === 0 && (
      <p class="mt-8 border-l-2 border-gold pl-3.5 text-[0.9375rem] leading-relaxed text-muted">
        Nothing has been recorded yet. The first entry lands with the first claim someone sends us.
      </p>
    )
  }
</Base>
