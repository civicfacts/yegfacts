---
import Base from '../layouts/Base.astro';
import { publishedStories } from '../lib/content';
import { candidateRegister, type Candidate } from '../lib/intake';
import { repoFile } from '../lib/site';
import { toc } from '../lib/toc';

/**
 * `/considered` — the candidate register, published.
 *
 * The register already holds every claim that reached us and what happened to
 * it; this page is that file with the shorthand swapped for sentences. The
 * declined entries are the reason it exists, so they lead, and they are set in
 * the same type as everything else: the outcome is the section heading, not a
 * badge, because a declined claim is a decision we defend rather than a state
 * to colour-code.
 */
const candidates = candidateRegister();

/** A story link is only offered when there is a published page behind it. */
const published = new Set((await publishedStories()).map((story) => story.id));

const sections = [
  { id: 'declined', outcome: 'NO', heading: 'Declined' },
  { id: 'parked', outcome: 'PARK', heading: 'Parked' },
  { id: 'going-ahead', outcome: 'GO', heading: 'Going ahead' },
  { id: 'pre-triage', outcome: 'pre-triage', heading: 'Checked before triage existed' },
  { id: 'not-triaged', outcome: 'not-triaged', heading: 'Not yet triaged' },
].map((section) => ({
  ...section,
  entries: candidates.filter((candidate) => candidate.outcome === section.outcome),
}));

const ORIGINS: Record<string, string> = {
  captured: 'captured from a post',
  supplied: 'passed to us, source not captured',
  editor: 'our own hypothesis',
};

/**
 * `supplied_by` is written for the register and carries the circumstance as
 * well as the person ("founder, as a test case for the triage"). Readers need
 * the circumstance too, or a test case reads as a serious suggestion, so the
 * whole clause is shown. A lowercase value is a role and takes an article; a
 * capitalised one is a name and does not.
 */
function attribution(suppliedBy: string): string {
  const article = /^[a-z]/.test(suppliedBy) ? 'the ' : '';
  return `from ${article}${suppliedBy}`;
}

function provenance(candidate: Candidate): string {
  const origin = ORIGINS[candidate.origin] ?? candidate.origin;
  return candidate.supplied_by ? `${origin}, ${attribution(candidate.supplied_by)}` : origin;
}

const outline = toc(
  sections.map((section) => section.entries.length > 0 && { id: section.id, label: section.heading }),
);

const label = 'text-xs tracking-[0.08em] text-muted uppercase tabular';
---

<Base
  sections={outline}
  title="Every claim we've considered"
  description="Every claim that reached YEGFacts, with what happened to it and why — including the ones we declined to check."
>
  <header class="border-b border-rule pb-6">
    <h1
      class="text-[1.75rem] leading-[1.15] font-extrabold tracking-[-0.022em] sm:text-display"
    >
      Every claim we've considered
    </h1>
    <p class="mt-4 max-w-prose text-base leading-relaxed">
      This site checks factual claims about Edmonton that circulate. Before any claim is checked, a
      short <a href="/methodology/changes" class="link">triage (methodology v1.12)</a> asks who is
      asking it, whether the public record can answer it, and which verdicts would surprise anyone.
      Every claim we have considered is listed below with the outcome, whether a reader sent it, the
      founder passed it on, or it was our own idea, and including the ones we declined, so nobody
      has to wonder why a claim was not checked.
    </p>
  </header>

  {
    sections
      .filter((section) => section.entries.length > 0)
      .map((section) => (
        <section id={section.id} class="mt-12">
          <h2 class="text-xl font-extrabold tracking-[-0.015em] text-forest">{section.heading}</h2>

          <ol class="mt-5 divide-y divide-rule border-t border-rule">
            {section.entries.map((candidate) => (
              <li class="py-7">
                <article>
                  <blockquote class="max-w-prose border-l-2 border-gold pl-4 text-[1.0625rem] leading-relaxed text-pretty">
                    {candidate.wording}
                  </blockquote>

                  {/* Straight out of the register: two candidates sharing a date and a
                      provenance is the register's business, not this page repeating itself. */}
                  <p class={`mt-3 ${label}`} data-record>
                    <time datetime={candidate.recorded}>{candidate.recorded}</time>
                    {' · '}
                    <span class="normal-case tracking-normal">{provenance(candidate)}</span>
                  </p>

                  {(candidate.reason ?? candidate.note) && (
                    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
                      {candidate.reason ?? candidate.note}
                    </p>
                  )}

                  {(candidate.triage || (candidate.story && published.has(candidate.story))) && (
                    <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                      {candidate.triage && (
                        <a href={repoFile(candidate.triage)} rel="noopener" class="link">
                          Triage report (GitHub)
                        </a>
                      )}
                      {candidate.story && published.has(candidate.story) && (
                        <a href={`/facts/${candidate.story}`} class="link">
                          Where it was checked
                        </a>
                      )}
                    </p>
                  )}
                </article>
              </li>
            ))}
          </ol>
        </section>
      ))
  }

  {
    candidates.length === 0 && (
      <p class="mt-8 border-l-2 border-gold pl-3.5 text-[0.9375rem] leading-relaxed text-muted">
        Nothing has been recorded yet. The first entry lands with the first claim someone sends us.
      </p>
    )
  }
</Base>
