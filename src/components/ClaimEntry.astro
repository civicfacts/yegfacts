---
import StateBadge from './StateBadge.astro';
import {
  claimText,
  commentsOn,
  saidIn,
  sourceKind,
  triageHeading,
  type Claim,
  type Question,
  type Source,
} from '../lib/intake';

/**
 * One claim that has not been checked, and the question it is waiting on.
 *
 * A claim from a whole source was not decided on its own: triage ruled on the
 * question it belongs to, one panel run will answer that question, and this
 * claim will get one finding out of it. So the page says plainly that it has no
 * finding, names the question it is waiting on, and prints that question's
 * state. Printing a state here as though the claim had been ruled on by itself
 * would misdescribe what happened, and would put four decisions on the page
 * where there was one.
 */
interface Props {
  claim: Claim;
  /** The question it is checked under. Every claim has one. */
  question: Question;
  source: Source | null;
}

const { claim, question, source } = Astro.props;

/**
 * The captured wordings, already emptied by the register loader for a claim
 * that names an individual and was declined, so the page never receives them
 * and cannot print them.
 */
const variations = claim.variations ?? [];

/**
 * A merged claim is a sentence we wrote to say what would have to be true, so
 * it is set as a statement; a claim with only the words it arrived in is quoted.
 */
const quoted = claim.proposition === undefined;

const label = 'text-xs tracking-[0.08em] text-muted uppercase tabular';

/**
 * The claim was ruled on separately from the question around it.
 *
 * Two cases, and they are different enough that the page says which. An
 * accusation against a named person is declined even where the investigation
 * around it is worth running, because the site has no way to put the
 * accusation to them. A claim parked on the `no-instrument` ground went to the
 * panel and came back unpublishable: the only instrument that exists cannot
 * carry the proposition, and the site will not make the proposition weaker to
 * fit it. Either way two decisions differ here, so the page prints both rather
 * than the question's alone.
 */
const declinedApart = claim.triage === 'no' && question.triage !== 'no';
const parkedApart = claim.triage === 'park' && question.triage !== 'park';
const ruledApart = declinedApart || parkedApart;
---

<article>
  <header class="border-b border-rule pb-7">
    <div class="text-xs text-muted" data-crossref>
      <a href="/questions" class="link">Every question we've considered</a>
    </div>

    {/*
      The claim in its own words is the title, quoted, because this page is
      about a sentence somebody said rather than about a subject we named. A
      withheld claim has no words to print, so the redaction gives it a literal
      heading instead: the page says what it is rather than dressing its own
      reason up as something a commenter said.
    */}
    <h1
      class="mt-3 text-[1.5rem] leading-[1.2] font-bold tracking-[-0.02em] text-pretty sm:text-[1.875rem]"
    >
      {quoted && claim.wording ? `“${claim.wording}”` : claimText(claim)}
    </h1>

    {/*
      Straight out of the register. A withheld claim reaches this page with no
      wordings, so it has no comment count either: the count is of the comments
      the page is refusing to show. Its register id stands in their place,
      because the id is what a later audit asks for.
    */}
    <p class={`mt-4 ${label}`} data-record>
      <time datetime={claim.recorded}>{claim.recorded}</time>
      {claim.withheld && <span class="normal-case tracking-normal">{` · entry ${claim.id}`}</span>}
      {
        commentsOn(claim) > 0 && (
          <span class="normal-case tracking-normal">{` · ${saidIn(commentsOn(claim))}`}</span>
        )
      }
    </p>
  </header>

  {/*
    The answer to the first thing a reader wants from a claim page, given
    plainly and first: there isn't one yet. A page that leads with provenance
    and leaves the reader to infer the absence of a finding is a page that
    reads as though something had been decided.
  */}
  <section id="finding" class="mt-10 scroll-mt-6">
    <h2 class="text-xl font-bold tracking-[-0.015em] text-forest">No finding yet</h2>
    <p class="mt-3.5 max-w-prose text-[1.0625rem] leading-relaxed text-pretty">
      {
        declinedApart
          ? 'This claim has not been checked and will not be. It is an allegation about a named person, and the site declines those; the reason is below.'
          : parkedApart
            ? 'This claim was put to the panel and came back without one. No published record can settle it as the claim was made, so it is parked rather than answered on something that would not carry it. The reason is below, with the condition on which we come back to it.'
            : question.triage === 'no'
              ? 'This claim has not been checked. The question it belongs to was turned down at intake, for the reason below.'
              : 'This claim has not been checked. It is waiting on the question below, which is what a brief, a body of evidence and a panel run are spent on.'
      }
    </p>

    <p class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-2">
      <span class={label}>{ruledApart ? 'This claim' : 'Its question'}</span>
      <StateBadge state={ruledApart ? claim.triage! : question.triage} />
      {
        ruledApart && (
          <>
            <span class={label}>The question around it</span>
            <StateBadge state={question.triage} />
          </>
        )
      }
    </p>

    {
      (ruledApart ? claim.reason : question.reason) && (
        <p
          class="mt-3.5 max-w-prose border-l-2 border-gold pl-3.5 text-[1.0625rem] leading-relaxed text-pretty"
          data-record
        >
          {ruledApart ? claim.reason : question.reason}
        </p>
      )
    }

    {
      /*
        What is missing from this page, said plainly, because a page that
        declines to print something and does not say why reads as evasion.
        Three things it must not get wrong: the site has chosen not to build a
        right of reply, rather than being unable to; the wording is held in a
        private record, not in this register, which is the public one; and the
        decision is auditable later from that record.
      */
      claim.withheld && (
        <p class="mt-4 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
          A commenter in this source made an allegation about a named person. The site turns those
          down: to publish one fairly it would have to put the allegation to the person named and
          print their answer, and that process has not been built here. The wording and the comments
          it was said in are kept in a private record, so the decision can be audited later against
          what was actually said. In public the entry is its identifier, its decision and the reason
          for it.
        </p>
      )
    }

    {
      /*
        The seats raised claims; the merge wrote the sentence above out of them.
        "Found by" read as though the models had produced the sentence they are
        listed under, which is the one thing they do not do.
      */
      claim.seats && claim.seats.length > 0 && (
        <p class={`mt-5 ${label}`} data-record>
          {`Raised in extraction by ${claim.seats.join(', ')}`}
        </p>
      )
    }

    <p class="mt-5 text-sm" data-crossref>
      <a href="/questions#states" class="link">What the states mean</a>
    </p>
  </section>

  <section id="question" class="mt-14 scroll-mt-6">
    <h2 class="section-heading">The question it is checked under</h2>

    {/* The question, set as the question it is, so it is not a clause inside a
        sentence about it. */}
    <p
      class="mt-3.5 max-w-prose font-display text-[1.1875rem] leading-snug font-semibold text-pretty"
      data-crossref
    >
      <a href={`/questions/${question.id}`} class="link">{question.question}</a>
    </p>

    <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
      {triageHeading(question.triage)}. One brief covers every claim under that question, and each
      claim still gets its own finding. The question's page carries the reason, the grouping and the
      other claims made about it.
    </p>
  </section>

  {
    source && (
      <section id="source" class="mt-14 scroll-mt-6">
        <h2 class="section-heading">Where it came from</h2>
        <p class="mt-3 max-w-prose text-[1.0625rem] leading-relaxed text-pretty">
          Taken from{' '}
          <a href={`/sources/${source.id}`} class="link">
            {source.title}
          </a>
          , read end to end. Every factual claim in it was extracted and merged, so this one is
          listed whatever became of it.
        </p>
        <p class={`mt-3 ${label}`} data-record>
          {sourceKind(source)}
          {' · captured '}
          <time datetime={source.captured}>{source.captured}</time>
          {source.comments !== undefined && ` · ${source.comments} comments`}
        </p>
        <p class="mt-3 text-sm" data-crossref>
          <a href={source.url} class="link" rel="noopener nofollow">
            The original post
          </a>
        </p>
      </section>
    )
  }

  {
    variations.length > 0 && (
      <section id="said" class="mt-14 scroll-mt-6">
        <h2 class="section-heading">How it was said</h2>
        <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-muted">
          Every wording of this claim found in the source, quoted exactly. The names are pseudonyms,
          one to a person within the source.
        </p>
        <ul class="mt-5 space-y-4">
          {variations.map((variation) => (
            <li>
              <blockquote
                class="max-w-prose border-l-2 border-gold pl-4 text-[1.0625rem] leading-relaxed text-pretty"
                data-record
              >
                {variation.wording}
              </blockquote>
              <p class={`mt-1.5 pl-4 ${label}`} data-record>
                <span class="normal-case tracking-normal">{variation.author_name}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <footer class="mt-14 border-t border-rule pt-5">
    <p class="flex flex-wrap gap-x-5 gap-y-1 text-sm" data-crossref>
      <a href={`/questions/${question.id}`} class="link">The question it is under</a>
      <a href="/questions" class="link">Every question we've considered</a>
    </p>
  </footer>
</article>
