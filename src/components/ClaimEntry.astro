---
import { render, type CollectionEntry } from 'astro:content';
import Outcome from './Outcome.astro';
import {
  claimText,
  discussedBy,
  outcomeHeading,
  provenance,
  reportAnchor,
  sideLabel,
  sourceKind,
  storyLinkLabel,
  type Candidate,
  type Investigation,
  type Source,
} from '../lib/intake';
import { repoFile } from '../lib/site';

type Report = CollectionEntry<'candidateReports'>;

/**
 * One claim, with the records behind the decision on it.
 *
 * A claim from a whole source was not decided on its own: triage ruled on the
 * question it belongs to, one panel run will answer that question, and this
 * claim will get one finding out of it. So the page prints the investigation's
 * outcome, says whose outcome it is, and sends the reader up to the question.
 * Printing the badge here as though the claim had been ruled on by itself would
 * misdescribe what happened, and would put four decisions on the page where
 * there was one.
 *
 * A claim registered on its own, before sources, was decided on its own, and
 * that one still prints its own outcome as the heading.
 */
interface Props {
  candidate: Candidate;
  /** The question it is checked under, or null for an entry registered alone. */
  investigation: Investigation | null;
  source: Source | null;
  variation: { id: string; href: string; label: string } | null;
  reports: Array<{ label: string; path: string; entry: Report }>;
}

const { candidate, investigation, source, variation, reports } = Astro.props;

const rendered = await Promise.all(
  reports.map(async (report) => ({
    label: report.label,
    /** The section id is the record's kind, so the outline reads as the page does. */
    id: reportAnchor(report.label),
    reader: report.entry.data.reader,
    run: report.entry.data.run,
    Content: (await render(report.entry)).Content,
  })),
);

/**
 * The captured wordings, already emptied by the register loader for an entry
 * that names an individual and did not get a GO, so the page never receives
 * them and cannot print them.
 */
const forms = candidate.forms ?? [];

/**
 * A merged proposition is a sentence we wrote to say what would have to be
 * true, so it is set as a statement; a hand-registered candidate has only the
 * words it arrived in, so it is quoted.
 */
const quoted = candidate.proposition === undefined;

/** Its own for an entry registered alone, its investigation's otherwise. */
const reason = candidate.reason ?? investigation?.reason ?? candidate.note;

const label = 'text-xs tracking-[0.08em] text-muted uppercase tabular';

/**
 * The claim was turned down while the question around it goes ahead.
 *
 * The one case is an accusation against a named person: the investigation into
 * what an office-holder has disclosed can be entirely worth running, and the
 * accusation inside it is still one this site has no way to put to them. Two
 * decisions differ here, so the page prints both rather than the question's
 * alone, which would read as though the accusation were being checked.
 */
const declinedApart =
  investigation !== null &&
  candidate.outcome === 'NO' &&
  investigation.outcome !== 'NO';
---

<article>
  <header class="border-b border-rule pb-7">
    <div class="text-xs text-muted" data-crossref>
      <a href="/considered" class="link">Every claim we've considered</a>
    </div>

    {/*
      The claim in its own words is the title, quoted, because this page is
      about a sentence somebody said rather than about a subject we named. A
      withheld entry has no words to print, so the redaction gives it a
      literal heading instead: the page says what it is rather than dressing
      its own reason up as something a commenter said.
    */}
    <h1
      class="mt-3 text-[1.5rem] leading-[1.2] font-extrabold tracking-[-0.02em] text-pretty sm:text-[1.875rem]"
    >
      {quoted ? `“${candidate.wording}”` : claimText(candidate)}
    </h1>

    {/*
      Straight out of the register, in the words `/considered` uses. A
      withheld entry reaches this page with no side and no count of the
      people who discussed it: both describe a claim the page is refusing
      to show, so neither is printed here either. Its register id
      stands in their place, because the id is what a later audit asks for.
    */}
    <p class={`mt-4 ${label}`} data-record>
      <time datetime={candidate.recorded}>{candidate.recorded}</time>
      {' · '}
      <span class="normal-case tracking-normal">{provenance(candidate)}</span>
      {
        candidate.withheld && (
          <span class="normal-case tracking-normal">{` · entry ${candidate.id}`}</span>
        )
      }
      {
        candidate.side && (
          <span class="normal-case tracking-normal">{` · ${sideLabel(candidate.side)}`}</span>
        )
      }
      {
        candidate.accounts !== undefined && (
          <span class="normal-case tracking-normal">{` · ${discussedBy(candidate.accounts)}`}</span>
        )
      }
    </p>
  </header>

  <section id={investigation ? 'investigation' : 'outcome'} class="mt-10 scroll-mt-6">
    {
      investigation ? (
        <>
          <h2 class="section-heading">The question it is checked under</h2>

          {/* The question, set as the question it is, so it is not a clause
              inside a sentence about it. */}
          <p
            class="mt-3.5 max-w-prose font-display text-[1.1875rem] leading-snug font-semibold text-pretty"
            data-crossref
          >
            <a href={`/considered/${investigation.id}`} class="link">
              {investigation.question}
            </a>
          </p>

          <p class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed">
            {declinedApart
              ? 'That question is going ahead without this claim. One brief covers the other claims under it; this one was turned down on its own, for the reason below.'
              : 'This claim is checked as part of that question. One brief covers every claim under it, and each claim still gets its own finding.'}
          </p>

          {/* Two badges only where the two decisions differ. Otherwise the
              badge belongs to the question and the line beside it says so, so
              nobody reads it as a decision made about this claim alone. */}
          <p class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-2">
            <span class={label}>{declinedApart ? 'This claim' : "The investigation's outcome"}</span>
            <Outcome outcome={declinedApart ? candidate.outcome : investigation.outcome} />
            {declinedApart && (
              <>
                <span class={label}>The question around it</span>
                <Outcome outcome={investigation.outcome} />
              </>
            )}
          </p>

          {declinedApart && candidate.reason && (
            <p
              class="mt-3.5 max-w-prose border-l-2 border-gold pl-3.5 text-[1.0625rem] leading-relaxed text-pretty"
              data-record
            >
              {candidate.reason}
            </p>
          )}

          {!declinedApart && investigation.reason && (
            <p
              class="mt-3.5 max-w-prose border-l-2 border-gold pl-3.5 text-[1.0625rem] leading-relaxed text-pretty"
              data-record
            >
              {investigation.reason}
            </p>
          )}
        </>
      ) : (
        <>
          {/* The outcome is a heading, as it is on `/considered`, not a badge. */}
          <h2 class="text-xl font-extrabold tracking-[-0.015em] text-forest">
            {outcomeHeading(candidate.outcome)}
          </h2>
          {
            /*
              A variation does not print its reason here: it says the entry
              merged into another one, which the linked sentence below says
              better, with somewhere to go. Every other entry prints it, a
              withheld one included: the reason is the whole of what that page
              has to give.
            */
            !variation && reason && (
              <p class="mt-3.5 max-w-prose border-l-2 border-gold pl-3.5 text-[1.0625rem] leading-relaxed text-pretty">
                {reason}
              </p>
            )
          }
        </>
      )
    }

    {
      /*
        What is missing from this page, said plainly, because a page that
        declines to print something and does not say why reads as evasion.
        Three things it must not get wrong: the site has chosen not to build a
        right of reply, rather than being unable to; the wording is held in a
        private record, not in this register, which is the public one; and the
        decision is auditable later from that record.
      */
      candidate.withheld && (
        <p class="mt-4 max-w-prose text-[0.9375rem] leading-relaxed text-muted">
          A commenter in this source made an allegation about a named person. The site turns those
          down: to publish one fairly it would have to put the allegation to the person named and
          print their answer, and that process has not been built here. The wording and the comments
          it was said in are kept in a private record, so the decision can be audited later against
          what was actually said. In public the entry is its identifier, its outcome and the reason
          for it.
        </p>
      )
    }

    {
      variation && (
        <p class="mt-4 max-w-prose text-[1.0625rem] leading-relaxed" data-crossref>
          The same claim as <a href={variation.href} class="link">{variation.id}</a>, in different
          words. It is checked there, so it is not checked twice.
        </p>
      )
    }

    {
      candidate.story && (
        <p class="mt-4 text-sm" data-crossref>
          <a href={`/facts/${candidate.story}`} class="link">
            {storyLinkLabel(candidate)}
          </a>
        </p>
      )
    }

    {
      /*
        The seats raised claims; the merge wrote the proposition above out of
        them. "Found by" read as though the models had produced the sentence
        they are listed under, which is the one thing they do not do.
      */
      candidate.seats && candidate.seats.length > 0 && (
        <p class={`mt-4 ${label}`} data-record>
          {`Raised in extraction by ${candidate.seats.join(', ')}`}
        </p>
      )
    }

    {/*
      The outcome is a decision about whether to check the claim, never a
      verdict on it, and a reader who arrives here from a search has not read
      the register's key. Rather than restate the key on every entry, the page
      points at it, once.
    */}
    <p class="mt-5 text-sm" data-crossref>
      <a href="/considered#outcomes" class="link">What the outcomes mean</a>
    </p>
  </section>

  {
    source && (
      <section id="source" class="mt-14 scroll-mt-6">
        <h2 class="section-heading">Where it came from</h2>
        <p class="mt-3 max-w-prose text-[1.0625rem] leading-relaxed text-pretty">
          Taken from{' '}
          <a href={`/considered#${source.id}`} class="link">
            {source.title}
          </a>
          , read end to end. Every factual claim in it was extracted and merged, so this one is
          listed whatever became of it.
        </p>
        <p class={`mt-3 ${label}`} data-record>
          {sourceKind(source)}
          {' · captured '}
          <time datetime={source.captured}>{source.captured}</time>
          {source.comments !== undefined && ` · ${source.comments} comments`}
        </p>
        <p class="mt-3 text-sm" data-crossref>
          <a href={source.url} class="link" rel="noopener nofollow">
            The original post
          </a>
        </p>
      </section>
    )
  }

  {
    forms.length > 0 && (
      <section id="forms" class="mt-14 scroll-mt-6">
        <h2 class="section-heading">How it was said</h2>
        <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-muted">
          Every wording of this claim found in the source, quoted exactly. The names are pseudonyms,
          one to a person within the source; the number is the comment's place in the captured
          thread.
        </p>
        <ul class="mt-5 space-y-4">
          {forms.map((form) => (
            <li>
              <blockquote
                class="max-w-prose border-l-2 border-gold pl-4 text-[1.0625rem] leading-relaxed text-pretty"
                data-record
              >
                {form.quote}
              </blockquote>
              <p class={`mt-1.5 pl-4 ${label}`} data-record>
                <span class="normal-case tracking-normal">{form.commenter}</span>
                {` · comment ${form.comment}`}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    rendered.map(({ id, label: heading, reader, run, Content }) => (
      <section id={id} class="mt-14 scroll-mt-6">
        <h2 class="section-heading">{heading}</h2>
        {/*
          The triage is somebody else's reading, and it has to be unmistakable
          which. A byline naming the model read as if the model had reviewed
          the site's work, and left the report's judgements available to be
          taken for the site's own. The notice says both things instead: whose
          reading this is, and that the decision above is ours. The intake
          record needs none of it — that one is Stew's.
        */}
        {id === 'triage' && (
          <aside
            class="mt-4 border-t-2 border-b border-t-gold border-b-rule bg-wash px-4 py-3.5"
            role="note"
          >
            <p class="text-sm leading-relaxed text-forest">
              What follows is the triage read, written by a model from another vendor and published
              as written. The site's decision is the outcome above.
            </p>
            {(reader || run) && (
              <p class="mt-1 text-xs text-muted" data-record>
                {reader}
                {reader && run && ' · '}
                {run && (
                  <>
                    run <time datetime={run}>{run}</time>
                  </>
                )}
              </p>
            )}
          </aside>
        )}
        {/*
          `data-record` for the same reason the register's meta line carries
          it: this is a stored record rendered verbatim, not the site writing
          prose. One triage report covers three candidates, so its words
          legitimately appear on three pages.
        */}
        <div class="prose mt-4" data-record>
          <Content />
        </div>
      </section>
    ))
  }

  <footer class="mt-14 border-t border-rule pt-5">
    {/*
      Each source names the record it is: the site footer already carries a
      "Source on GitHub" pointing at the repository, and a page with both an
      intake record and a triage report would otherwise offer two links with
      the same words and different destinations.
    */}
    <p class="flex flex-wrap gap-x-5 gap-y-1 text-sm" data-crossref>
      <a href="/considered" class="link">Every claim we've considered</a>
      {
        reports.map((report) => (
          <a href={repoFile(report.path)} rel="noopener" class="link">
            {report.label} on GitHub
          </a>
        ))
      }
    </p>
  </footer>
</article>
