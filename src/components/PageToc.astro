---
import type { TocSection } from '../lib/toc';

/**
 * The link list behind "On this page". Rendered twice per page — once in the
 * desktop rail, once inside the phone disclosure — with only one of the two
 * displayed at any width, so the hidden copy is out of the accessibility tree
 * rather than read twice.
 *
 * The active-section highlight is applied by `data-toc-link` scripting in the
 * layout; the styles for it live in `global.css` so the script toggles one
 * class rather than a list of utilities.
 */
interface Props {
  sections: TocSection[];
}

const { sections } = Astro.props;
---

<ul class="space-y-0.5 border-l border-rule">
  {
    sections.map((section) => (
      <li>
        <a
          href={`#${section.id}`}
          data-toc-link
          class="-ml-px block border-l border-transparent py-0.5 pl-3 text-[0.8125rem] leading-snug text-muted transition-colors hover:border-rule-strong hover:text-forest"
        >
          {section.label}
        </a>
      </li>
    ))
  }
</ul>
