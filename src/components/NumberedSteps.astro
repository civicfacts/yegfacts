---
/**
 * A numbered list of named steps: a numeral column, a bold name, a body. The
 * methodology page renders its short version, its intake steps and its seven
 * stages through this one shape, so a reader who goes on meets a list they have
 * already seen and a spacing change lands in one place. The numeral is the
 * position, so a step cannot carry the wrong number.
 *
 * `flow` draws the list as a process rather than an enumeration: a hairline
 * spine down the numeral column joining the first numeral to the last, passing
 * behind each numeral (the numeral carries the paper ground and sits at the
 * top of its cell, so the ground covers the digit's line box and not the row) and with no row
 * dividers, since the spine is what joins the steps (from
 * `sm`; below that the numeral sits above the text and no spine is drawn), and
 * under any step that has them, what can happen to a claim there besides going
 * on: stopping, looping back, continuing changed, being fixed or corrected.
 * Only the short version passes it. The exits ride in the same array as the
 * bodies so each stays attached to its step; whether each is true of the
 * method is checked by the critique, not by the shape.
 */
/**
 * What can happen to a claim at a step besides going on to the next one. The
 * kind is the plain-words label a reader sees first; it is one of a fixed set
 * so the labels stay consistent down the flow.
 */
export interface Exit {
  kind: 'Stops here' | 'Loops back' | 'Continues' | 'Fixed before publication' | 'Corrected later';
  text: string;
}

interface Props {
  steps: ReadonlyArray<{ name: string; body: string; exits?: readonly Exit[] }>;
  flow?: boolean;
}

const { steps, flow = false } = Astro.props;
---

<ol class={flow ? "mt-6 border-t border-rule" : "mt-6 divide-y divide-rule border-t border-rule"}>
  {
    steps.map((step, index) => (
      <li
        class:list={['grid gap-x-5 gap-y-1 py-5 sm:grid-cols-[2rem_1fr]', flow && 'step-flow']}
      >
        <span class:list={['text-lg font-bold text-forest tabular', flow && 'sm:relative sm:self-start sm:bg-paper sm:text-center']}>
          {index + 1}
        </span>
        <div>
          <h3 class="font-semibold tracking-[-0.012em] text-forest">{step.name}</h3>
          <p class="mt-1.5 text-[0.9375rem] leading-relaxed">{step.body}</p>
          {flow && step.exits && step.exits.length > 0 && (
            <ul class="mt-3 max-w-prose space-y-1.5">
              {step.exits.map((exit) => (
                <li class="border-l-2 border-rule pl-3 text-[0.875rem] leading-relaxed text-muted">
                  <span class="font-semibold text-ink">{exit.kind}.</span> {exit.text}
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
