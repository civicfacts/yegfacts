---
/**
 * A numbered list of named steps: a numeral column, a bold name, a body. The
 * methodology page renders its short version, its intake steps and its seven
 * stages through this one shape, so a reader who goes on meets a list they have
 * already seen and a spacing change lands in one place. The numeral is the
 * position, so a step cannot carry the wrong number.
 *
 * `flow` draws the list as a process rather than an enumeration: a hairline
 * spine down the numeral column joining the first numeral to the last, and
 * under any step that has them, the ways a claim can leave the process at that
 * step. Only the short version passes it; the exits ride in the same array as
 * the bodies, so the picture cannot drift from the text.
 */
interface Props {
  steps: ReadonlyArray<{ name: string; body: string; exits?: readonly string[] }>;
  flow?: boolean;
}

const { steps, flow = false } = Astro.props;
---

<ol class="mt-6 divide-y divide-rule border-t border-rule">
  {
    steps.map((step, index) => (
      <li
        class:list={[
          'grid gap-x-5 gap-y-1 py-5 sm:grid-cols-[2rem_1fr]',
          flow && 'step-flow',
          flow && index === 0 && 'step-flow-first',
          flow && index === steps.length - 1 && 'step-flow-last',
        ]}
      >
        <span class="text-lg font-bold text-forest tabular">{index + 1}</span>
        <div>
          <h3 class="font-semibold tracking-[-0.012em] text-forest">{step.name}</h3>
          <p class="mt-1.5 text-[0.9375rem] leading-relaxed">{step.body}</p>
          {flow && step.exits && step.exits.length > 0 && (
            <Fragment>
              <p class="mt-3 text-[0.6875rem] font-semibold tracking-[0.11em] text-muted uppercase">
                Leaves here
              </p>
              <ul class="mt-1.5 max-w-prose space-y-1.5">
                {step.exits.map((exit) => (
                  <li class="border-l-2 border-rule pl-3 text-[0.875rem] leading-relaxed text-muted">
                    {exit}
                  </li>
                ))}
              </ul>
            </Fragment>
          )}
        </div>
      </li>
    ))
  }
</ol>
