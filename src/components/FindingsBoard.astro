---
import type { Claim, Story } from '../lib/content';
import { FINDING_TONE } from '../lib/findings';
import { CANONICAL_FINDINGS } from '../lib/vocabulary';
import Finding from './Finding.astro';

/**
 * The whole published record, grouped by story: one row per claim, the finding
 * word in its own column so the answers read down the page as a column of
 * words rather than as a list of headlines.
 *
 * The summary line is computed from the same rows it summarises, so the two
 * cannot disagree.
 */
interface Props {
  stories: Story[];
  claimsByStory: Record<string, Claim[]>;
}

const { stories, claimsByStory } = Astro.props;

const allClaims = stories.flatMap((s) => claimsByStory[s.id] ?? []);
const claimCount = allClaims.length;
const storyCount = stories.length;
const findingCounts = CANONICAL_FINDINGS.map((finding) => ({
  finding,
  count: allClaims.filter((c) => c.data.finding === finding).length,
})).filter((e) => e.count > 0);
---

<h2 class="text-xl font-extrabold tracking-[-0.015em] text-forest">Every checked claim</h2>
<p class="mt-2 text-[0.9375rem] text-pretty text-muted tabular">
  {claimCount}
  {claimCount === 1 ? ' claim in ' : ' claims in '}
  {storyCount}
  {storyCount === 1 ? ' story: ' : ' stories: '}
  {
    findingCounts.map((entry, index) => (
      <Fragment>
        {index > 0 && ' · '}
        <span class:list={['font-semibold', FINDING_TONE[entry.finding].text]}>
          {entry.count} {entry.finding}
        </span>
      </Fragment>
    ))
  }
</p>

<div class="mt-6">
  {
    stories.map((story) => (
      <div class="border-t border-rule pt-4">
        <h3 class="text-sm font-semibold text-muted">
          <a href={`/facts/${story.id}`} class="hover:text-forest">
            {story.data.title}
          </a>
        </h3>
        <ul class="divide-y divide-rule">
          {(claimsByStory[story.id] ?? []).map((claim) => (
            <li class="py-4 sm:grid sm:grid-cols-[11rem_1fr] sm:gap-x-6">
              <Finding finding={claim.data.finding} size="lg" />
              <div class="mt-1.5 sm:mt-0">
                <a
                  href={`/facts/${story.id}#${claim.data.id}`}
                  class="text-[1.0625rem] leading-snug font-medium text-ink hover:text-forest"
                >
                  {claim.data.question}
                </a>
                <p class="mt-1 text-xs text-muted">
                  {claim.data.panel_agreement} panel · Verified{' '}
                  <time datetime={story.data.last_verified}>{story.data.last_verified}</time>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
