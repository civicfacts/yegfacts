---
import Gloss from './Gloss.astro';
import { requireTerm } from '../lib/glossary';

/**
 * Glossary term inside prose. Usage in MDX:
 *   <Term t="proof of claim">proof of claim</Term>
 * or, when the visible text matches the glossary key exactly:
 *   <Term t="Proterra" />
 *
 * The definition renders in a popover rather than a `title` tooltip, so it is
 * reachable by tap and by keyboard and can carry a link to the methodology.
 */
interface Props {
  t: string;
}

const { t } = Astro.props;
const entry = requireTerm(t);
const hasSlot = Astro.slots.has('default');
---

<Gloss definition={entry.definition} href={entry.href}>{hasSlot ? <slot /> : t}</Gloss>
