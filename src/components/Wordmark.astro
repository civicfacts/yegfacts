---
import symbolImage from '../assets/symbol.png';
/**
 * Symbol + styled-text wordmark, set on the forest masthead: "YEGFacts" in
 * paper, ".ca" in gold (4.88:1 on forest, so it passes AA rather than being
 * decoration a reader has to guess at).
 *
 * `masthead` is the home page's front-page size; `compact` is what every inner
 * page carries, where the mark identifies the site rather than announcing it.
 *
 * The type size is set on the outer span so the dome and the gap scale in em
 * with the letters. The row aligns on the baseline: an image's baseline is its
 * bottom edge, so the letters stand on the base of the dome rather than
 * floating against its middle.
 */
interface Props {
  size?: 'compact' | 'masthead';
}

const { size = 'compact' } = Astro.props;

/*
 * The front-page cap is 3.25rem rather than the 3.625rem it once was: at the
 * larger size the mark and the six nav words together ran four pixels past the
 * 66rem container, and the nav dropped to a line of its own on every desktop
 * width. The mark is still twice the compact size.
 */
const text =
  size === 'masthead'
    ? 'text-[clamp(2rem,7.75vw,3.25rem)] gap-[0.2em]'
    : 'text-[1.625rem] gap-[0.3em]';
const symbol = size === 'masthead' ? 'h-[1.27em]' : 'h-[1.5em]';
---

<span class:list={['inline-flex items-baseline', text]}>
  <img src={symbolImage.src} alt="" width="480" height="400" class={`${symbol} w-auto shrink-0 translate-y-px`} />
  <span
    class="font-display leading-none font-bold tracking-[-0.015em] text-paper"
  >
    YEGFacts<span class="text-gold">.ca</span>
  </span>
</span>
