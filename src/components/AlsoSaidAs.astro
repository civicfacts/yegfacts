---
import { sourceRegister, variationsFrom } from '../lib/intake';

/**
 * "Also said as" — the captured wordings of a claim, on the page that checked it.
 *
 * When a source is read end to end, a register claim inside it turns out to be
 * a claim this site has already published. The published claim names that
 * register claim in `register_claims`; this brings its captured wordings back
 * to the claim itself, so a person who commented on the original post can find
 * the words they typed on the page that answers them. The quotes are exact and
 * the names are the source's pseudonyms — never a real name, on any page, ever.
 *
 * Collapsed, like the extra key facts above it: a claim can carry twenty
 * wordings, and the verdict is what the reader came for. Every one still
 * renders into the HTML, so Pagefind indexes them and somebody searching their
 * own words lands here.
 */
interface Props {
  /** The register claim ids this published claim was grouped from. */
  registerClaims: readonly string[];
}

const { registerClaims } = Astro.props;

const sources = new Map(sourceRegister().map((source) => [source.id, source]));

/**
 * `variationsFrom` reads the register through the loader that redacts
 * named-individual claims, so a withheld claim arrives here with no variations
 * and contributes nothing.
 */
const said = variationsFrom(registerClaims).map(({ claim, variation }) => ({
  variation,
  claim,
  source: sources.get(variation.source_id),
}));

const label = 'text-xs tracking-[0.08em] text-muted uppercase tabular';
---

{
  said.length > 0 && (
    <details class="mt-4">
      <summary class="link inline-flex min-h-10 cursor-pointer list-none items-center text-sm">
        Also said as — {said.length} captured {said.length === 1 ? 'wording' : 'wordings'}
      </summary>
      <p class="max-w-prose pb-2 text-sm leading-relaxed text-muted">
        Quoted exactly from sources we hold. Each name is a pseudonym, one to a person within its
        source.
      </p>
      <ul class="space-y-3.5 pb-1">
        {said.map(({ variation, claim, source }) => (
          <li>
            <blockquote
              class="max-w-prose border-l-2 border-rule pl-3.5 text-[0.9375rem] leading-relaxed"
              data-record
            >
              {variation.wording}
            </blockquote>
            <p class={`mt-1 pl-3.5 ${label}`} data-record>
              <span class="normal-case tracking-normal">{variation.author_name}</span>
              {' · '}
              <a href={`/claims/${claim.id}`} class="link normal-case tracking-normal">
                in the register
              </a>
              {source && (
                <>
                  {' · '}
                  <a href={source.url} class="link normal-case tracking-normal" rel="noopener nofollow">
                    the post
                  </a>
                </>
              )}
            </p>
          </li>
        ))}
      </ul>
    </details>
  )
}
