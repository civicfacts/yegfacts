---
import type { Claim, Story } from '../lib/content';
import Finding from './Finding.astro';
import TopicTags from './TopicTags.astro';
import { findingEdge } from '../lib/findings';

/**
 * A run of stories, each headed by its title and followed by a two-column
 * table of the claims checked on it: Claim on the left, Finding on the right.
 *
 * The table is the FindingsBoard idiom used on / and /search, at the tighter
 * type size a dense index wants: a 5px verdict-coloured left edge on the row,
 * the question in the display face, the filled badge in its own column so the
 * verdicts read down one line. The column holds at every width; on a phone it
 * shrinks to the widest badge.
 *
 * Topics and the verification date sit as a dateline directly under the
 * title, where a reader looking for provenance expects them.
 *
 * The list draws no rule above itself. The caller does, when nothing above it
 * already draws one: /stories sits under the page header's rule, a topic hub
 * under a bare label.
 */
interface Props {
  stories: Story[];
  claimsByStory: Record<string, Claim[]>;
  /** Off on a topic hub, where every story on the page carries the same topic. */
  showTopics?: boolean;
  /** 'h2' where the list is the page's own outline; 'h3' under a section heading. */
  headingLevel?: 'h2' | 'h3';
}

const { stories, claimsByStory, showTopics = true, headingLevel = 'h3' } = Astro.props;

const Heading = headingLevel;

/** The header cells share one label style; a transparent edge keeps Claim over the questions' text. */
const th = 'border-b border-rule pb-2 text-left font-sans text-xs font-semibold tracking-[0.09em] text-muted uppercase';
/** Shrinks to the widest badge on a phone, a fixed 11rem column from sm up, like the search board. */
const findingColumn = 'w-px whitespace-nowrap sm:w-44';
---

<ul class="divide-y divide-rule">
  {
    stories.map((story) => {
      const claims = claimsByStory[story.id] ?? [];
      return (
        <li class="py-8">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <Heading class="font-display text-[1.375rem] leading-[1.25] font-semibold">
              <a href={`/facts/${story.id}`} class="link">
                {story.data.title}
              </a>
            </Heading>
            {story.data.status === 'pending-review' && (
              <span class="text-[0.6875rem] tracking-[0.08em] text-forest uppercase">
                Pending review
              </span>
            )}
          </div>

          <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1">
            {showTopics && <TopicTags topics={story.data.topics} />}
            <span class="text-xs text-muted">
              Verified <time datetime={story.data.last_verified}>{story.data.last_verified}</time>
            </span>
          </div>

          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{story.data.one_line}</p>

          {claims.length > 0 && (
            <table class="mt-5 w-full border-collapse">
              <caption class="sr-only">Claims checked on {story.data.title}</caption>
              <thead>
                <tr>
                  <th scope="col" class:list={[th, 'border-l-[5px] border-l-transparent pl-4']}>
                    Claim
                  </th>
                  <th scope="col" class:list={[th, findingColumn]}>
                    Finding
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-rule">
                {claims.map((claim) => (
                  <tr>
                    <td class:list={['border-l-[5px] py-3 pr-4 pl-4 align-top', findingEdge(claim.data.finding)]}>
                      <a
                        href={`/facts/${story.id}#${claim.data.id}`}
                        class="link font-display text-[1.0625rem] leading-snug font-semibold"
                      >
                        {claim.data.question}
                      </a>
                    </td>
                    <td class:list={[findingColumn, 'py-3 align-top']}>
                      <Finding finding={claim.data.finding} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </li>
      );
    })
  }
</ul>
