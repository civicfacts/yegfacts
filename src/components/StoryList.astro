---
import type { Claim, Story } from '../lib/content';
import Finding from './Finding.astro';
import TopicTags from './TopicTags.astro';
import { findingEdge } from '../lib/findings';

/**
 * A run of stories, each headed by its title and followed by a two-column
 * table of the claims checked on it: Claim on the left, Finding on the right.
 *
 * The table is the FindingsBoard idiom used on / and /search, at the tighter
 * type size a dense index wants: a 5px verdict-coloured bar on the question,
 * inside the row's padding so each row's bar stands alone,
 * the question in the display face, the filled badge in its own column so the
 * verdicts read down one column. It holds at every width; on a phone it
 * shrinks to the widest badge.
 *
 * The title is the block's one link. The page is for choosing a story, so the
 * claims are plain text with their badges and the topics are a kicker above
 * the title, as on the story page; the story's own verdict strip carries the
 * claim anchors one click away. Search is the route to a single claim.
 *
 * Each story opens with the broadsheet section head the home page uses, a 3px
 * ink rule over the title, because the claim rows underneath carry colour and
 * badges and a hairline between stories lost against them.
 */
interface Props {
  stories: Story[];
  claimsByStory: Record<string, Claim[]>;
  /** Off on a topic hub, where every story on the page carries the same topic. */
  showTopics?: boolean;
  /** 'h2' where the list is the page's own outline; 'h3' under a section heading. */
  headingLevel?: 'h2' | 'h3';
}

const { stories, claimsByStory, showTopics = true, headingLevel = 'h3' } = Astro.props;

const Heading = headingLevel;

/** Shrinks to the widest badge on a phone, a fixed 11rem column from sm up, like the search board. */
const findingColumn = 'w-px text-right whitespace-nowrap sm:w-44';
---

<ul class="space-y-2">
  {
    stories.map((story) => {
      const claims = claimsByStory[story.id] ?? [];
      return (
        <li class="border-t-[3px] border-ink pt-3.5 pb-10">
          {/* Kicker: topics and the verified date in the metadata label, as on the story page itself. */}
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-sans text-xs font-semibold tracking-[0.09em] text-muted uppercase">
            {showTopics && <TopicTags topics={story.data.topics} linked={false} />}
            <span>
              Verified <time datetime={story.data.last_verified}>{story.data.last_verified}</time>
            </span>
          </div>

          <div class="mt-1.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <Heading class="font-display text-[1.625rem] leading-[1.2] font-semibold">
              <a href={`/facts/${story.id}`} class="link">
                {story.data.title}
              </a>
            </Heading>
            {story.data.status === 'pending-review' && (
              <span class="text-[0.6875rem] tracking-[0.08em] text-forest uppercase">
                Pending review
              </span>
            )}
          </div>

          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{story.data.one_line}</p>

          {claims.length > 0 && (
            <table class="mt-4 w-full border-collapse border-t border-rule">
              <caption class="sr-only">Claims checked on {story.data.title}</caption>
              {/* The badge says what its column is, so the header is for screen readers only. */}
              <thead class="sr-only">
                <tr>
                  <th scope="col">Claim</th>
                  <th scope="col">Finding</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-rule">
                {claims.map((claim) => (
                  <tr>
                    <td class="py-3 pr-4 align-top">
                      <span
                        class:list={[
                          'block border-l-[5px] pl-4 font-display text-[1.0625rem] leading-snug font-semibold text-ink',
                          findingEdge(claim.data.finding),
                        ]}
                      >
                        {claim.data.question}
                      </span>
                    </td>
                    <td class:list={[findingColumn, 'py-3 align-top']}>
                      <Finding finding={claim.data.finding} />
                      {/* As on the boards: Unanimous is silent, a contested panel prints under the badge it qualifies. */}
                      {claim.data.panel_agreement !== 'Unanimous' && (
                        <span class="mt-1.5 block font-sans text-xs font-semibold tracking-[0.09em] text-muted uppercase">
                          {claim.data.panel_agreement} panel
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </li>
      );
    })
  }
</ul>
