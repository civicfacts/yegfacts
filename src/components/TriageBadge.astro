---
import { triageBadge, triageFill } from '../lib/intake';

/**
 * What triage answered about a question, as a filled tile in its own colour.
 *
 * On the hand-registered list a triage answer is a section heading, because a
 * declined question is a decision the site defends rather than a state to
 * colour-code. Inside a source it has to be a badge instead: the point of
 * publishing a whole source is that every disposition in it can be read down
 * one column, and thirty of them cannot each be a heading. The word is printed
 * in full, as a finding is.
 */
interface Props {
  triage: string;
}

const { triage } = Astro.props;
---

<span
  class:list={[
    'inline-block px-[10px] py-[6px] font-sans text-[0.6875rem] leading-[1.2] font-bold tracking-[0.08em] whitespace-nowrap uppercase',
    triageFill(triage),
  ]}>{triageBadge(triage)}</span
>
