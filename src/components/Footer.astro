---
import Wordmark from './Wordmark.astro';
import { SITE, issueUrl } from '../lib/site';

/**
 * The forest block that closes the page, bookending the masthead: same ground,
 * same container, the same compact mark, and the same nav treatment (see
 * `.forest-nav` in global.css, which both blocks share). It arrives as a band
 * of colour rather than as a wash panel behind an ink rule, so the page is
 * framed top and bottom rather than trailing off into grey.
 *
 * Nothing muted survives here: grey text on forest fails, navy links disappear
 * into the green, and so does the navy focus ring — `.site-footer` is what
 * turns that ring white, alongside `.masthead`.
 */

/**
 * The commit this build came from, injected by `astro.config.mjs`. A reader can
 * click it and land on the exact tree that produced the page they are reading —
 * which is the only way "the audit trail is version-controlled" is checkable
 * from the deployed site rather than taken on trust.
 */
const commitSha = import.meta.env.COMMIT_SHA ?? 'dev';

/**
 * The column labels. Gold on forest is 4.88:1, which passes AA at this size and
 * weight; it is the only place gold sets type outside the wordmark's ".ca", and
 * it is on forest, never on paper, where it would fail.
 */
const heading = 'font-sans text-[0.6875rem] font-bold tracking-[0.12em] text-gold uppercase';

/**
 * The colophon is running text, so its links are underlined — the site's rule
 * for a link inside a sentence. They are paper, not `.link` navy or
 * `.link-stew` blue: neither of those passes on this ground.
 */
const colophonLink = 'link-paper';

interface FooterLink {
  href: string;
  label: string;
  /** Off-site, so it carries `rel="noopener"`. */
  external?: boolean;
}

const columns: { heading: string; links: FooterLink[] }[] = [
  {
    heading: 'The site',
    links: [
      { href: '/', label: 'Home' },
      { href: '/questions', label: 'Questions' },
      { href: '/search', label: 'Search' },
      { href: '/commitments', label: 'Commitments' },
      { href: '/topics', label: 'Topics' },
      { href: '/evidence', label: 'Evidence' },
    ],
  },
  {
    heading: 'How this works',
    links: [
      { href: '/methodology', label: 'Methodology' },
      { href: '/methodology/changes', label: 'Methodology changes' },
      { href: '/journal', label: 'Journal' },
      { href: '/about', label: 'About & independence' },
      { href: '/support', label: 'Support' },
      { href: '/rss.xml', label: 'RSS' },
    ],
  },
  {
    heading: 'Contact',
    links: [
      { href: `mailto:${SITE.email}`, label: SITE.email },
      { href: SITE.repo, label: 'Source on GitHub', external: true },
      /*
        Lives here rather than at the foot of every finding: it is an
        invitation to the site, not a response to the page you are on.
      */
      {
        href: issueUrl('Suggest a topic', 'What should YEGFacts check, and why?\n'),
        label: 'Suggest a topic',
        external: true,
      },
    ],
  },
];
---

<footer class="site-footer mt-16 bg-forest text-paper" data-pagefind-ignore>
  <div class:list={['mx-auto max-w-3xl px-5 pt-10 pb-12', 'lg:max-w-[66rem]']}>
    {/*
      The head row is the masthead's row again: mark on the left, one line of
      type beside it, aligned on the last baseline so the sentence sits on the
      base of the letters rather than against their middle. Below `md` the
      sentence takes a line of its own.
    */}
    <div class="flex flex-wrap items-baseline-last gap-x-7 gap-y-3">
      <a href="/" class="mr-auto no-underline" aria-label="YEGFacts.ca home">
        <Wordmark size="compact" />
      </a>
      <p class="max-w-[34ch] basis-full font-display text-[1.0625rem] text-paper/80 md:basis-auto">
        Claims about Edmonton's city government, checked against the public record.
      </p>
    </div>

    <div class="mt-8 grid gap-8 border-t border-paper/15 pt-8 sm:grid-cols-3">
      {
        columns.map((column) => (
          /*
            `forest-nav` is the masthead's link treatment: paper at 82%, no
            underline, full strength on hover. Its gold current-page bar keys off
            `aria-current`, which nothing here sets — the footer is a site map,
            not a statement about where you are.
          */
          <nav class="forest-nav" aria-label={column.heading}>
            <h2 class={heading}>{column.heading}</h2>
            <ul class="mt-3 space-y-1.5 text-[0.9375rem]">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} rel={link.external ? 'noopener' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="mt-10 border-t border-paper/15 pt-5 text-[0.8125rem] leading-relaxed text-paper/70">
      Built and maintained by <a href="/about" class={colophonLink}>Stew</a>. Non-partisan civic
      evidence for Edmonton: every finding shows its evidence, its model reviews, and its revision
      history.
      {
        commitSha !== 'dev' ? (
          <>
            {' '}
            Deployed from{' '}
            <a
              href={`${SITE.repo}/commit/${commitSha}`}
              rel="noopener"
              class={`${colophonLink} tabular`}
            >
              {commitSha}
            </a>
            .
          </>
        ) : (
          <> Deployed from <span class="tabular">dev</span>.</>
        )
      }
    </p>
  </div>
</footer>
