---
import Wordmark from './Wordmark.astro';

/**
 * `wide` matches the masthead to a page that carries an "On this page" rail, so
 * the wordmark keeps the same left edge as the article below it.
 */
interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/commitments', label: 'Commitments' },
  { href: '/evidence', label: 'Evidence' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/about', label: 'About' },
  { href: '/search', label: 'Search' },
];
---

<header class="border-b border-rule" data-pagefind-ignore>
  <div
    class:list={[
      'mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4',
      wide && 'lg:max-w-[66rem]',
    ]}
  >
    <a href="/" class="no-underline" aria-label="YEGFacts.ca home">
      <Wordmark />
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={path === link.href ? 'page' : undefined}
                class:list={[
                  'text-muted transition-colors hover:text-forest',
                  path === link.href && 'text-forest font-semibold',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
