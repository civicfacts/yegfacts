---
import Wordmark from './Wordmark.astro';

/**
 * `wide` matches the masthead to a page that carries an "On this page" rail, so
 * the wordmark keeps the same left edge as the article below it.
 */
interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

/**
 * `phoneHidden` drops a link below `sm`, where five labels plus the wordmark
 * cannot share a row. Search is the one that goes: it is the first item in the
 * footer's site column and the whole of the home page's search field, so it is
 * never more than one tap away from where it was.
 */
const links: { href: string; label: string; phoneHidden?: boolean }[] = [
  { href: '/commitments', label: 'Commitments' },
  { href: '/evidence', label: 'Evidence' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/about', label: 'About' },
  { href: '/search', label: 'Search', phoneHidden: true },
];
---

<header class="border-b border-rule" data-pagefind-ignore>
  <div
    class:list={[
      'mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-3 gap-y-1 px-5 py-2',
      'sm:gap-x-6 sm:gap-y-3 sm:py-4',
      wide && 'lg:max-w-[66rem]',
    ]}
  >
    <a href="/" class="no-underline" aria-label="YEGFacts.ca home">
      <Wordmark />
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-x-3 text-[0.6875rem] sm:gap-x-5 sm:text-sm">
        {
          links.map((link) => (
            <li class:list={[link.phoneHidden && 'hidden sm:block']}>
              <a
                href={link.href}
                aria-current={path === link.href ? 'page' : undefined}
                class:list={[
                  'text-muted transition-colors hover:text-forest',
                  path === link.href && 'text-forest font-semibold',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
