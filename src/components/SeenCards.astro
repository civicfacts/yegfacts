---
import type { CollectionEntry } from 'astro:content';

/**
 * "Common forms of the claim" — the arguments actually in circulation, written
 * out as composite paraphrases (methodology v1.2).
 *
 * These are NOT captured posts. Nothing here is quoted from a real account, so
 * the component renders no platform chrome, no avatar, no handle and no link to
 * an "original": there is no original. Platform-native styling was dropped
 * because a fact-checking site rendering fabricated-quote-shaped cards is the
 * exact artifact that circulates as a screenshot with its disclaimer stripped
 * off. The "Paraphrase — not a real post" label therefore sits INSIDE each card,
 * where a screenshot has to take it along.
 *
 * `platform` and `context` may stay in a story's frontmatter as authoring
 * provenance; neither is rendered.
 */
interface Props {
  seen: CollectionEntry<'stories'>['data']['seen'];
}

const { seen } = Astro.props;
---

{
  seen.length > 0 && (
    <section id="claims-we-are-seeing" class="mt-14">
      <h2 class="text-xl font-extrabold tracking-[-0.015em] text-forest">
        Common forms of the claim
      </h2>
      <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-muted">
        Composite paraphrases of arguments in circulation about this story, written by us to show
        the shapes the claim takes. They are not captured posts, not quotations of any person, and
        not a measure of how common each version is.
      </p>

      <ul class="mt-5 grid gap-3.5 sm:grid-cols-2">
        {seen.map((card) => (
          <li class="border-l-2 border-gold bg-wash px-4 py-3.5">
            <p class="text-[0.625rem] font-semibold tracking-[0.11em] text-muted uppercase">
              Paraphrase — not a real post
            </p>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink">{card.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}
