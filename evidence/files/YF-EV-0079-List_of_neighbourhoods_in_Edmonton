<section data-mw-section-id="-1" id="mwAuc" aria-labelledby="Mill_Woods_Town_Centre"><div class="mw-heading mw-heading4"><h4 id="Mill_Woods_Town_Centre">Mill Woods Town Centre</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=List_of_neighbourhoods_in_Edmonton&amp;action=edit&amp;section=36" title="Edit section: Mill Woods Town Centre"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
