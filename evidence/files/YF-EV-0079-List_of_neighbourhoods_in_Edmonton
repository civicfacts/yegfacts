</section><section data-mw-section-id="17" id="mwAZ8" aria-labelledby="The_Palisades"><div class="mw-heading mw-heading3"><h3 id="The_Palisades">The Palisades</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=List_of_neighbourhoods_in_Edmonton&amp;action=edit&amp;section=17" title="Edit section: The Palisades"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
